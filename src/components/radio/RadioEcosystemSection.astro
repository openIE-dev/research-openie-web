---
interface Props {
  ecosystem: any;
  episodes: any[];
}

const { ecosystem, episodes } = Astro.props;
const channels = ecosystem.channels || [];
const extended = ecosystem.extended_directory || [];
const epById = Object.fromEntries((episodes || []).map((e: any) => [e.id, e]));
---

<section id="ecosystem" class="max-w-7xl mx-auto px-5 md:px-10 py-8 scroll-mt-24">
  <div class="glass-card p-5 sm:p-7 border border-brand-cyan/30">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-5 mb-6 border-b border-brand-border">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="section-label">4 · OpenIE Ecosystem Desks · *.openie.dev</span>
          <span class="px-2 py-0.5 rounded font-mono text-[10px] bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/30">
            6 Broadcast Desks + 9 Stack Companions
          </span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-brand-white tracking-tight">
          Tune Roundtables by <span class="text-brand-amber">OpenIE Domain</span> &amp; <span class="text-brand-cyan">Avalanche Rung</span>
        </h2>
        <p class="font-body text-xs sm:text-sm text-brand-slate mt-1.5 max-w-3xl leading-relaxed m-0">
          Connect every roundtable discussion directly to <a href="https://avalanche.openie.dev" class="text-brand-amber hover:underline">avalanche.openie.dev</a>, <a href="https://stack.openie.dev" class="text-brand-cyan hover:underline">stack.openie.dev</a>, <a href="https://compute.openie.dev" class="text-brand-light hover:underline">compute.openie.dev</a>, <a href="https://synthesis.openie.dev" class="text-brand-light hover:underline">synthesis.openie.dev</a>, <a href="https://knowledge.openie.dev" class="text-brand-light hover:underline">knowledge.openie.dev</a>, and <a href="https://database.openie.dev" class="text-brand-light hover:underline">database.openie.dev</a>. Click any episode pill below to tune the Studio Broadcast Deck immediately.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a
          href="/tv/#ecosystem-channels"
          class="font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-amber/40 bg-brand-amber/10 text-brand-amber no-underline hover:bg-brand-amber/20 transition-all"
        >
          ▶ Watch Matching TV Channels →
        </a>
      </div>
    </div>

    <!-- 6 Flagship *.openie.dev Broadcast Desk Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
      {channels.map((ch: any) => (
        <div
          data-radio-desk={ch.id}
          class="radio-desk-card rounded-xl border border-brand-border bg-white/[0.02] p-4 flex flex-col justify-between transition-all hover:border-brand-cyan/40"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <a
                href={ch.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-[11px] font-semibold px-2.5 py-0.5 rounded border no-underline hover:opacity-90 transition-opacity"
                style={`color:${ch.accent}; border-color:${ch.accent}55; background:${ch.accent}14;`}
              >
                {ch.domain} ↗
              </a>
              <a
                href={`/tv/?channel=${ch.id}#ecosystem-channels`}
                class="font-mono text-[10px] text-brand-amber hover:underline no-underline"
              >
                TV Channel ({ch.tv_studies.length * 4} films) →
              </a>
            </div>

            <h3 class="font-display text-lg font-bold text-brand-white mb-0.5">
              {ch.name}
            </h3>
            <div class="font-mono text-[10px] uppercase tracking-wider text-brand-cyan mb-2">
              {ch.rungs}
            </div>
            <p class="font-body text-xs text-brand-slate leading-relaxed mb-3">
              {ch.plain_summary}
            </p>
            <div class="font-mono text-[10.5px] text-brand-amber mb-3 pb-2.5 border-b border-brand-border">
              {ch.key_metric}
            </div>

            <!-- Curated Roundtable Episodes -->
            <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray mb-1.5">
              Desk Roundtables:
            </div>
            <div class="space-y-1.5 mb-3">
              {ch.radio_episodes.map((eid: string) => {
                const ep = epById[eid];
                if (!ep) return null;
                return (
                  <button
                    type="button"
                    data-desk-tune-ep={ep.id}
                    data-desk-name={ch.name}
                    class="w-full text-left px-2.5 py-2 rounded-lg border border-brand-border bg-white/[0.025] hover:border-brand-cyan hover:bg-brand-cyan/10 cursor-pointer transition-all flex items-center justify-between gap-2"
                  >
                    <span class="font-body text-xs text-brand-light truncate">
                      <strong class="font-mono text-[10.5px] text-brand-cyan mr-1">EP 0{ep.number}</strong>
                      {ep.title.split('—')[0].trim()}
                    </span>
                    <span class="font-mono text-[10px] text-brand-amber shrink-0">
                      ▶ {ep.duration_human}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>

          {ch.companion_sites?.length > 0 && (
            <div class="pt-2.5 border-t border-brand-border flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[10px] text-brand-gray">
              <span>Stack links:</span>
              {ch.companion_sites.map((cs: any) => (
                <a
                  href={cs.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brand-slate hover:text-brand-cyan no-underline"
                >
                  {cs.label} ↗
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Extended *.openie.dev Periodic Stack Directory -->
    <div class="pt-4 border-t border-brand-border">
      <div class="font-mono text-[10px] uppercase tracking-[1.8px] text-brand-gray mb-2.5">
        Extended *.openie.dev Periodic Stack Research Network
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        {extended.map((item: any) => {
          const parentCh = channels.find((c: any) => c.id === item.channel);
          const leadEp = parentCh?.radio_episodes?.[0] || 'ep01-global-literature-radar';
          return (
            <div class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg border border-brand-border bg-white/[0.015]">
              <div class="min-w-0">
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[11px] font-semibold text-brand-white hover:text-brand-cyan no-underline block truncate"
                >
                  {item.name} · <span class="text-brand-amber">{item.domain}</span> ↗
                </a>
                <div class="font-body text-[11px] text-brand-gray truncate" title={item.role}>
                  {item.role}
                </div>
              </div>
              <button
                type="button"
                data-desk-tune-ep={leadEp}
                data-desk-name={item.name}
                class="font-mono text-[10px] px-2 py-1 rounded border border-brand-border text-brand-slate hover:border-brand-cyan hover:text-brand-cyan cursor-pointer bg-transparent shrink-0"
              >
                ◉ Tune
              </button>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
