---
interface Props {
  feed: any;
  radarCount: number;
  foundryCount: number;
}

const { feed, radarCount, foundryCount } = Astro.props;
const episodes = feed.episodes || [];
const firstEp = episodes[0] || { id: 'ep01-global-literature-radar', title: 'Loading...', subtitle: '', audio_url: '', captions_url: '', turns: [], cards: [] };
---

<section class="max-w-7xl mx-auto px-5 md:px-10 pt-8 pb-10">
  <!-- Hero & AI Persona Disclosure -->
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-6">
    <div>
      <div class="section-label mb-2 flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-red-500 pulse"></span>
        <span>24/7 Synchronized Broadcast · 6h Autonomous Literature &amp; Pilot Engine</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-brand-white">
        Open<span class="text-brand-cyan">IE</span> Research <span class="text-brand-amber">Radio</span>
      </h1>
      <p class="mt-3 font-body text-sm sm:text-base text-brand-slate max-w-3xl leading-relaxed">
        Conversational three-voice briefings auditing joules-to-correct-completion, kernel-checked state machines, biological quorum ratchets, live open-access preprints, and sub-60-second falsifier pilots.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/radio/rss.xml"
        class="inline-flex items-center gap-2 font-mono text-xs px-4 py-2.5 rounded-lg border border-brand-amber/40 bg-brand-amber/10 text-brand-amber no-underline hover:bg-brand-amber/20 transition-all"
      >
        <span>RSS</span>
        <span>Podcast Feed (/radio/rss.xml)</span>
      </a>
      <button
        id="copy-rss-btn"
        type="button"
        data-rss="https://research.openie.dev/radio/rss.xml"
        class="font-mono text-xs px-3.5 py-2.5 rounded-lg border border-brand-border bg-white/5 text-brand-light hover:border-brand-cyan hover:text-brand-cyan cursor-pointer transition-all"
      >
        Copy RSS URL
      </button>
    </div>
  </div>

  <!-- Explicit AI-Synthesized Persona Disclosure Box -->
  <div class="glass-card p-4 sm:p-5 mb-6 border-l-4 border-l-brand-cyan">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="text-xs sm:text-[13px] text-brand-light leading-relaxed">
        <strong class="font-mono text-brand-cyan uppercase tracking-wider mr-1.5">AI Persona Disclosure:</strong>
        <span>
          <strong>Elena</strong>, <strong>Marcus</strong>, and <strong>Devon</strong> are <strong>AI-synthesized OpenIE research personas</strong> voiced via open-weight neural speech synthesis and grounded strictly in verified Open Interface Engineering artifacts, deterministic pilot receipts, and live sanctioned open-access feeds.
        </span>
      </div>
      <div class="flex flex-wrap gap-2 shrink-0">
        <span class="font-mono text-[11px] px-2.5 py-1 rounded-md border border-brand-cyan/30 bg-brand-cyan/10 text-brand-cyan">Elena · Host</span>
        <span class="font-mono text-[11px] px-2.5 py-1 rounded-md border border-brand-amber/30 bg-brand-amber/10 text-brand-amber">Marcus · Skeptic</span>
        <span class="font-mono text-[11px] px-2.5 py-1 rounded-md border border-brand-indigo/30 bg-brand-indigo/10 text-brand-indigo">Devon · Bench Specialist</span>
      </div>
    </div>
  </div>

  <!-- LIVE ON AIR Synchronized Global Rotation Bar -->
  <div class="glass-card p-4 sm:p-5 mb-6 border border-red-500/30 bg-gradient-to-r from-red-500/10 via-brand-navy/60 to-brand-cyan/5">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div class="flex items-start sm:items-center gap-3.5">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-500/20 border border-red-500/50 font-mono text-[11px] font-semibold text-red-400 shrink-0">
          <span class="w-2 h-2 rounded-full bg-red-500 pulse"></span>
          LIVE ON AIR
        </span>
        <div>
          <div class="font-display text-sm sm:text-base font-bold text-brand-white" id="live-ep-title">
            Synchronizing 24/7 rotation clock…
          </div>
          <div class="font-mono text-[11px] text-brand-slate mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>Clock: <strong class="text-brand-amber" id="live-ep-clock">--:-- / --:--</strong></span>
            <span>Active mic: <strong class="text-brand-cyan" id="live-speaker-badge">Elena</strong></span>
            <span>Loop total: <strong>{feed.total_duration_human}</strong> across {episodes.length} episodes</span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <button
          id="tune-in-live-btn"
          type="button"
          class="font-mono text-xs font-semibold px-4 py-2.5 rounded-lg bg-brand-amber text-brand-dark hover:opacity-90 cursor-pointer transition-all shadow-sm"
        >
          Tune In Live Now
        </button>
        <span id="playback-mode-pill" class="font-mono text-[11px] px-2.5 py-1 rounded border border-brand-border text-brand-gray">
          Mode: On-Demand Ready
        </span>
      </div>
    </div>
  </div>

  <!-- Section Navigation Tabs -->
  <div class="flex flex-wrap gap-2 mb-6 border-b border-brand-border pb-3" role="tablist" aria-label="Research Radio Views">
    <button type="button" data-radio-tab="all" class="radio-tab-btn font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-amber/50 bg-brand-amber/15 text-brand-amber cursor-pointer">
      All Studio Views
    </button>
    <button type="button" data-radio-tab="studio" class="radio-tab-btn font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer">
      1 · Broadcast Deck &amp; Transcript ({episodes.length})
    </button>
    <button type="button" data-radio-tab="radar" class="radio-tab-btn font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer">
      2 · Active Global Literature Radar ({radarCount})
    </button>
    <button type="button" data-radio-tab="foundry" class="radio-tab-btn font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer">
      3 · Topic Idea Foundry &amp; &lt;60s Pilots ({foundryCount})
    </button>
  </div>

  <!-- TAB 1: STUDIO DECK, WAVEFORM, EPISODES, TRANSCRIPT & POP-UP CARDS -->
  <div id="radio-panel-studio" class="space-y-6">
    <!-- Master Audio Deck + WebAudio Canvas Visualizer -->
    <div class="glass-card p-5 sm:p-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <div>
          <div class="font-mono text-[11px] text-brand-amber uppercase tracking-wider" id="deck-ep-kicker">
            Episode {firstEp.number} of {episodes.length}
          </div>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-brand-white mt-0.5" id="deck-ep-title">
            {firstEp.title}
          </h2>
          <p class="font-body text-xs sm:text-sm text-brand-slate mt-1" id="deck-ep-subtitle">
            {firstEp.subtitle}
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span class="font-mono text-[11px] text-brand-gray mr-1">Speed:</span>
          {[1, 1.25, 1.5, 2].map((sp) => (
            <button
              type="button"
              data-speed={sp}
              class={`speed-btn font-mono text-xs px-2.5 py-1 rounded border cursor-pointer transition-colors ${sp === 1 ? 'border-brand-cyan bg-brand-cyan/15 text-brand-cyan' : 'border-brand-border text-brand-slate hover:text-brand-white'}`}
            >
              {sp}x
            </button>
          ))}
        </div>
      </div>

      <!-- Real-Time WebAudio Canvas Spectrum + Waveform -->
      <div class="relative rounded-xl overflow-hidden border border-brand-border bg-black/40 mb-4">
        <canvas id="radio-visualizer" width="960" height="116" class="w-full h-[96px] sm:h-[116px] block"></canvas>
        <div class="absolute top-2.5 left-3 flex items-center gap-2 pointer-events-none">
          <span id="active-turn-speaker-chip" class="font-mono text-[11px] px-2.5 py-0.5 rounded bg-brand-cyan/20 border border-brand-cyan/40 text-brand-cyan">
            Elena · Ready
          </span>
        </div>
        <div class="absolute top-2.5 right-3 font-mono text-[10px] text-brand-gray pointer-events-none">
          WebAudio FFT + Oscilloscope · AAC 96k (-16 LUFS)
        </div>
      </div>

      <!-- Transport Controls -->
      <audio id="radio-audio" preload="metadata" crossorigin="anonymous" src={firstEp.audio_url}>
        <track id="radio-vtt-track" kind="captions" srclang="en" label="English Transcript" src={firstEp.captions_url} default />
      </audio>

      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex items-center gap-2">
          <button id="play-pause-btn" type="button" class="font-mono text-xs font-bold px-4 py-2 rounded-lg bg-brand-cyan text-brand-dark hover:opacity-90 cursor-pointer min-w-[92px]">
            ▶ Play
          </button>
          <button id="seek-back-btn" type="button" class="font-mono text-xs px-2.5 py-2 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer" title="Back 15 seconds">
            -15s
          </button>
          <button id="seek-fwd-btn" type="button" class="font-mono text-xs px-2.5 py-2 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer" title="Forward 15 seconds">
            +15s
          </button>
        </div>

        <div class="flex-1 flex items-center gap-3">
          <span id="deck-cur-time" class="font-mono text-xs text-brand-light w-12 text-right">0:00</span>
          <input
            id="deck-scrubber"
            type="range"
            min="0"
            max="1000"
            value="0"
            aria-label="Seek episode timeline"
            class="flex-1 accent-amber-500 cursor-pointer h-1.5"
          />
          <span id="deck-dur-time" class="font-mono text-xs text-brand-gray w-12">{firstEp.duration_human}</span>
        </div>

        <a
          id="deck-download-link"
          href={firstEp.audio_url}
          download
          class="font-mono text-[11px] px-3 py-1.5 rounded border border-brand-border text-brand-slate no-underline hover:border-brand-amber hover:text-brand-amber text-center"
        >
          .m4a
        </a>
      </div>
    </div>

    <!-- 3-Column Studio Grid: Playlist | Interactive Transcript | Live Citation & Falsifier Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Episode Playlist (4 cols) -->
      <div class="lg:col-span-4 glass-card p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-mono text-xs uppercase tracking-wider text-brand-amber">8 Launch Episodes</h3>
          <span class="font-mono text-[11px] text-brand-gray">{feed.total_duration_human} total</span>
        </div>
        <div class="space-y-2 max-h-[540px] overflow-y-auto pr-1" id="episode-list">
          {episodes.map((ep: any, i: number) => (
            <button
              type="button"
              data-ep-id={ep.id}
              class={`ep-select-btn w-full text-left p-3 rounded-lg border transition-all cursor-pointer block ${i === 0 ? 'border-brand-amber/60 bg-brand-amber/10' : 'border-brand-border bg-white/[0.015] hover:border-brand-cyan/40'}`}
            >
              <div class="flex items-center justify-between font-mono text-[10px] text-brand-gray mb-1">
                <span class="text-brand-cyan font-semibold">EP 0{ep.number}</span>
                <span>{ep.duration_human} · {ep.turn_count} turns · {ep.card_count} cards</span>
              </div>
              <div class="font-display text-xs sm:text-[13px] font-semibold text-brand-white leading-snug">
                {ep.title}
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Auto-Scrolling Interactive Transcript (5 cols) -->
      <div class="lg:col-span-5 glass-card p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-mono text-xs uppercase tracking-wider text-brand-cyan">Turn-Synced Transcript</h3>
          <span class="font-mono text-[10px] text-brand-gray">Click any line to seek</span>
        </div>
        <div id="transcript-container" class="space-y-2.5 max-h-[540px] overflow-y-auto pr-1.5">
          {firstEp.turns.map((t: any) => (
            <div
              data-turn-idx={t.turn_index}
              data-start={t.start_sec}
              class="transcript-turn p-3 rounded-lg border border-brand-border bg-white/[0.015] hover:border-brand-cyan/40 cursor-pointer transition-all"
            >
              <div class="flex items-center justify-between font-mono text-[10px] mb-1">
                <span class={t.speaker === 'Elena' ? 'text-brand-cyan font-bold' : t.speaker === 'Marcus' ? 'text-brand-amber font-bold' : 'text-brand-indigo font-bold'}>
                  {t.speaker}
                </span>
                <span class="text-brand-gray">{Math.floor(t.start_sec / 60)}:{String(Math.floor(t.start_sec % 60)).padStart(2, '0')}</span>
              </div>
              <p class="font-body text-xs sm:text-[13px] text-brand-light leading-relaxed m-0">{t.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Synchronized Pop-Up Citation & Falsifier Cards (3 cols) -->
      <div class="lg:col-span-3 glass-card p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-mono text-xs uppercase tracking-wider text-brand-indigo">Citation &amp; Falsifier Deck</h3>
          <span id="active-card-indicator" class="font-mono text-[10px] text-brand-amber">Synced</span>
        </div>
        <div id="cards-container" class="space-y-2.5 max-h-[540px] overflow-y-auto pr-1">
          {firstEp.cards.map((c: any) => (
            <div
              data-card-id={c.id}
              data-at={c.at_sec}
              class="citation-card p-3 rounded-lg border border-brand-border bg-white/[0.02] transition-all"
            >
              <div class="flex items-center justify-between gap-1 font-mono text-[10px] mb-1.5">
                <span class="px-1.5 py-0.5 rounded bg-brand-amber/15 text-brand-amber border border-brand-amber/30">{c.badge}</span>
                <button type="button" data-seek-sec={c.at_sec} class="text-brand-cyan hover:underline cursor-pointer bg-transparent border-0 p-0 font-mono text-[10px]">
                  @{Math.floor(c.at_sec / 60)}:{String(Math.floor(c.at_sec % 60)).padStart(2, '0')}
                </button>
              </div>
              <div class="font-display text-xs font-bold text-brand-white mb-1">{c.title}</div>
              <p class="font-body text-[11px] text-brand-slate leading-snug mb-2">{c.detail}</p>
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="font-mono text-[10px] text-brand-cyan no-underline hover:underline">
                Inspect artifact →
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
