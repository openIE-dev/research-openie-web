---
// Global 4-Altitude Reading Depth Bar ("Simplest First, Complex Last Resort").
// Whisper-quiet floating glass pill bar: syncs html[data-reading-depth="plain|visual|builder|formal"],
// persists in localStorage('oe-reading-depth'), and honors ?depth=plain|visual|builder|formal URL overrides.
---

<nav
  id="gw-depth-bar"
  data-gw-bar
  data-active-depth="plain"
  aria-label="Reading depth selector"
  class="sticky top-16 z-80 px-3 py-1.5 flex justify-center pointer-events-none print:hidden"
>
  <span id="gw-depth-desc" class="sr-only">
    Everyday words, 15s video &amp; core idea first — complex math stays tucked away until you ask.
  </span>

  <div
    class="gw-depth-pill pointer-events-auto inline-flex items-center gap-0.5 sm:gap-1 px-1.5 py-1 rounded-full border border-brand-border backdrop-blur-xl shadow-lg max-w-full"
    role="group"
    aria-label="Choose how much technical detail to show"
  >
    <span class="hidden sm:inline font-mono text-[9.5px] tracking-[0.16em] uppercase text-brand-gray pl-2.5 pr-1.5 select-none">
      Depth
    </span>
    <button
      type="button"
      data-gw-set-depth="plain"
      aria-pressed="true"
      title="Default: Everyday words, real-world analogy, 15-second video & core result"
      class="gw-depth-btn font-mono text-[10.5px] sm:text-[11px] px-2.5 sm:px-3 py-1 rounded-full cursor-pointer transition-all whitespace-nowrap"
    >
      1 · Plain
    </button>
    <button
      type="button"
      data-gw-set-depth="visual"
      aria-pressed="false"
      title="Add interactive browser simulators, visual diagrams & how to test us"
      class="gw-depth-btn font-mono text-[10.5px] sm:text-[11px] px-2.5 sm:px-3 py-1 rounded-full cursor-pointer transition-all whitespace-nowrap"
    >
      2 · Visual
    </button>
    <button
      type="button"
      data-gw-set-depth="builder"
      aria-pressed="false"
      title="Add [G0–G12] source sheets, hardware sensor receipts, Braille transcripts & code repos"
      class="gw-depth-btn font-mono text-[10.5px] sm:text-[11px] px-2.5 sm:px-3 py-1 rounded-full cursor-pointer transition-all whitespace-nowrap"
    >
      3 · Builder
    </button>
    <button
      type="button"
      data-gw-set-depth="formal"
      aria-pressed="false"
      title="Last Resort: Expand the complete formal manuscript, equations & machine proofs"
      class="gw-depth-btn font-mono text-[10.5px] sm:text-[11px] px-2.5 sm:px-3 py-1 rounded-full cursor-pointer transition-all whitespace-nowrap"
    >
      4 · Full Spec
    </button>
  </div>
</nav>

<script is:inline>
  (function () {
    var DESCRIPTIONS = {
      plain: 'Everyday words, 15s video & core idea first — complex math stays tucked away until you ask.',
      visual: 'Plain story + interactive browser simulators, falsifiers & late-2026 research links.',
      builder: 'Plain + Visual + signed [G0–G12] source sheets, hardware sensor receipts & code repos.',
      formal: 'Last Resort active: complete technical manuscript, equations & proofs expanded everywhere.'
    };
    var ALLOWED = ['plain', 'visual', 'builder', 'formal'];

    function currentDepth() {
      var attr = document.documentElement.getAttribute('data-reading-depth') || 'plain';
      return ALLOWED.indexOf(attr) !== -1 ? attr : 'plain';
    }

    function syncDepthUi(depth) {
      var descEl = document.getElementById('gw-depth-desc');
      if (descEl && DESCRIPTIONS[depth]) descEl.textContent = DESCRIPTIONS[depth];
      var barEl = document.getElementById('gw-depth-bar');
      if (barEl) barEl.setAttribute('data-active-depth', depth);
      document.documentElement.setAttribute('data-gw-depth', depth);
      document.querySelectorAll('[data-gw-set-depth]').forEach(function (btn) {
        var active = btn.getAttribute('data-gw-set-depth') === depth;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('gw-depth-btn-active', active);
      });
    }

    function setReadingDepth(nextDepth, opts) {
      if (ALLOWED.indexOf(nextDepth) === -1) nextDepth = 'plain';
      document.documentElement.setAttribute('data-reading-depth', nextDepth);
      document.documentElement.setAttribute('data-gw-depth', nextDepth);
      if (!opts || opts.persist !== false) {
        try { localStorage.setItem('oe-reading-depth', nextDepth); } catch (_e) {}
      }
      if (opts && opts.syncUrl && window.history && window.history.replaceState) {
        var u = new URL(window.location.href);
        if (nextDepth === 'plain' && !u.searchParams.has('depth')) {
          // keep clean URL for default
        } else {
          u.searchParams.set('depth', nextDepth);
          window.history.replaceState(null, '', u.pathname + u.search + u.hash);
        }
      }
      syncDepthUi(nextDepth);
      window.dispatchEvent(new CustomEvent('openie:reading-depth', { detail: { depth: nextDepth } }));
    }

    window.__openieSetReadingDepth = setReadingDepth;

    document.querySelectorAll('[data-gw-set-depth]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var d = btn.getAttribute('data-gw-set-depth') || 'plain';
        var hasParam = new URLSearchParams(window.location.search).has('depth');
        setReadingDepth(d, { persist: true, syncUrl: hasParam });
      });
    });

    syncDepthUi(currentDepth());
  })();
</script>

<style is:global>
  .gw-depth-pill {
    background: rgba(11, 14, 23, 0.76);
  }
  html[data-theme="light"] .gw-depth-pill {
    background: rgba(255, 255, 255, 0.86);
  }
  .gw-depth-btn {
    color: var(--color-brand-slate);
    background: transparent;
    border: 1px solid transparent;
  }
  .gw-depth-btn:hover {
    color: var(--color-brand-white);
    background: rgba(255, 255, 255, 0.05);
  }
  html[data-theme="light"] .gw-depth-btn:hover {
    background: rgba(15, 23, 42, 0.05);
  }
  .gw-depth-btn.gw-depth-btn-active {
    color: #090b10;
    background: var(--color-brand-amber);
    border-color: var(--color-brand-amber);
    font-weight: 600;
    box-shadow: 0 2px 10px rgba(245, 158, 11, 0.25);
  }
  html[data-theme="light"] .gw-depth-btn.gw-depth-btn-active {
    color: #ffffff;
  }
</style>
