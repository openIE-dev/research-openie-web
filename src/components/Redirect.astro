---
// Static redirect that keeps the section anchor. Old ids map to new ids where a heading moved.
interface Props { target: string; map?: Record<string, string>; title?: string }
const { target, map = {}, title = 'Moved' } = Astro.props;
const abs = new URL(target, 'https://research.openie.dev').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="canonical" href={abs} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ target, map }}>
      var h = location.hash ? location.hash.slice(1) : '';
      try { h = decodeURIComponent(h); } catch (e) {}
      var id = h ? (map[h] || h) : '';
      var base = target.split('#')[0];
      location.replace(id ? base + '#' + encodeURIComponent(id) : target);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>This page moved to <a href={target}>{abs}</a>.</p>
  </body>
</html>
