---
// Pure Astro theme toggle — dark / light / auto (matches openie.dev)
---

<button id="theme-toggle" title="Theme: Auto" aria-label="Theme: Auto. Click to change." class="flex items-center gap-1.5 text-brand-slate hover:text-brand-white transition-colors cursor-pointer bg-transparent border-none p-1">
  <svg id="theme-icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg id="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <svg id="theme-icon-auto" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
    <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
    <line x1="8" y1="21" x2="16" y2="21" />
    <line x1="12" y1="17" x2="12" y2="21" />
  </svg>
  <span id="theme-label" class="font-mono text-[11px]">Auto</span>
</button>

<script>
  const STORAGE_KEY = 'oe-theme';
  const order = ['dark', 'light', 'auto'];

  function getSystemTheme() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: string) {
    const resolved = theme === 'auto' ? getSystemTheme() : theme;
    document.documentElement.setAttribute('data-theme', resolved);
    document.documentElement.style.colorScheme = resolved;
  }

  function updateUI(theme: string) {
    const btn = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-label');
    const iconDark = document.getElementById('theme-icon-dark');
    const iconLight = document.getElementById('theme-icon-light');
    const iconAuto = document.getElementById('theme-icon-auto');

    if (!btn || !label || !iconDark || !iconLight || !iconAuto) return;

    const displayName = theme === 'dark' ? 'Dark' : theme === 'light' ? 'Light' : 'Auto';
    btn.title = `Theme: ${displayName}`;
    btn.setAttribute('aria-label', `Theme: ${displayName}. Click to change.`);
    label.textContent = displayName;

    iconDark.classList.toggle('hidden', theme !== 'dark');
    iconLight.classList.toggle('hidden', theme !== 'light');
    iconAuto.classList.toggle('hidden', theme !== 'auto');
  }

  function init() {
    const stored = localStorage.getItem(STORAGE_KEY);
    const theme = stored && order.includes(stored) ? stored : 'auto';
    applyTheme(theme);
    updateUI(theme);

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const current = localStorage.getItem(STORAGE_KEY) || 'auto';
      const next = order[(order.indexOf(current) + 1) % 3];
      localStorage.setItem(STORAGE_KEY, next);
      applyTheme(next);
      updateUI(next);
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      const current = localStorage.getItem(STORAGE_KEY) || 'auto';
      if (current === 'auto') applyTheme('auto');
    });
  }

  init();
</script>
