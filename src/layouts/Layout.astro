---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LiveCallDock from '../components/live/LiveCallDock.astro';
import { LANGS, NAV_EN } from '../i18n';
import { studies } from '../data/studyList';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description = "OpenIE Research: research studies by David Charlot at Open Interface Engineering, each with a web edition, a PDF, and interactive figures.",
  lang = 'en',
  dir = 'ltr',
  alternates = [],
} = Astro.props;

const N: typeof NAV_EN = (LANGS as any)[lang]?.nav ?? NAV_EN;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://research.openie.dev').href;
---

<!DOCTYPE html>
<html lang={lang} dir={dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F59E0B" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | OpenIE Research</title>

    <meta property="og:title" content={`${title} | OpenIE Research`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpenIE Research" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="author" content="David Charlot" />
    <link rel="describedby" type="text/markdown" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="OpenIE Research Full Corpus (llms-full.txt)" href="/llms-full.txt" />
    <link rel="alternate" type="application/json" title="OpenIE Research Catalog JSON" href="/catalog.json" />
    <link rel="alternate" type="application/atom+xml" title="OpenIE Research Atom Feed" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="OpenIE Research Radio Podcast" href="/radio/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="OpenIE Research Medium Canonical Syndication Feed" href="/feeds/medium.xml" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | OpenIE Research`} />
    <meta name="twitter:description" content={description} />
    <script is:inline src="/webmcp-tools.js" defer></script>
    <slot name="head" />

    <script is:inline>
      (function(){
        var stored = localStorage.getItem('oe-theme');
        var theme = stored && ['dark','light','auto'].indexOf(stored) !== -1 ? stored : 'auto';
        if (theme === 'auto') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col noise-overlay grid-bg">
    <nav id="nav" aria-label="Main navigation" class="nav-glass fixed top-0 left-0 right-0 z-100 px-6 md:px-10 py-4 md:py-5 flex justify-between items-center transition-all duration-400">
      <a href="/" aria-label="OpenIE Research home" class="font-display text-[22px] font-bold tracking-tight text-brand-white no-underline hover:no-underline">
        Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Research</span>
      </a>

      <button id="mobile-menu-btn" aria-label={N.menu} aria-expanded="false" aria-controls="nav-links" class="md:hidden flex flex-col gap-1.5 p-2 text-brand-slate cursor-pointer bg-transparent border-none">
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-top"></span>
        <span class="block w-5 h-0.5 bg-current transition-opacity" id="burger-mid"></span>
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-bot"></span>
      </button>

      <div id="nav-links" class="hidden md:flex gap-5 items-center max-md:fixed max-md:inset-0 max-md:top-[60px] max-md:bg-brand-dark/95 max-md:backdrop-blur-xl max-md:flex-col max-md:justify-center max-md:gap-8 max-md:z-50">
        <a href="/#catalog" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">{N.papers}</a>
        <a href="/living/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">{N.figures}</a>
        <a href="/tv/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-amber no-underline hover:text-brand-white transition-colors">TV</a>
        <a href="/radio/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-cyan no-underline hover:text-brand-white transition-colors">Radio</a>
        <a href="/live/" class="font-body text-[13px] max-md:text-lg font-medium text-emerald-400 no-underline hover:text-brand-white transition-colors inline-flex items-center gap-1.5"><span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Live</a>
        <a href="/syndication/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Syndication</a>
        <a href="/tutorials/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Tutorials</a>
        <a href="/data/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Data</a>
        <a href="/about/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">{N.about}</a>
        <a href="/glossary/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">{N.glossary}</a>
        <a href="/faq/" class="font-body text-[13px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">FAQ</a>
        <a href="https://avalanche.openie.dev" class="font-mono text-xs max-md:text-sm text-brand-amber border border-brand-amber/40 px-3 py-1.5 rounded-md no-underline hover:bg-brand-amber/10 hover:border-brand-amber transition-all">
          Avalanche
        </a>
        <a href="https://openie.dev" class="font-mono text-xs max-md:text-sm text-brand-cyan border border-brand-cyan/30 px-3 py-1.5 rounded-md no-underline hover:bg-brand-cyan/10 hover:border-brand-cyan transition-all">
          openie.dev
        </a>
        <div class="flex items-center gap-2 md:ml-2 md:pl-2 md:border-l md:border-brand-border">
          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main class="flex-1 pt-16 relative z-10">
      <slot />
    </main>

    <footer class="relative z-2 border-t border-brand-border px-6 md:px-10 py-10" role="contentinfo">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-8">
        <div>
          <div class="font-display text-sm text-brand-white mb-3">
            Open<span class="text-brand-cyan">IE</span> Research
          </div>
          <p class="font-body text-[12px] text-brand-gray max-w-[320px] leading-relaxed">
            Research papers hub for Open Interface Engineering, Inc.<br>
            Papers + PDFs · figures under /living · no paid services
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-12">
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Papers</div>
            <div class="space-y-2">
              {studies.map((s) => <a href={s.path} class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">{s.short_title}</a>)}
              <a href="/rce/download/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">RCE download</a>
              <a href="/living/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Figures</a>
              <a href="/tv/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Research TV (140 films)</a>
              <a href="/radio/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Research Radio</a>
              <a href="/live/" class="block font-body text-[12px] text-emerald-300 no-underline hover:text-brand-cyan transition-colors">Research Live (Voice &amp; Video)</a>
              <a href="/syndication/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Syndication (X · Medium · TikTok)</a>
              <a href="/blueprint/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Unsiloeing blueprint</a>
              <a href="/tutorials/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Interactive tutorials</a>
              <a href="/about/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">About</a>
              <a href="/glossary/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Glossary</a>
              <a href="/faq/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">RCE FAQ</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">PDFs</div>
            <div class="space-y-2">
              {studies.map((s) => <a href={s.pdfPath} class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">{s.short_title}</a>)}
              <a href="/data/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Data and code</a>
              <a href="/changelog/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Changelog</a>
              <a href="/opportunity-map/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Opportunity map</a>
              <a href="/llms.txt" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">llms.txt</a>
              <a href="/llms-full.txt" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">llms-full.txt</a>
              <a href="/catalog.json" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">catalog.json</a>
              <a href="/feed.xml" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Atom feed</a>
              <a href="/radio/rss.xml" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Podcast RSS</a>
              <a href="/feeds/medium.xml" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Medium canonical RSS</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Family (*.openie.dev)</div>
            <div class="space-y-2">
              <a href="https://openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">OpenIE</a>
              <a href="https://avalanche.openie.dev" class="block font-body text-[12px] text-brand-amber no-underline hover:text-brand-white transition-colors">Avalanche (9 Rungs)</a>
              <a href="https://stack.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Stack</a>
              <a href="https://compute.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Compute</a>
              <a href="https://synthesis.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Synthesis</a>
              <a href="https://knowledge.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Knowledge</a>
              <a href="https://database.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Database &amp; Data</a>
              <a href="https://state.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">State</a>
              <a href="https://communication.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Communication</a>
              <a href="https://memory.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Memory</a>
              <a href="https://agent.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Agent</a>
              <a href="https://proof.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Verify</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Contract</div>
            <div class="space-y-2">
              <span class="block font-body text-[12px] text-brand-slate">board_metered=false, except the KV260 rungs in Metered Commit Gates and the Jetson Thor shunt runs in Satiation Benchmark Harness and Communication Tool Avalanche</span>
              <span class="block font-body text-[12px] text-brand-slate">research.openie.dev</span>
            </div>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto mt-8 pt-6 border-t border-brand-border font-mono text-[10px] text-brand-gray">
        © Open Interface Engineering, Inc. Research, free to read, on how to use less energy.
      </div>
    </footer>

    <LiveCallDock />

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');
      const burgerTop = document.getElementById('burger-top');
      const burgerMid = document.getElementById('burger-mid');
      const burgerBot = document.getElementById('burger-bot');
      let menuOpen = false;

      btn?.addEventListener('click', () => {
        menuOpen = !menuOpen;
        btn.setAttribute('aria-expanded', String(menuOpen));
        navLinks?.classList.toggle('hidden', !menuOpen);
        navLinks?.classList.toggle('flex', menuOpen);
        if (burgerTop) burgerTop.style.transform = menuOpen ? 'translateY(4px) rotate(45deg)' : '';
        if (burgerMid) burgerMid.style.opacity = menuOpen ? '0' : '1';
        if (burgerBot) burgerBot.style.transform = menuOpen ? 'translateY(-4px) rotate(-45deg)' : '';
      });

      navLinks?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (menuOpen) {
            menuOpen = false;
            navLinks.classList.add('hidden');
            navLinks.classList.remove('flex');
            if (burgerTop) burgerTop.style.transform = '';
            if (burgerMid) burgerMid.style.opacity = '1';
            if (burgerBot) burgerBot.style.transform = '';
          }
        });
      });

      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menuOpen) btn?.click(); });

      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 60);
      });
    </script>
    <script>import '../scripts/lightbox.js';</script>
  </body>
</html>
