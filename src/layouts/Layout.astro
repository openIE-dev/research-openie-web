---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import GravityWellDepthBar from '../components/GravityWellDepthBar.astro';
import LiveCallDock from '../components/live/LiveCallDock.astro';
import { LANGS, NAV_EN } from '../i18n';
import { studies } from '../data/studyList';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description = "OpenIE Research: research studies by David Charlot at Open Interface Engineering, each with a web edition, a PDF, and interactive figures.",
  lang = 'en',
  dir = 'ltr',
  alternates = [],
} = Astro.props;

const N: typeof NAV_EN = (LANGS as any)[lang]?.nav ?? NAV_EN;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://research.openie.dev').href;
---

<!DOCTYPE html>
<html lang={lang} dir={dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F59E0B" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | OpenIE Research</title>

    <meta property="og:title" content={`${title} | OpenIE Research`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpenIE Research" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="author" content="David Charlot" />
    <link rel="describedby" type="text/markdown" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="OpenIE Research Full Corpus (llms-full.txt)" href="/llms-full.txt" />
    <link rel="alternate" type="application/json" title="OpenIE Research Catalog JSON" href="/catalog.json" />
    <link rel="alternate" type="application/atom+xml" title="OpenIE Research Atom Feed" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="OpenIE Research Radio Podcast" href="/radio/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="OpenIE Research Medium Canonical Syndication Feed" href="/feeds/medium.xml" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | OpenIE Research`} />
    <meta name="twitter:description" content={description} />
    <script is:inline src="/webmcp-tools.js" defer></script>
    <slot name="head" />

    <script is:inline>
      (function(){
        var stored = localStorage.getItem('oe-theme');
        var theme = stored && ['dark','light','auto'].indexOf(stored) !== -1 ? stored : 'auto';
        if (theme === 'auto') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;

        var allowedDepth = ['plain','visual','builder','formal'];
        var qDepth = '';
        try { qDepth = (new URLSearchParams(window.location.search).get('depth') || '').toLowerCase(); } catch (_e) {}
        var savedDepth = '';
        try { savedDepth = localStorage.getItem('oe-reading-depth') || ''; } catch (_e) {}
        var depth = allowedDepth.indexOf(qDepth) !== -1 ? qDepth : (allowedDepth.indexOf(savedDepth) !== -1 ? savedDepth : 'plain');
        if (allowedDepth.indexOf(qDepth) !== -1) {
          try { localStorage.setItem('oe-reading-depth', depth); } catch (_e) {}
        }
        document.documentElement.setAttribute('data-reading-depth', depth);
        document.documentElement.setAttribute('data-gw-depth', depth);
        document.documentElement.classList.add('js-motion');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col noise-overlay grid-bg overflow-x-clip">
    <nav id="nav" aria-label="Main navigation" class="nav-glass fixed top-0 left-0 right-0 z-100 px-6 md:px-12 h-16 flex justify-between items-center transition-all duration-400">
      <a href="/" aria-label="OpenIE Research home" class="font-display text-[21px] font-bold tracking-tight text-brand-white no-underline hover:no-underline shrink-0">
        Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Research</span>
      </a>

      <button id="mobile-menu-btn" aria-label={N.menu} aria-expanded="false" aria-controls="nav-links" class="md:hidden flex flex-col gap-1.5 p-2 text-brand-slate cursor-pointer bg-transparent border-none">
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-top"></span>
        <span class="block w-5 h-0.5 bg-current transition-opacity" id="burger-mid"></span>
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-bot"></span>
      </button>

      <div id="nav-links" class="hidden md:flex gap-7 lg:gap-9 items-center max-md:fixed max-md:inset-0 max-md:top-16 max-md:bg-brand-dark/96 max-md:backdrop-blur-2xl max-md:flex-col max-md:items-stretch max-md:px-6 max-md:z-50">
        <a href="/#catalog" class="font-body text-sm max-md:text-base font-medium text-brand-light/90 no-underline hover:text-brand-white transition-colors">{lang === 'en' ? 'Studies' : N.papers}</a>
        <a href="/living/" class="font-body text-sm max-md:text-base font-medium text-brand-light/90 no-underline hover:text-brand-white transition-colors">{lang === 'en' ? 'Interactive' : N.figures}</a>
        <a href="/tv/" class="font-body text-sm max-md:text-base font-medium text-brand-light/90 no-underline hover:text-brand-white transition-colors">TV &amp; Radio</a>
        <a href="/live/" class="font-body text-sm max-md:text-base font-medium text-emerald-400 no-underline hover:text-emerald-300 transition-colors inline-flex items-center gap-2"><span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 pulse"></span>Live</a>

        <details id="nav-explore-menu" class="relative max-md:w-full">
          <summary class="list-none [&::-webkit-details-marker]:hidden font-body text-sm max-md:text-base font-medium text-brand-slate hover:text-brand-white transition-colors cursor-pointer select-none inline-flex items-center gap-1.5 py-1.5 px-2.5 rounded-full hover:bg-white/[0.04]">
            <span>Explore</span>
            <span class="text-[11px] opacity-75 transition-transform duration-200" id="nav-explore-caret">▾</span>
          </summary>

          <div class="nav-explore-panel md:absolute md:right-0 md:top-full md:mt-3 md:w-[440px] max-md:mt-2 rounded-2xl p-5 border border-brand-border shadow-2xl backdrop-blur-2xl z-120">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-brand-amber mb-2.5">Research &amp; Tools</div>
                <div class="flex flex-col gap-1">
                  <a href="/constellation/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-cyan hover:bg-white/[0.04] transition-colors">Constellation</a>
                  <a href="/standards/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-amber hover:bg-white/[0.04] transition-colors">Standards</a>
                  <a href="/replication/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-emerald-300 hover:bg-white/[0.04] transition-colors">Replicate</a>
                  <a href="/radio/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-cyan hover:bg-white/[0.04] transition-colors">Radio</a>
                  <a href="/tutorials/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-white hover:bg-white/[0.04] transition-colors">Tutorials</a>
                  <a href="/data/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-white hover:bg-white/[0.04] transition-colors">Data</a>
                </div>
              </div>

              <div>
                <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-brand-cyan mb-2.5">Context &amp; Ecosystem</div>
                <div class="flex flex-col gap-1">
                  <a href="https://blog.openie.dev" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-amber hover:bg-white/[0.04] transition-colors">Chronicle</a>
                  <a href="/syndication/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-white hover:bg-white/[0.04] transition-colors">Syndication</a>
                  <a href="/about/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-white hover:bg-white/[0.04] transition-colors">{N.about}</a>
                  <a href="/glossary/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-white hover:bg-white/[0.04] transition-colors">{N.glossary}</a>
                  <a href="/faq/" class="font-body text-[13px] py-1.5 px-2.5 rounded-lg text-brand-light no-underline hover:text-brand-white hover:bg-white/[0.04] transition-colors">FAQ</a>
                  <a href="https://avalanche.openie.dev" class="font-mono text-xs py-1.5 px-2.5 rounded-lg text-brand-amber no-underline hover:bg-brand-amber/10 transition-colors">Avalanche ↗</a>
                  <a href="https://openie.dev" class="font-mono text-xs py-1.5 px-2.5 rounded-lg text-brand-cyan no-underline hover:bg-brand-cyan/10 transition-colors">openie.dev ↗</a>
                </div>
              </div>
            </div>
          </div>
        </details>

        <div class="flex items-center gap-2 md:pl-3 md:border-l md:border-brand-border max-md:pt-2 max-md:border-t max-md:border-brand-border">
          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main class="flex-1 pt-16 relative z-10">
      <GravityWellDepthBar />
      <slot />
    </main>

    <footer class="relative z-2 border-t border-brand-border px-6 md:px-12 py-16 md:py-24 mt-12" role="contentinfo">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-8">
        <div>
          <div class="font-display text-sm text-brand-white mb-3">
            Open<span class="text-brand-cyan">IE</span> Research
          </div>
          <p class="font-body text-[12px] text-brand-gray max-w-[320px] leading-relaxed">
            Research papers hub for Open Interface Engineering, Inc.<br>
            Papers + PDFs · figures under /living · no paid services
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-12">
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Papers</div>
            <div class="space-y-2">
              {studies.map((s) => <a href={s.path} class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">{s.short_title}</a>)}
              <a href="/rce/download/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">RCE download</a>
              <a href="/living/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Figures</a>
              <a href="/tv/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Research TV (145 films)</a>
              <a href="/radio/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Research Radio (17 WAI1)</a>
              <a href="/sourcesheets/" class="block font-body text-[12px] text-brand-amber no-underline hover:text-brand-cyan transition-colors">Source sheets (29 [G0–G12])</a>
              <a href="/transcripts/" class="block font-body text-[12px] text-brand-cyan no-underline hover:text-brand-white transition-colors">Braille HTML transcripts (46)</a>
              <a href="/live/" class="block font-body text-[12px] text-emerald-300 no-underline hover:text-brand-cyan transition-colors">Research Live (Voice &amp; Video)</a>
              <a href="/syndication/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Syndication (X · Medium · TikTok)</a>
              <a href="/blueprint/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Planetary media blueprint v1.0</a>
              <a href="/tutorials/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Interactive tutorials</a>
              <a href="/constellation/" class="block font-body text-[12px] text-brand-cyan no-underline hover:text-brand-white transition-colors">Language Constellation (12,117)</a>
              <a href="/standards/" class="block font-body text-[12px] text-brand-amber no-underline hover:text-brand-white transition-colors">Clean-Room vs. Standards Bridge</a>
              <a href="/replication/" class="block font-body text-[12px] text-emerald-300 no-underline hover:text-brand-cyan transition-colors">External replication kits (9)</a>
              <a href="/about/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">About</a>
              <a href="/glossary/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Glossary</a>
              <a href="/faq/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">RCE FAQ</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">PDFs</div>
            <div class="space-y-2">
              {studies.map((s) => <a href={s.pdfPath} class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">{s.short_title}</a>)}
              <a href="/data/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Data and code</a>
              <a href="/changelog/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Changelog</a>
              <a href="/opportunity-map/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Opportunity map</a>
              <a href="/llms.txt" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">llms.txt</a>
              <a href="/llms-full.txt" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">llms-full.txt</a>
              <a href="/catalog.json" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">catalog.json</a>
              <a href="/feed.xml" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Atom feed</a>
              <a href="/radio/rss.xml" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Podcast RSS</a>
              <a href="/feeds/medium.xml" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Medium canonical RSS</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Family (*.openie.dev)</div>
            <div class="space-y-2">
              <a href="https://openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">OpenIE</a>
              <a href="https://blog.openie.dev" class="block font-body text-[12px] text-brand-amber no-underline hover:text-brand-white transition-colors">Chronicle (58 Entries)</a>
              <a href="https://blog.openie.dev/verification/" class="block font-body text-[12px] text-brand-cyan no-underline hover:text-brand-white transition-colors">Verification &amp; Errata</a>
              <a href="https://avalanche.openie.dev" class="block font-body text-[12px] text-brand-amber no-underline hover:text-brand-white transition-colors">Avalanche (9 Rungs)</a>
              <a href="https://stack.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Stack</a>
              <a href="https://compute.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Compute</a>
              <a href="https://synthesis.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Synthesis</a>
              <a href="https://knowledge.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Knowledge</a>
              <a href="https://database.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Database &amp; Data</a>
              <a href="https://state.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">State</a>
              <a href="https://communication.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Communication</a>
              <a href="https://memory.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Memory</a>
              <a href="https://agent.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Agent</a>
              <a href="https://proof.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Verify</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Contract</div>
            <div class="space-y-2">
              <span class="block font-body text-[12px] text-brand-slate">Signed Provenance · Self-Checked · measured_j ⊥ reported_j ⊥ est_j ⊥ unmetered. Physical DC shunt measured_j is filed in Metered Commit Gates (AMD Kria KV260 INA260), Satiation Benchmark Harness, The Communication Tool Avalanche, Downward LUT6 Compilation, From Ephemeral Inference to Compiled Agency (@ 6a22dee across KV260 INA260 + Jetson AGX Thor INA3221/INA238), and Planetary Research Media (@ a9de8d8 J/min shunt kit); all other studies set board_metered=false.</span>
              <span class="block font-body text-[12px] text-brand-slate">research.openie.dev</span>
            </div>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto mt-8 pt-6 border-t border-brand-border font-mono text-[10px] text-brand-gray">
        © Open Interface Engineering, Inc. Research, free to read, on how to use less energy.
      </div>
    </footer>

    <LiveCallDock />

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');
      const burgerTop = document.getElementById('burger-top');
      const burgerMid = document.getElementById('burger-mid');
      const burgerBot = document.getElementById('burger-bot');
      let menuOpen = false;

      btn?.addEventListener('click', () => {
        menuOpen = !menuOpen;
        btn.setAttribute('aria-expanded', String(menuOpen));
        navLinks?.classList.toggle('hidden', !menuOpen);
        navLinks?.classList.toggle('flex', menuOpen);
        if (burgerTop) burgerTop.style.transform = menuOpen ? 'translateY(4px) rotate(45deg)' : '';
        if (burgerMid) burgerMid.style.opacity = menuOpen ? '0' : '1';
        if (burgerBot) burgerBot.style.transform = menuOpen ? 'translateY(-4px) rotate(-45deg)' : '';
      });

      const exploreMenu = document.getElementById('nav-explore-menu') as HTMLDetailsElement | null;

      navLinks?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (exploreMenu) exploreMenu.open = false;
          if (menuOpen) {
            menuOpen = false;
            btn?.setAttribute('aria-expanded', 'false');
            navLinks.classList.add('hidden');
            navLinks.classList.remove('flex');
            if (burgerTop) burgerTop.style.transform = '';
            if (burgerMid) burgerMid.style.opacity = '1';
            if (burgerBot) burgerBot.style.transform = '';
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (exploreMenu?.open && e.target instanceof Node && !exploreMenu.contains(e.target)) {
          exploreMenu.open = false;
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (exploreMenu?.open) exploreMenu.open = false;
          if (menuOpen) btn?.click();
        }
      });

      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      // Global scroll-triggered editorial reveal & spotlight hover coordinates
      const revealEls = document.querySelectorAll('.editorial-reveal');
      if (revealEls.length > 0 && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      document.querySelectorAll('.spotlight-card').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const e = ev as PointerEvent;
          const rect = (card as HTMLElement).getBoundingClientRect();
          (card as HTMLElement).style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          (card as HTMLElement).style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        }, { passive: true });
      });
    </script>
    <style is:global>
      .nav-explore-panel {
        background: rgba(12, 15, 24, 0.94);
      }
      html[data-theme="light"] .nav-explore-panel {
        background: rgba(255, 255, 255, 0.96);
      }
      #nav-explore-menu[open] #nav-explore-caret {
        transform: rotate(180deg);
      }
    </style>
    <script>import '../scripts/lightbox.js';</script>
  </body>
</html>
