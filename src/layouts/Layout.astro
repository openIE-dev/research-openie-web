---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "OpenIE Research: research studies with downloadable PDFs and interactive figures. Draft status · board_synth_claimed=false.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F59E0B" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | OpenIE Research</title>

    <meta property="og:title" content={`${title} | OpenIE Research`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://research.openie.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | OpenIE Research`} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (function(){
        var stored = localStorage.getItem('oe-theme');
        var theme = stored && ['dark','light','auto'].indexOf(stored) !== -1 ? stored : 'auto';
        if (theme === 'auto') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col noise-overlay grid-bg">
    <nav id="nav" aria-label="Main navigation" class="nav-glass fixed top-0 left-0 right-0 z-100 px-6 md:px-10 py-4 md:py-5 flex justify-between items-center transition-all duration-400">
      <a href="/" aria-label="OpenIE Research home" class="font-display text-[22px] font-bold tracking-tight text-brand-white no-underline hover:no-underline">
        Open<span class="text-brand-cyan">IE</span> <span class="text-brand-amber">Research</span>
      </a>

      <button id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links" class="md:hidden flex flex-col gap-1.5 p-2 text-brand-slate cursor-pointer bg-transparent border-none">
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-top"></span>
        <span class="block w-5 h-0.5 bg-current transition-opacity" id="burger-mid"></span>
        <span class="block w-5 h-0.5 bg-current transition-transform" id="burger-bot"></span>
      </button>

      <div id="nav-links" class="hidden md:flex gap-4 items-center max-md:fixed max-md:inset-0 max-md:top-[60px] max-md:bg-brand-dark/95 max-md:backdrop-blur-xl max-md:flex-col max-md:justify-center max-md:gap-8 max-md:z-50">
        <a href="/#catalog" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Catalog</a>
        <a href="/about/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">About</a>
        <a href="/glossary/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Glossary</a>
        <a href="/papers/mol/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Mixture of Limits</a>
        <a href="/papers/ni/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Notational Intelligence</a>
        <a href="/papers/satiation/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Satiation</a>
        <a href="/papers/mei/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Metabolic Intelligence</a>
        <a href="/papers/jouleos/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">The Search for JouleOS</a>
        <a href="/papers/spellcheck/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-slate no-underline hover:text-brand-white transition-colors">Spell Check is Global</a>
        <a href="/living/" class="font-body text-[12px] max-md:text-lg font-medium text-brand-amber no-underline hover:text-brand-gold transition-colors">Figures</a>
        <a href="https://openie.dev" class="font-mono text-xs max-md:text-sm text-brand-cyan border border-brand-cyan/30 px-4 py-1.5 rounded-md no-underline hover:bg-brand-cyan/10 hover:border-brand-cyan transition-all">
          openie.dev
        </a>
        <div class="flex items-center gap-2 md:ml-2 md:pl-2 md:border-l md:border-brand-border">
          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main class="flex-1 pt-16 relative z-10">
      <slot />
    </main>

    <footer class="relative z-2 border-t border-brand-border px-6 md:px-10 py-10" role="contentinfo">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-8">
        <div>
          <div class="font-display text-sm text-brand-white mb-3">
            Open<span class="text-brand-cyan">IE</span> Research
          </div>
          <p class="font-body text-[12px] text-brand-gray max-w-[320px] leading-relaxed">
            Research studies hub for Open Interface Engineering, Inc.<br>
            Papers + PDFs · figures under /living · no paid services
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-12">
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Papers</div>
            <div class="space-y-2">
              <a href="/papers/mol/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Mixture of Limits</a>
              <a href="/papers/ni/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Notational Intelligence</a>
              <a href="/papers/satiation/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Satiation</a>
              <a href="/papers/mei/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Metabolic Intelligence</a>
              <a href="/papers/jouleos/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">The Search for JouleOS</a>
              <a href="/papers/spellcheck/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Spell Check is Global</a>
              <a href="/living/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Figures</a>
              <a href="/about/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">About</a>
              <a href="/glossary/" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Glossary</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">PDFs</div>
            <div class="space-y-2">
              <a href="/pdfs/mol.pdf" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Mixture of Limits</a>
              <a href="/pdfs/ni.pdf" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Notational Intelligence</a>
              <a href="/pdfs/satiation.pdf" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Satiation</a>
              <a href="/pdfs/mei.pdf" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Metabolic Intelligence</a>
              <a href="/pdfs/jouleos.pdf" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">The Search for JouleOS</a>
              <a href="/pdfs/spellcheck.pdf" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Spell Check is Global</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Family</div>
            <div class="space-y-2">
              <a href="https://openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">OpenIE</a>
              <a href="https://compute.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Compute</a>
              <a href="https://stack.openie.dev" class="block font-body text-[12px] text-brand-slate no-underline hover:text-brand-cyan transition-colors">Stack</a>
            </div>
          </div>
          <div>
            <div class="font-mono text-[10px] text-brand-gray tracking-[2px] uppercase mb-3">Contract</div>
            <div class="space-y-2">
              <span class="block font-body text-[12px] text-brand-slate">board_synth_claimed=false</span>
              <span class="block font-body text-[12px] text-brand-slate">research.openie.dev</span>
            </div>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto mt-8 pt-6 border-t border-brand-border font-mono text-[10px] text-brand-gray">
        © Open Interface Engineering, Inc. · Delaware B-Corp
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');
      const burgerTop = document.getElementById('burger-top');
      const burgerMid = document.getElementById('burger-mid');
      const burgerBot = document.getElementById('burger-bot');
      let menuOpen = false;

      btn?.addEventListener('click', () => {
        menuOpen = !menuOpen;
        btn.setAttribute('aria-expanded', String(menuOpen));
        navLinks?.classList.toggle('hidden', !menuOpen);
        navLinks?.classList.toggle('flex', menuOpen);
        if (burgerTop) burgerTop.style.transform = menuOpen ? 'translateY(4px) rotate(45deg)' : '';
        if (burgerMid) burgerMid.style.opacity = menuOpen ? '0' : '1';
        if (burgerBot) burgerBot.style.transform = menuOpen ? 'translateY(-4px) rotate(-45deg)' : '';
      });

      navLinks?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (menuOpen) {
            menuOpen = false;
            navLinks.classList.add('hidden');
            navLinks.classList.remove('flex');
            if (burgerTop) burgerTop.style.transform = '';
            if (burgerMid) burgerMid.style.opacity = '1';
            if (burgerBot) burgerBot.style.transform = '';
          }
        });
      });

      const nav = document.getElementById('nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 60);
      });
    </script>
  </body>
</html>
