      <a href="/living/game-engines/" class="inline-flex font-mono text-xs text-brand-cyan border border-brand-cyan/30 px-4 py-2.5 rounded-md no-underline hover:bg-brand-cyan/10 transition-colors">
        Interactive explorer &amp; playable arena → /living/game-engines/
      </a>
      <a href="/" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white transition-colors">
        ← Catalog
      </a>
    </div>
  </section>
</Layout>
