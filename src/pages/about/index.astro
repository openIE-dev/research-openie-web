---
import Layout from '../../layouts/Layout.astro';
import { studies } from '../../data/studyList';

const aboutPages = [
  ...studies.map((s) => ({ id: s.id, kind: s.kind, title: s.title, href: s.aboutPath, paper: s.path, deck: s.summary })),
  // Not in studies.json: this topic has an about page but is not listed in the catalog.
  {
      "id": "rce-jepa",
      "kind": "Research topic",
      "title": "RCE-JEPA: Autonomous Deterministic Coding using Latent Space",
      "href": "/about/rce-jepa/",
      "deck": "Can software be written autonomously by a learned model proposing programs in one closed, deterministic shape while a checker decides? Traces seventy years of specification-to-program attempts, why they stalled, current model-plus-verifier work, and the case for now, then tests it on the Reality Code Engine (RCE) with a Joint Embedding Predictive Architecture (JEPA) predictor in latent space, with hypotheses that could disprove it. Plain words: many have tried to make computers write programs from a description; a fixed shape plus a strict checker makes the job smaller; the AI proposes, the checker decides."
  }
];

---

<Layout
  title="About the papers"
  description="Index of OpenIE research about pages: what each paper claims and what it does not."
>
  <section class="px-6 md:px-10 pt-16 md:pt-24 pb-20 max-w-3xl mx-auto">
    <p class="section-label mb-4">research.openie.dev</p>
    <h1 class="text-3xl md:text-5xl font-bold text-brand-white tracking-tight">
      About the papers
    </h1>
    <p class="mt-6 font-body text-base text-brand-slate leading-relaxed">
      A short note for each paper on what it claims and what it does not. These pages list what already exists on this site.
      They do not invent studies. Shared terms live on the <a href="/glossary/" class="text-brand-cyan">glossary</a>.
    </p>

    <ul class="mt-10 space-y-4 list-none p-0 m-0">
      {aboutPages.map((p) => (
        <li class="glass-card p-5 md:p-6">
          <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-gray mb-2">{p.kind}</p>
          <h2 class="text-xl text-brand-white mb-2">{p.title}</h2>
          <p class="font-body text-sm text-brand-slate leading-relaxed mb-4">{p.deck}</p>
          <div class="flex flex-wrap gap-3">
            <a href={p.href} class="font-mono text-xs text-brand-amber no-underline hover:text-brand-gold">About note</a>
            {p.paper && <a href={p.paper} class="font-mono text-xs text-brand-cyan no-underline hover:text-brand-teal">Read paper</a>}
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white">Catalog</a>
      <a href="/glossary/" class="inline-flex font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10">Glossary</a>
    </div>
  </section>
</Layout>
