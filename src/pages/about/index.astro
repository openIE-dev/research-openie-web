---
import Layout from '../../layouts/Layout.astro';

const aboutPages = [
  {
    id: 'mol',
    title: 'Mixture of Limits',
    href: '/about/mol',
    paper: '/papers/mol/',
    deck: 'Navigation law for computer intelligence. Floors where more bits stop buying outcomes.',
  },
  {
    id: 'ni',
    title: 'Notational Intelligence as Commit Law',
    href: '/about/ni',
    paper: '/papers/ni/',
    deck: 'System One decides in software. WCA decides whether the machine is allowed to move.',
  },
  {
    id: 'satiation',
    title: 'Satiation and Scarcity after Free AI',
    href: '/about/satiation',
    paper: '/papers/satiation/',
    deck: 'Capability scales. Appetite does not. Design to done.',
  },
  {
    id: 'mei',
    title: 'Metabolic Intelligence',
    href: '/about/mei',
    paper: '/papers/mei/',
    deck: 'Energy binds. Metabolic Intelligence is the AI product class. Klere is hardware and the product home.',
  },
  {
    id: 'jouleos',
    title: 'The Search for JouleOS',
    href: '/about/jouleos',
    paper: '/papers/jouleos/',
    deck: 'Review and design guide. One law, one meter, and one refusal.',
  },
  {
    id: 'spellcheck',
    title: 'Spell Check is Global',
    href: '/about/spellcheck',
    paper: '/papers/spellcheck/',
    deck: 'Economic opinion. Global access for more than 7 billion people. Scarcity pricing for fewer than 500 million people.',
  },
];
---

<Layout
  title="About the studies"
  description="Index of OpenIE research about pages. Each entry links the about note and the readable paper. board_synth_claimed=false."
>
  <section class="px-6 md:px-10 pt-16 md:pt-24 pb-20 max-w-3xl mx-auto">
    <p class="section-label mb-4">research.openie.dev</p>
    <h1 class="text-3xl md:text-5xl font-bold text-brand-white tracking-tight">
      About the studies
    </h1>
    <p class="mt-6 font-body text-base text-brand-slate leading-relaxed">
      Short about notes for each catalog entry. These pages list what already exists on this site.
      They do not invent studies. Shared terms live on the <a href="/glossary/" class="text-brand-cyan">glossary</a>.
    </p>

    <ul class="mt-10 space-y-4 list-none p-0 m-0">
      {aboutPages.map((p) => (
        <li class="glass-card p-5 md:p-6">
          <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-gray mb-2">{p.id}</p>
          <h2 class="text-xl text-brand-white mb-2">{p.title}</h2>
          <p class="font-body text-sm text-brand-slate leading-relaxed mb-4">{p.deck}</p>
          <div class="flex flex-wrap gap-3">
            <a href={p.href} class="font-mono text-xs text-brand-amber no-underline hover:text-brand-gold">About note</a>
            <a href={p.paper} class="font-mono text-xs text-brand-cyan no-underline hover:text-brand-teal">Read paper</a>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white">Catalog</a>
      <a href="/glossary/" class="inline-flex font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10">Glossary</a>
    </div>
  </section>
</Layout>
