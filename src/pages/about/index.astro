---
import Layout from '../../layouts/Layout.astro';

const aboutPages = [
  {
    "id": "agency",
    "kind": "Research paper",
    "title": "Thermodynamic Bounds and an Optimal Tempo for Goal-Holding Agents",
    "href": "/about/agency/",
    "paper": "/papers/agency/",
    "deck": "The proposed Universal Law of Agency, stated as a definition plus a gate. Agency comes first: a prediction fixed before the act, coupling to the world through intervention, consequence borne, and a joule budget with refusal on a receipt. Kinematic bounds say how fast agency moves per second and per joule. Intelligence is the derivative of agency in joules, read in hindsight off a completed run. Prediction 1 gives an optimal act time for an agent that holds a goal, with a lab protocol to test it. Energy to run is the only true metric of computer intelligence."
  },
  {
    "id": "gates",
    "kind": "Research paper",
    "title": "Metered Commit Gates: Energy-to-Correct-Completion for Agentic Systems",
    "href": "/about/gates/",
    "paper": "/papers/gates/",
    "deck": "Notational Intelligence and Mixture of Limits in one systems paper. A proposal may not authorize itself: an irreversible act runs only behind a certificate, and every decision is written to a receipt. Mixture of Limits is the philosophy: use the cheapest gear that is sufficient, because past the floor additional tokens, parameters, or joules do not purchase verifiable progress. Lookup, then Formula, then Solver, then Model is one instance. Systems are ranked by the joules needed to reach a correct completion. A KV260 board reading gives 11,428 pJ per gate cycle at board level."
  },
  {
    "id": "satiation",
    "kind": "Economics companion paper",
    "title": "Task Satiation vs. Aggregate Rebound in AI Demand",
    "href": "/about/satiation/",
    "paper": "/papers/satiation/",
    "deck": "Task-level satiation holds by definition once a task completion predicate is true: more synthesis on that task buys nothing. Aggregate demand can still grow, because cheaper synthesis opens new tasks and raises total use. The paper separates the two, states hypotheses H1 (spend after completion) and H2 (Jevons in tasks), and gives the data design that would identify them. Capability scales. Appetite per task does not."
  },
  {
    "id": "rce",
    "kind": "Research paper",
    "title": "The Reality Code Engine: One Form, Many Fits, and the Low-Entropy Path to Autonomous Coding",
    "href": "/about/rce/",
    "paper": "/papers/rce/",
    "deck": "Engineering and theory. There are two paths to autonomous computer automation, told apart by energy and entropy. A program is a database functional state machine: one Form, P = (S, E, δ, D, λ), and many fits, grounded in Gurevich's Abstract State Machine theorem. The Reality Code Engine (RCE) retrieves, adapts and proves fits, cheapest gear first, as one Mixture of Limits instance. Correctness is the gate and joules are the ranking. Five generated targets give byte-identical traces, rewrites are proved in Z3 and the kernel in Kani. On held-out test splits with a frozen engine and 0 model calls it repairs 520,541 of 520,821 one-token faults (95% CI 0.9994 to 0.9995), 23,015 of 23,015 in repositories never tuned on, 38.6% of 24,072 ManySStuBs4J Java bugs and 17.4% of 157,089 TSSB-3M Python bugs; energy is est_j with a RAPL reported_j subsample, and measured_j is reserved for a wall meter."
  },
  {
    "id": "spellcheck",
    "kind": "History essay",
    "title": "Spell Check is Global: The Future of Computer Intelligence in the Hands of the Many (7B+), Not the Few",
    "href": "/about/spellcheck/",
    "paper": "/papers/spellcheck/",
    "deck": "People used to pay a premium for spell check. Now it is free and bundled into the editor, the browser, and the phone. A history of that path, from dated prices to the local library in every editor. Technology built for global access reaches more than 7 billion people. Scarcity pricing keeps a capability with the few who can pay. Energy to run is what remains."
  },
  {
    "id": "ai-coding-market",
    "kind": "Economics essay",
    "title": "The Promised Trillion Dollar AI-Coding Market",
    "href": "/about/ai-coding-market/",
    "paper": "/papers/ai-coding-market/",
    "deck": "The economics companion to the RCE research paper, where the theory and the economics meet. It sets out who projects the AI coding market and what they project: about $3 trillion a year in developer value, company-reported revenue and valuations, token volume, losses, capex and data-centre energy, each with its source and its label. Every projection assumes one path: high energy, high compute, per-token rent and the model in the loop forever. With correctness as the gate and joules as the ranking, RCE measured, on held-out test splits with 0 model calls, 520,541 of 520,821 one-token repairs and 38.6% of 24,072 real single-statement Java bugs, at hundredths of a reported joule per solved task, and 10 then 0 model calls in a soak. Where that path covers a task, its price falls toward the energy to run it, as Spell Check fell to a bundled zero price."
  },
  {
    "id": "mei",
    "kind": "Product white paper",
    "title": "Metabolic Intelligence: Budget-Native Compute from Tag to Campus",
    "href": "/products/mei/",
    "paper": "/products/mei/",
    "deck": "Metabolic Intelligence is the AI product. A fixed energy budget is the physical condition of the best answer. Work that would break the budget is refused or deferred. It spans coin-cell tags at the edge to a resource-optimized central datacenter and runs on any compute fabric. Klere (klere.ai) is the hardware that builds the Energy Processing Unit (EPU)."
  },
  {
    "id": "jouleos",
    "kind": "Product white paper (review and design guide)",
    "title": "The Search for JouleOS",
    "href": "/products/jouleos/",
    "paper": "/products/jouleos/",
    "deck": "A review of how secure compute is composed today and a design guide for what a machine must speak if an agent is to be scheduled, metered, and refused. It places the energy-as-resource operating systems that came before, names what they lack, and describes JouleOS: one intent stream lowered onto the coordinate the runtime measured."
  }
];
---

<Layout
  title="About the papers"
  description="Index of OpenIE research about pages. Three research papers, an economics companion paper, two essays, and two product white papers kept apart."
>
  <section class="px-6 md:px-10 pt-16 md:pt-24 pb-20 max-w-3xl mx-auto">
    <p class="section-label mb-4">research.openie.dev</p>
    <h1 class="text-3xl md:text-5xl font-bold text-brand-white tracking-tight">
      About the papers
    </h1>
    <p class="mt-6 font-body text-base text-brand-slate leading-relaxed">
      Short about notes for each research paper and the essay. The two product white papers carry their own notes. These pages list what already exists on this site.
      They do not invent studies. Shared terms live on the <a href="/glossary/" class="text-brand-cyan">glossary</a>.
    </p>

    <ul class="mt-10 space-y-4 list-none p-0 m-0">
      {aboutPages.map((p) => (
        <li class="glass-card p-5 md:p-6">
          <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-gray mb-2">{p.kind}</p>
          <h2 class="text-xl text-brand-white mb-2">{p.title}</h2>
          <p class="font-body text-sm text-brand-slate leading-relaxed mb-4">{p.deck}</p>
          <div class="flex flex-wrap gap-3">
            <a href={p.href} class="font-mono text-xs text-brand-amber no-underline hover:text-brand-gold">About note</a>
            <a href={p.paper} class="font-mono text-xs text-brand-cyan no-underline hover:text-brand-teal">Read paper</a>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white">Catalog</a>
      <a href="/glossary/" class="inline-flex font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10">Glossary</a>
    </div>
  </section>
</Layout>
