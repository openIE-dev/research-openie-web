---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import tvCatalog from '../../data/tv-catalog.json';

export function getStaticPaths() {
  const studies = (tvCatalog.studies || []) as any[];
  return studies.map((st) => ({
    params: { slug: st.id },
  }));
}

const { slug } = Astro.params;
const jsonPath = path.resolve(process.cwd(), 'public', 'sourcesheets', `${slug}.json`);
const sheet = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
const claims = (sheet.claims || []) as any[];
const gates = (sheet.gates || []) as any[];
const variants = (sheet.variants || []) as any[];
const easyRead = sheet.easy_read || {};
const scriptsMap = sheet.scripts || {};
---

<Layout
  title={`Source Sheet · ${sheet.short_title}`}
  description={`Checkable [G0–G12] source sheet, primary paper section claims, orthogonal J/min energy accounting, and Ed25519-signed variant manifest for ${sheet.title}.`}
>
  <article class="max-w-6xl mx-auto px-5 md:px-10 pt-10 pb-24 print:px-0 print:pt-2">
    <!-- Breadcrumb & Print/Download Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 print:hidden">
      <div class="font-mono text-xs text-brand-slate flex flex-wrap items-center gap-2">
        <a href="/sourcesheets/" class="text-brand-cyan no-underline hover:underline">← All 29 Source Sheets</a>
        <span>/</span>
        <span class="text-brand-white">{sheet.study_slug}</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={`/sourcesheets/${sheet.study_slug}.json`}
          download
          class="font-mono text-xs px-3.5 py-2 rounded-lg bg-brand-cyan text-brand-dark font-bold no-underline hover:opacity-90"
        >
          ⬇ Download Signed JSON (/sourcesheets/{sheet.study_slug}.json)
        </a>
        <a
          href={`/transcripts/${sheet.study_slug}/`}
          class="font-mono text-xs px-3 py-2 rounded-lg border border-brand-amber/45 text-brand-amber no-underline hover:bg-brand-amber/10"
        >
          Braille HTML Transcript →
        </a>
        <a
          href={`/tv/?study=${sheet.study_slug}`}
          class="font-mono text-xs px-3 py-2 rounded-lg border border-brand-border text-brand-light no-underline hover:border-brand-amber"
        >
          Watch in /tv/ →
        </a>
      </div>
    </div>

    <!-- Header Card -->
    <header class="glass-card p-6 md:p-8 mb-8 border-t-2 border-t-brand-amber">
      <div class="flex flex-wrap items-center gap-2 mb-3 font-mono text-[11px]">
        <span class="px-2.5 py-0.5 rounded bg-brand-amber/15 text-brand-amber border border-brand-amber/35">
          [G1 + G11] Checkable Source Sheet
        </span>
        <span class="px-2.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-400/35">
          {sheet.provenance_status} · review_status: {sheet.review_status}
        </span>
        <span class="px-2.5 py-0.5 rounded bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/35">
          Media: {sheet.licence} · Metadata: {sheet.metadata_licence}
        </span>
        <span class="px-2.5 py-0.5 rounded bg-white/5 text-brand-light border border-brand-border">
          Wikimedia Commons Ready: {String(sheet.wikimedia_commons_ready)}
        </span>
      </div>

      <h1 class="font-display text-2xl md:text-4xl font-bold text-brand-white leading-tight mb-3">
        {sheet.title}
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 font-mono text-xs text-brand-slate mt-4 pt-4 border-t border-brand-border">
        <div><strong class="text-brand-white">Primary Paper:</strong> <a href={sheet.paper_path} class="text-brand-amber hover:underline">{sheet.paper_url}</a></div>
        <div><strong class="text-brand-white">Canonical ID:</strong> <code class="text-brand-cyan">{sheet.openie_canonical_id}</code></div>
        <div><strong class="text-brand-white">Zenodo Concept DOI:</strong> <code class="text-brand-light">{sheet.zenodo_concept_doi}</code> (<code class="text-emerald-300">IsVariantFormOf</code>, <code class="text-emerald-300">IsTranslationOf</code>)</div>
        <div><strong class="text-brand-white">ORCID / Internet Archive:</strong> <code>{sheet.orcid}</code> · <code>{sheet.internet_archive_item}</code></div>
        <div class="md:col-span-2 break-all">
          <strong class="text-brand-white">Manifest BLAKE3-256:</strong> <code class="text-emerald-300">{sheet.manifest_signature.blake3_hex}</code>
        </div>
        <div class="md:col-span-2 break-all">
          <strong class="text-brand-white">Ed25519 Signature:</strong> <code class="text-brand-gray">{sheet.manifest_signature.ed25519_signature}</code>
        </div>
      </div>
    </header>

    <!-- [G0–G12] Gate Badges -->
    <section aria-labelledby="ss-gates" class="glass-card p-5 md:p-6 mb-8">
      <h2 id="ss-gates" class="font-display text-lg font-bold text-brand-white mb-3">
        [G0–G12] Automated Verification Gates (13 / 13 Passed)
      </h2>
      <div class="flex flex-wrap gap-2">
        {gates.map((g) => (
          <span
            title={g.check}
            class="font-mono text-[11px] px-2.5 py-1 rounded-md border border-emerald-400/35 bg-emerald-500/10 text-emerald-200"
          >
            ✓ [{g.gate}] {g.name}
          </span>
        ))}
      </div>
    </section>

    <!-- Structured Claim Table ([G0 / G1]) -->
    <section aria-labelledby="ss-claims" class="glass-card p-5 md:p-6 mb-8 overflow-x-auto">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 id="ss-claims" class="font-display text-xl font-bold text-brand-white m-0">
          Structured Claim-to-Paper Verification Table ([G0 / G1])
        </h2>
        <code class="font-mono text-xs text-emerald-300">{sheet.energy_accounting.orthogonality_invariant}</code>
      </div>

      <table class="w-full font-body text-xs border-collapse min-w-[680px]">
        <thead>
          <tr class="border-b border-brand-border text-left font-mono text-[11px] text-brand-gray">
            <th class="py-2 pr-3">Claim ID</th>
            <th class="py-2 pr-4">Spoken / Captioned Statement</th>
            <th class="py-2 pr-3">Primary Paper Section &amp; Figure</th>
            <th class="py-2 pr-3">Evidence Class</th>
            <th class="py-2">Artifact</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border/40">
          {claims.map((c) => (
            <tr class="align-top">
              <td class="py-3 pr-3 font-mono text-[11px] text-brand-amber font-semibold">{c.claim_id}</td>
              <td class="py-3 pr-4 text-brand-white leading-relaxed">{c.statement}</td>
              <td class="py-3 pr-3 text-brand-slate">
                <div class="font-semibold text-brand-light">{c.paper_section}</div>
                <div class="font-mono text-[10.5px] text-brand-gray mt-0.5">{c.figure_or_table}</div>
              </td>
              <td class="py-3 pr-3 font-mono text-[11px]">
                <span class="px-2 py-0.5 rounded bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/30">
                  {c.evidence_class}
                </span>
              </td>
              <td class="py-3 font-mono text-[11px]">
                <a
                  href={c.verification_artifact_url.replace('https://research.openie.dev', '') || '/'}
                  class="text-emerald-300 no-underline hover:underline"
                >
                  Verify →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- Energy Accounting + Script ISO 24495-1 & COGA Checksums -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <section aria-labelledby="ss-energy" class="glass-card p-5">
        <h2 id="ss-energy" class="font-display text-lg font-bold text-brand-white mb-2">
          Orthogonal Study &amp; Media J/min Accounting ([G6 / G10])
        </h2>
        <ul class="list-disc pl-5 space-y-2 font-body text-xs text-brand-slate leading-relaxed m-0">
          <li>
            <strong class="text-brand-white">Study Evidence Class:</strong>{' '}
            <code class="font-mono text-brand-amber">{sheet.energy_accounting.study_primary_evidence_class}</code> ({sheet.energy_accounting.study_energy_tier_label}) — {sheet.energy_accounting.study_energy_disclosure}
          </li>
          <li>
            <strong class="text-brand-white">Local Open-Weight Media Pipeline:</strong>{' '}
            <code class="font-mono text-emerald-300">{sheet.energy_accounting.media_local_pipeline_j_per_min} J/min</code> gross on Jetson AGX Thor TI INA3221 (<code class="font-mono">{sheet.energy_accounting.media_local_pipeline_kv260_net_j_per_min ?? 213.67} J/min</code> net on Kria KV260 TI INA260; <code class="font-mono">measured_j</code>) —{' '}
            <a href="https://github.com/openIE-dev/openie-research-experiments/tree/main/kits/planetary-media-joule" target="_blank" rel="noopener" class="text-brand-cyan no-underline hover:underline font-mono">
              kits/planetary-media-joule @ a9de8d8 ↗
            </a>
          </li>
          <li>
            <strong class="text-brand-white">Cloud Studio Narration:</strong>{' '}
            <code class="font-mono text-brand-cyan">{sheet.energy_accounting.studio_english_tts_energy_class}</code> (never summed with <code class="font-mono">measured_j</code> or <code class="font-mono">reported_j</code>).
          </li>
        </ul>
      </section>

      <section aria-labelledby="ss-easyread" class="glass-card p-5">
        <h2 id="ss-easyread" class="font-display text-lg font-bold text-brand-white mb-2">
          Easy Read + PBC-Safe Mulberry &amp; Tawasol AAC ([G3])
        </h2>
        <div class="flex flex-wrap gap-1.5 mb-3">
          {(easyRead.mulberry_symbols || []).map((sym: any) => (
            <span class="px-2 py-0.5 rounded-full border border-brand-cyan/35 bg-white/5 font-mono text-[10.5px] text-brand-white">
              <span aria-hidden="true">{sym.unicode}</span> {sym.symbol_id} ({sym.license})
            </span>
          ))}
          {(easyRead.tawasol_symbols || []).slice(0, 2).map((sym: any) => (
            <span class="px-2 py-0.5 rounded-full border border-brand-amber/35 bg-white/5 font-mono text-[10.5px] text-brand-amber">
              <span aria-hidden="true">{sym.unicode}</span> {sym.symbol_id}
            </span>
          ))}
        </div>
        <ol class="list-decimal pl-5 space-y-1 font-body text-xs text-brand-light leading-relaxed m-0">
          {(easyRead.three_points_one_idea_sentences || []).map((s: string) => (
            <li>{s}</li>
          ))}
        </ol>
      </section>
    </div>

    <!-- 4 Script Digests -->
    <section aria-labelledby="ss-scripts" class="glass-card p-5 md:p-6 mb-8">
      <h2 id="ss-scripts" class="font-display text-lg font-bold text-brand-white mb-3">
        Script Checksums, ISO 24495-1:2023 &amp; W3C COGA 8-Objective Verification ([G2])
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 font-mono text-xs">
        {['15s', '45s', '90s', '180s'].map((slot) => {
          const sc = scriptsMap[slot] || {};
          return (
            <div class="p-3 rounded-lg border border-brand-border bg-white/[0.02]">
              <div class="text-brand-amber font-bold mb-1">{slot} Depth Slot ({sc.word_count} words)</div>
              <div class="text-[10.5px] text-brand-slate mb-1">ISO 24495-1: PASS · COGA 8/8: PASS</div>
              <div class="text-[10px] text-brand-gray break-all">SHA-256: {(sc.sha256 || '').slice(0, 24)}…</div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Per-Variant Signed Manifest Table -->
    <section aria-labelledby="ss-variants" class="glass-card p-5 md:p-6 overflow-x-auto">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 id="ss-variants" class="font-display text-xl font-bold text-brand-white m-0">
          Signed Per-Variant Manifest Ledger ({variants.length} Variants · [G8 / G11])
        </h2>
        <span class="font-mono text-xs text-brand-gray">
          Every variant carries review_status: machine + numbers_exact: true + Ed25519 signature
        </span>
      </div>

      <table class="w-full font-mono text-[11px] border-collapse min-w-[780px]">
        <thead>
          <tr class="border-b border-brand-border text-left text-brand-gray">
            <th class="py-2 pr-3">Lang / Tier</th>
            <th class="py-2 pr-3">Slot &amp; Modality</th>
            <th class="py-2 pr-3">Voice / Verifier</th>
            <th class="py-2 pr-3">WER / LUFS</th>
            <th class="py-2 pr-3">J/min (Class)</th>
            <th class="py-2 pr-3">BLAKE3 &amp; Ed25519</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border/40">
          {variants.map((v) => (
            <tr>
              <td class="py-2 pr-3 text-brand-white font-semibold">
                {v.lang} <span class="text-brand-cyan">({v.tier})</span>
              </td>
              <td class="py-2 pr-3">
                <span class="text-brand-amber">{v.length}</span> ·{' '}
                <span class={v.modality === 'voiced' ? 'text-emerald-300' : 'text-brand-light'}>{v.modality}</span>
              </td>
              <td class="py-2 pr-3 text-brand-slate truncate max-w-[190px]">
                {v.voice_id || 'Text/VTT'} · {v.asr_verifier}
              </td>
              <td class="py-2 pr-3 text-brand-light">
                {v.wer !== null ? `WER ${(v.wer * 100).toFixed(1)}%` : 'Exact'} {v.lufs ? `· ${v.lufs} LUFS` : ''}
              </td>
              <td class="py-2 pr-3 text-brand-cyan">
                {v.j_per_min !== null ? `${v.j_per_min} J/m` : '—'} ({v.energy_class})
              </td>
              <td class="py-2 text-brand-gray">
                <code>{v.blake3_hex.slice(0, 12)}…</code> / <code>{v.ed25519_signature.slice(0, 12)}…</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</Layout>
