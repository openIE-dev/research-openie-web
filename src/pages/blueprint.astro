  <style is:global>
    .bp-mode-active {
      background: rgba(245, 158, 11, 0.2) !important;
      border-color: #f59e0b !important;
      color: #ffffff !important;
    }
    .bp-lang-active {
      background: rgba(0, 212, 170, 0.16) !important;
      border-color: #00d4aa !important;
    }
    .bp-lang-disabled {
      opacity: 0.42;
    }
  </style>

  <script is:inline define:vars={{ clientPayload }}>
  (function () {
    const DATA = JSON.parse(clientPayload);
    const ART_BY_SLUG = Object.fromEntries((DATA.artifacts || []).map((a) => [a.slug, a]));
    const STUDY_ASSETS = DATA.studyAssets || {};
    const LANG_BY_CODE = Object.fromEntries((DATA.langs || []).map((l) => [l.code, l]));
    const AD_BY_SLUG = {};
    (DATA.adTracks || []).forEach((a) => {
      if (a.study_slug) AD_BY_SLUG[a.study_slug] = a;
      if (a.tv_id) AD_BY_SLUG[a.tv_id] = a;
    });
    const ER_BY_ID = Object.fromEntries((DATA.tvEasyRead || []).map((e) => [e.id, e]));
    const RADIO_ER_BY_ID = Object.fromEntries((DATA.radioEasyRead || []).map((e) => [e.id, e]));
    const VAR_MAP = {};
    (DATA.variants || []).forEach((v) => {
      if (v.ship_allowed !== false) {
        VAR_MAP[v.study_slug + ':' + v.lang] = v;
        VAR_MAP[v.tv_id + ':' + v.lang] = v;
      }
    });

    let activeSlug = DATA.artifacts.find((a) => a.slug === 'from-ephemeral-inference-to-compiled-agency')?.slug || DATA.artifacts[0].slug;
    let activeSlot = '15s'; // '15s' | '90s'
    let activeLang = 'en';
    let activeMode = 'multilingual'; // 'multilingual' | 'easyread' | 'ad' | 'admix' | 'cues'
    let selectedRadioErId = '';

    const studySelectEl = document.getElementById('bp-study-select');
    const slot15Btn = document.getElementById('bp-slot-15s');
    const slot90Btn = document.getElementById('bp-slot-90s');
    const videoEl = document.getElementById('bp-video');
    const trackEl = document.getElementById('bp-vtt-track');
    const audioEl = document.getElementById('bp-audio');
    const audioLabelEl = document.getElementById('bp-audio-label');
    const modalityPillEl = document.getElementById('bp-modality-pill');
    const dlM4aEl = document.getElementById('bp-download-m4a');
    const dlVttEl = document.getElementById('bp-download-vtt');
    const titleEl = document.getElementById('bp-active-title');
    const langBadgeEl = document.getElementById('bp-lang-badge');
    const bulletsWrapEl = document.getElementById('bp-bullets-wrap');
    const bulletsListEl = document.getElementById('bp-bullets-list');
    const erPanelEl = document.getElementById('bp-easyread-panel');
    const radioErSelect = document.getElementById('bp-radio-er-select');
    const erSymbolsEl = document.getElementById('bp-er-symbols');
    const erSentencesEl = document.getElementById('bp-er-sentences');
    const adPanelEl = document.getElementById('bp-ad-panel');
    const adHeadingEl = document.getElementById('bp-ad-heading');
    const adOverviewEl = document.getElementById('bp-ad-overview');
    const adCuesEl = document.getElementById('bp-ad-cues');
    const linkPaperEl = document.getElementById('bp-link-paper');
    const linkSsEl = document.getElementById('bp-link-sourcesheet');
    const linkBrEl = document.getElementById('bp-link-braille');
    const linkTvEl = document.getElementById('bp-link-tv');

    function esc(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function render(autoplay) {
      const art = ART_BY_SLUG[activeSlug] || DATA.artifacts[0];
      const tvId = art.tv_id || art.slug;
      const sa = STUDY_ASSETS[tvId] || {};
      const lg = LANG_BY_CODE[activeLang] || LANG_BY_CODE.en;
      const v = VAR_MAP[art.slug + ':' + activeLang] || VAR_MAP[tvId + ':' + activeLang] || VAR_MAP[art.slug + ':en'] || DATA.variants[0];
      const ad = AD_BY_SLUG[art.slug] || AD_BY_SLUG[tvId];
      const er = selectedRadioErId ? RADIO_ER_BY_ID[selectedRadioErId] : ER_BY_ID[tvId];

      if (studySelectEl && studySelectEl.value !== art.slug) studySelectEl.value = art.slug;
      if (slot15Btn && slot90Btn) {
        slot15Btn.className = activeSlot === '15s'
          ? 'px-2.5 py-1.5 bg-brand-amber text-brand-dark font-bold cursor-pointer border-none'
          : 'px-2.5 py-1.5 bg-transparent text-brand-light cursor-pointer border-none';
        slot90Btn.className = activeSlot === '90s'
          ? 'px-2.5 py-1.5 bg-brand-amber text-brand-dark font-bold cursor-pointer border-none'
          : 'px-2.5 py-1.5 bg-transparent text-brand-light cursor-pointer border-none';
      }

      document.querySelectorAll('[data-bp-lang]').forEach((b) => {
        const code = b.getAttribute('data-bp-lang');
        const has15 = Boolean(VAR_MAP[art.slug + ':' + code] || (sa.planetary_15s_audio && sa.planetary_15s_audio[code]));
        const has90 = Boolean(code === 'en' || (sa.planetary_90s_audio && sa.planetary_90s_audio[code]));
        const avail = activeSlot === '90s' ? has90 : has15;
        b.classList.toggle('bp-lang-active', code === activeLang);
        b.classList.toggle('bp-lang-disabled', !avail);
        b.setAttribute('aria-pressed', String(code === activeLang));
      });

      [
        ['bp-mode-multilingual', 'multilingual'],
        ['bp-mode-easyread', 'easyread'],
        ['bp-mode-ad', 'ad'],
        ['bp-mode-admix', 'admix'],
        ['bp-mode-cues', 'cues'],
      ].forEach(([id, m]) => {
        const el = document.getElementById(id);
        if (el) {
          el.classList.toggle('bp-mode-active', activeMode === m);
          el.setAttribute('aria-pressed', String(activeMode === m));
        }
      });

      const targetVideo = activeSlot === '90s'
        ? ('/media/tv/films/' + tvId + '-90s.mp4')
        : art.modality_variants.tv_15s_video_url;
      if (videoEl && videoEl.getAttribute('src') !== targetVideo) {
        videoEl.pause();
        videoEl.setAttribute('poster', art.modality_variants.poster_url);
        videoEl.setAttribute('src', targetVideo);
        videoEl.load();
      }

      const useAd = activeMode === 'ad';
      const useAdMix = activeMode === 'admix';
      let targetAudio = v ? v.audio_url : '';
      let targetVtt = v ? v.vtt_url : '';
      let modality = 'voiced';

      if (useAdMix) {
        targetAudio = sa.ad_mix_m4a_url || (ad && ad.ad_audio_url) || ('/media/tv/accessibility/' + tvId + '-15s.ad.m4a');
        targetVtt = (ad && ad.ad_vtt_url) || ('/media/tv/accessibility/' + tvId + '-15s.ad.vtt');
      } else if (useAd) {
        targetAudio = (ad && ad.ad_audio_url) || ('/media/tv/accessibility/' + tvId + '-15s.ad.m4a');
        targetVtt = (ad && ad.ad_vtt_url) || ('/media/tv/accessibility/' + tvId + '-15s.ad.vtt');
      } else if (activeSlot === '90s') {
        targetAudio = (sa.planetary_90s_audio && sa.planetary_90s_audio[activeLang]) || ('/media/tv/films/' + tvId + '-90s.mp4');
        targetVtt = (sa.planetary_90s_vtt && sa.planetary_90s_vtt[activeLang]) || ('/media/tv/captions/' + tvId + '-90s.vtt');
        modality = (activeLang === 'en' || (sa.planetary_90s_audio && sa.planetary_90s_audio[activeLang])) ? 'voiced' : 'captioned';
      } else {
        targetAudio = (sa.planetary_15s_audio && sa.planetary_15s_audio[activeLang]) || (v && v.audio_url) || art.modality_variants.tv_15s_video_url;
        targetVtt = (sa.planetary_15s_vtt && sa.planetary_15s_vtt[activeLang]) || (v && v.vtt_url) || ('/media/tv/captions/' + tvId + '-15s.vtt');
        const hasAudioDisk = activeLang === 'en' || Boolean(sa.planetary_15s_audio && sa.planetary_15s_audio[activeLang]);
        modality = hasAudioDisk ? 'voiced' : 'captioned';
      }

      if (modalityPillEl) modalityPillEl.textContent = 'modality: ' + modality;
      if (trackEl && targetVtt) {
        trackEl.setAttribute('srclang', (useAd || useAdMix) ? 'en' : activeLang);
        trackEl.setAttribute('src', targetVtt);
      }
      if (audioEl && targetAudio && audioEl.getAttribute('src') !== targetAudio) {
        audioEl.pause();
        audioEl.setAttribute('src', targetAudio);
        audioEl.load();
      }
      if (dlM4aEl && targetAudio) dlM4aEl.setAttribute('href', targetAudio);
      if (dlVttEl && targetVtt) dlVttEl.setAttribute('href', targetVtt);

      if (audioLabelEl) {
        audioLabelEl.textContent = useAdMix
          ? ('🎧 Voiced AD Broadcast Mix · ' + art.short_title + ' (-16 LUFS)')
          : useAd
          ? ('🎧 Extended Audio Description · ' + art.short_title + ' (.ad.m4a)')
          : ('▶ ' + activeSlot + ' ' + (modality === 'voiced' ? 'Voiced' : 'Captioned') + ' · ' + (lg ? lg.name : activeLang) + ' (review_status: machine)');
      }

      const dir = (lg && lg.dir) || (v && v.dir) || 'ltr';
      if (titleEl) titleEl.textContent = art.title;
      if (langBadgeEl) langBadgeEl.textContent = activeLang + ' · ' + ((lg && lg.tier) || 'T0') + ' · ' + dir.toUpperCase();
      if (bulletsWrapEl) {
        bulletsWrapEl.setAttribute('dir', dir);
        bulletsWrapEl.setAttribute('lang', activeLang);
      }
      if (bulletsListEl && v && v.bullets) {
        bulletsListEl.innerHTML = v.bullets.map((b) => '<li>' + esc(b) + '</li>').join('');
      }

      if (erPanelEl) {
        erPanelEl.classList.toggle('hidden', activeMode !== 'easyread');
        if (er && erSymbolsEl && erSentencesEl) {
          const syms = [...(er.mulberry_symbols || []), ...(er.tawasol_symbols || []).slice(0, 2)];
          erSymbolsEl.innerHTML = syms.map((t) =>
            '<span class="px-2 py-0.5 rounded-full border border-brand-cyan/35 bg-white/5 font-mono text-[10.5px] text-brand-white">' +
            '<span aria-hidden="true">' + esc(t.unicode) + '</span> ' + esc(t.core_word) + ' · ' + esc(t.symbol_id) + '</span>'
          ).join('');
          erSentencesEl.innerHTML = (er.one_idea_sentences || []).map((s) => '<li>' + esc(s) + '</li>').join('');
        }
      }

      if (adPanelEl) {
        const showAdBox = useAd || useAdMix || activeMode === 'cues';
        adPanelEl.classList.toggle('hidden', !showAdBox);
        if (activeMode === 'cues') {
          const tvEr = ER_BY_ID[tvId];
          if (adHeadingEl) adHeadingEl.textContent = 'Accessible Cues (Surrey Deleanu 2025 + NJIT/NYU Ranked [sound] Cues)';
          if (adOverviewEl) adOverviewEl.textContent = 'Priority 1 Essential · Priority 2 Contextual · Priority 3 Ambient';
          if (adCuesEl && tvEr) {
            adCuesEl.innerHTML = (tvEr.ranked_sound_cues || []).map((sc) =>
              '<div class="p-2.5 rounded border border-brand-border bg-[#0b1020] font-mono text-xs">' +
              '<span class="text-brand-amber font-bold">[P' + sc.priority + ' · ' + esc(sc.rank_label) + ']</span> ' +
              '<span class="text-brand-light">' + esc(sc.cue) + '</span></div>'
            ).join('');
          }
        } else if (ad && adOverviewEl && adCuesEl) {
          if (adHeadingEl) adHeadingEl.textContent = useAdMix ? 'Voiced AD Broadcast Mix (.ad-mix.m4a)' : 'Extended Audio Description (.ad.m4a)';
          adOverviewEl.textContent = ad.visual_overview;
          adCuesEl.innerHTML = (ad.cues || []).map((c, idx) =>
            '<div class="p-2.5 rounded border border-brand-border bg-[#0b1020] text-xs">' +
            '<div class="font-mono text-[10px] text-emerald-300 mb-0.5">Scene ' + (idx + 1) + '</div>' +
            '<div class="text-brand-light mb-1">' + esc(c.visual) + '</div>' +
            '<div class="text-brand-amber font-mono text-[11px]">' + esc(c.takeaway) + '</div></div>'
          ).join('');
        }
      }

      if (linkPaperEl) linkPaperEl.setAttribute('href', art.modality_variants.paper_url);
      if (linkSsEl) linkSsEl.setAttribute('href', '/sourcesheets/' + tvId + '/');
      if (linkBrEl) linkBrEl.setAttribute('href', '/transcripts/' + tvId + '/');
      if (linkTvEl) linkTvEl.setAttribute('href', '/tv/?study=' + encodeURIComponent(tvId) + '&tier=' + activeSlot);

      if (autoplay && audioEl) {
        if (videoEl) { videoEl.currentTime = 0; videoEl.play().catch(() => {}); }
        audioEl.currentTime = 0;
        audioEl.play().catch(() => {});
      }
    }

    studySelectEl?.addEventListener('change', () => { activeSlug = studySelectEl.value; render(false); });
    slot15Btn?.addEventListener('click', () => { activeSlot = '15s'; render(false); });
    slot90Btn?.addEventListener('click', () => { activeSlot = '90s'; render(false); });
    radioErSelect?.addEventListener('change', () => { selectedRadioErId = radioErSelect.value || ''; render(false); });

    document.querySelectorAll('[data-bp-lang]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeLang = btn.getAttribute('data-bp-lang') || 'en';
        if (activeMode === 'ad' || activeMode === 'admix') activeMode = 'multilingual';
        render(true);
      });
    });

    document.getElementById('bp-mode-multilingual')?.addEventListener('click', () => { activeMode = 'multilingual'; render(false); });
    document.getElementById('bp-mode-easyread')?.addEventListener('click', () => { activeMode = 'easyread'; render(false); });
    document.getElementById('bp-mode-ad')?.addEventListener('click', () => { activeMode = 'ad'; render(true); });
    document.getElementById('bp-mode-admix')?.addEventListener('click', () => { activeMode = 'admix'; render(true); });
    document.getElementById('bp-mode-cues')?.addEventListener('click', () => { activeMode = 'cues'; render(false); });

    // Live [G0-G12] Source-Sheet Inspector Fetcher
    const ssSelect = document.getElementById('ss-inspector-select');
    const ssPre = document.getElementById('ss-inspector-pre');
    const ssPage = document.getElementById('ss-inspector-page');
    const ssJson = document.getElementById('ss-inspector-json');
    ssSelect?.addEventListener('change', async () => {
      const slug = ssSelect.value;
      if (ssPage) ssPage.setAttribute('href', '/sourcesheets/' + slug + '/');
      if (ssJson) ssJson.setAttribute('href', '/sourcesheets/' + slug + '.json');
      try {
        const res = await fetch('/sourcesheets/' + slug + '.json');
        if (res.ok && ssPre) {
          const doc = await res.json();
          ssPre.textContent = JSON.stringify(
            {
              study_slug: doc.study_slug,
              provenance_status: doc.provenance_status,
              licence_layers: doc.licence_layers,
              zenodo_relations: doc.zenodo_relations,
              claims: doc.claims,
              variants_sample: (doc.variants || []).slice(0, 4),
              manifest_signature: doc.manifest_signature,
            },
            null,
            2
          );
        }
      } catch (_) {}
    });

    render(false);
  })();
  </script>
</Layout>
