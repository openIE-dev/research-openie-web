---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import unsiloeing from '../data/planetary-unsiloeing.json';
import coverageSummary from '../data/coverage-summary.json';
import planetaryEasyRead from '../data/planetary-easy-read.json';
import sourcesheetsIndex from '../data/sourcesheets-index.json';
import conceptsDoc from '../../public/glossary/concepts.json';

const SITE = 'https://research.openie.dev';
const C: any = coverageSummary;
const T: any = C.totals || {};
const toolStages = (C.tool_energy_j_per_min?.stages || []) as any[];
const covLangs = (C.languages || []) as any[];
const t0Langs = covLangs.filter((l) => l.tier === 'T0');
const t1Langs = covLangs.filter((l) => l.tier === 'T1');
const t2Langs = covLangs.filter((l) => l.tier === 'T2');
const signLangs = covLangs.filter((l) => l.tier === 'Sign');

const artifacts = (unsiloeing.canonical_artifacts || []) as any[];
const variants = (unsiloeing.variants || []) as any[];
const adTracks = (unsiloeing.audio_descriptions || []) as any[];
const tvEasyRead = (planetaryEasyRead.tv_studies || []) as any[];
const radioEasyRead = (planetaryEasyRead.radio_episodes || []) as any[];
const aacConcepts = ((conceptsDoc.hasDefinedTerm || []) as any[]).slice(0, 9);
const sheetIndexList = (sourcesheetsIndex.studies || []) as any[];
const gatesDef = (sourcesheetsIndex.gates_definition || []) as any[];

const initialArt =
  artifacts.find((a) => a.slug === 'from-ephemeral-inference-to-compiled-agency') ??
  artifacts.find((a) => a.slug === 'ecosystem-avalanche') ??
  artifacts[0];
const initialVar =
  variants.find((v) => (v.study_slug === initialArt.slug || v.tv_id === initialArt.tv_id) && v.lang === 'en') ??
  variants[0];

// Load compact sample source sheet JSON for initial server-rendered [G0-G12] inspector
const initSheetPath = path.resolve(process.cwd(), 'public', 'sourcesheets', `${initialArt.tv_id}.json`);
const initSheetJson = fs.existsSync(initSheetPath)
  ? JSON.parse(fs.readFileSync(initSheetPath, 'utf8'))
  : { study_slug: initialArt.tv_id };

const orgLandscape = [
  {
    org: '1. Kurzgesagt – In a Nutshell',
    model: 'Philanthropy + multi-channel audio + checkable source sheets',
    verified: '€2.97M Open Philanthropy grant (Mar 2022) + Gates Foundation grants. Correction: exited ARD/ZDF funk network in Sept 2017 for international editorial independence; pioneers public source-sheet links across YouTube & TikTok captions.',
    adopted: 'Public [G1] source sheets (/sourcesheets/<slug>/) linked in every study card and all 29 TikTok captions.',
  },
  {
    org: '2. ScienceCast',
    model: 'Automated preprint audio/video casts + repository community tabs',
    verified: 'arXiv integration (Apr 2025) following bioRxiv rollout (Nov 2023); demonstrates lightweight author/machine media briefs wired into arXivLabs.',
    adopted: 'Deterministic 15s/45s/90s/180s telescoping slots + arXivLabs-compatible JSON-LD & DOI metadata.',
  },
  {
    org: '3. ResearchPod',
    model: 'Editorial outreach podcasts + Crossref DOIs',
    verified: 'Generation-time correction: relies on multi-week human scriptwriting and studio editorial turnaround (not instant sub-minute machine synthesis), minting persistent outreach DOIs.',
    adopted: 'Sub-minute [G0–G12] automated generation paired with Zenodo variant DOIs and explicit review_status: machine disclosure.',
  },
  {
    org: '4. PubCasts / ResearchEquals',
    model: 'Modular research publishing (Liberate Science)',
    verified: 'Treats audio/video casts and intermediate artifacts as first-class citable modules linked via Crossref/DataCite IsVariantFormOf and IsTranslationOf relations.',
    adopted: 'Per-variant BLAKE3 + Ed25519 manifests carrying Zenodo IsVariantFormOf and IsTranslationOf links.',
  },
  {
    org: '5. JoVE (Journal of Visualized Experiments)',
    model: 'Peer-reviewed laboratory method videos',
    verified: 'Gold standard for visual experimental reproducibility, gated behind institutional subscriptions rather than open reuse.',
    adopted: 'CC-BY-4.0 open media + 1-command Apache-2.0 hardware replication kits and interactive /living/ observatories.',
  },
  {
    org: '6. Latest Thinking (lt.org)',
    model: 'Standardized chaptered CC-BY researcher video abstracts',
    verified: 'Fixed 5-chapter scholarly structure under CC-BY licensing without multi-language or cognitive-accessibility layers.',
    adopted: 'Fixed 3-point plain-language opener at every duration before deeper methods and limits.',
  },
  {
    org: '7. Wonder Science',
    model: 'Visual science streaming app',
    verified: 'Mar 2024 App Store removal note highlights how single-vendor app stores can make public science media vanish overnight.',
    adopted: 'Owned web + 31-lang RSS + Opus + Internet Archive + Wikimedia Commons (CC-BY-4.0) multi-home resilience.',
  },
  {
    org: '8. CDCI, University of Vermont',
    model: 'Academic Easy Read science summaries',
    verified: 'Co-designs plain-language and Easy Read research translations with self-advocates with intellectual and developmental disabilities.',
    adopted: '1-idea-per-sentence Easy Read across all 29 TV studies and all 17 Radio episodes + 90-day co-design protocol.',
  },
  {
    org: '9. Bridge Multimedia',
    model: 'STEM Voiced Audio Description (extended & inline mixed)',
    verified: 'Federal/WCAG benchmark for narrating visual geometry, axes, and state transitions for blind and low-vision learners.',
    adopted: '29/29 Extended AD (.ad.m4a + .ad.vtt) plus toggleable Voiced AD Broadcast Mix (.ad-mix.m4a).',
  },
  {
    org: '10. Univ. of Surrey (Deleanu et al., 2025)',
    model: 'User-toggleable Accessible Cues track',
    verified: 'Demonstrates concise, learner-controlled multimodal Accessible Cues that prevent sensory and cognitive overload.',
    adopted: 'Toggleable Accessible Cues track on /tv/, /radio/, and /blueprint/ paired with clean zero-music-bed speech.',
  },
  {
    org: '11. EU MOSAIC Project',
    model: 'Multilingual audiovisual accessibility under EU rules',
    verified: '8-language EAA nuance: Directive (EU) 2019/882 + EN 301 549 V4.1.1 mandates accessible audiovisual services while recognizing human quality & burden nuances across 8 EU pilot languages.',
    adopted: 'EN 301 549 V4.1.1 alignment across T0/T1/T2 tiers with explicit machine vs community-reviewed status.',
  },
  {
    org: '12. ACL AAC Peer Support Network (OHSU)',
    model: 'National peer-led AAC co-design network',
    verified: '$2.325M 5-year Administration for Community Living grant to Oregon Health & Science University (announced 17 Nov 2026).',
    adopted: '38 SKOS/JSON-LD AAC concepts (/glossary/concepts.json v1.1.0) using PBC-safe Mulberry + Tawasol (CC BY-SA 4.0) symbols.',
  },
  {
    org: '13. Sense International + NJIT/NYU + KOBACO',
    model: 'Deafblind Braille HTML, ranked [sound] cues & broadcast AD',
    verified: 'Sense International 7-lang Deafblindness Hub (linear HTML), NJIT+NYU NSF HCC importance-ranked non-speech [sound] cues, and KOBACO (Nov 2025) AI broadcast AD benchmarks.',
    adopted: '46 zero-table Braille HTML transcripts (/transcripts/) + Priority 1–3 [sound] cues + -16 LUFS broadcast loudness.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: C.blueprint_edition,
  datePublished: '2026-11-26',
  dateModified: '2026-11-26',
  version: '1.0.0',
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  url: `${SITE}/blueprint/`,
  publisher: {
    '@type': 'Organization',
    name: 'Open Interface Engineering, Inc.',
    url: 'https://openie.dev',
  },
};

const clientPayload = JSON.stringify({
  artifacts,
  studyAssets: C.study_assets || {},
  langs: covLangs,
  variants,
  adTracks,
  tvEasyRead,
  radioEasyRead,
  sheetIndex: sheetIndexList,
});
---

<Layout
  title="Planetary Research Media: A Blueprint for OpenIE Research (26 Nov 2026 · v1.0)"
  description={`Planetary Research Media Blueprint v1.0: ${C.studies_count} studies (${C.horizontal_films_count} horizontal + ${C.vertical_films_count} vertical = ${C.total_films_count} films), ${C.radio_episodes_count} Radio episodes, [G0–G12] source sheets, Mulberry/Tawasol (CC BY-SA 4.0) AAC, 46 Braille HTML transcripts, and orthogonal J/min accounting.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-5 md:px-10 pt-10 pb-24">
    <!-- Hero Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="section-label">Canonical Blueprint · 26 Nov 2026 · v1.0</span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-emerald-500/15 text-emerald-300 border border-emerald-400/35">
          Signed Provenance · Self-Checked (review_status: machine)
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-amber/15 text-brand-amber border border-brand-amber/35">
          Media: CC-BY-4.0 · Data: CC0-1.0 · AAC: Mulberry + Tawasol (CC BY-SA 4.0)
        </span>
        <a href="/coverage.json" class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/35 no-underline hover:bg-brand-cyan/25">
          Live /coverage.json ↗
        </a>
      </div>

      <h1 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-brand-white leading-tight mb-3">
        Planetary Research Media: A Blueprint for Open<span class="text-brand-cyan">IE</span> Research
      </h1>
      <p class="font-display text-lg md:text-2xl text-brand-amber mb-4">
        26 Nov 2026 · Edition v1.0 · Deterministic [G0–G12] Gates, Orthogonal J/min Accounting &amp; Co-Design Accessibility
      </p>
      <p class="font-body text-base text-brand-slate max-w-4xl leading-relaxed mb-6">
        Every metric on this page derives directly from machine-checked disk state in <a href="/coverage.json" class="text-brand-cyan font-mono">/coverage.json</a>: <strong>{C.studies_count} studies</strong> ({C.horizontal_films_count} horizontal + {C.vertical_films_count} vertical = <strong>{C.total_films_count} films</strong>), <strong>{C.radio_episodes_count} Research Radio episodes</strong>, <strong>{T.voiced_15s_languages_count} voiced</strong> vs. <strong>{T.captioned_15s_languages_count} captioned</strong> languages across <strong>{C.spoken_selector_codes_count} selector codes</strong> (+ <strong>{C.sign_language_slots_count} human Deaf signer slots</strong> marked <code class="font-mono text-brand-amber">co_design_pending</code>), <strong>{T.sourcesheets_count} [G0–G12] checkable source sheets</strong>, and <strong>{T.braille_html_transcripts_count} zero-table Braille HTML transcripts</strong>.
      </p>

      <!-- Live Coverage KPI Strip (100% Derived from coverage-summary.json) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Catalog Films</div>
          <div class="font-display text-2xl font-bold text-brand-amber mt-1">{C.total_films_count}</div>
          <div class="font-mono text-[11px] text-brand-slate">{C.horizontal_films_count} 16:9 + {C.vertical_films_count} 9:16 ({C.studies_count} topics)</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Voiced vs Captioned</div>
          <div class="font-display text-2xl font-bold text-brand-cyan mt-1">{T.voiced_15s_languages_count}v / {T.captioned_15s_languages_count}c</div>
          <div class="font-mono text-[11px] text-brand-slate">{C.spoken_selector_codes_count} Selector + {C.sign_language_slots_count} Sign Slots</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">90s + Radio RSS</div>
          <div class="font-display text-2xl font-bold text-emerald-300 mt-1">{T.voiced_90s_languages_count} / {T.radio_rss_feeds_on_disk_count}</div>
          <div class="font-mono text-[11px] text-brand-slate">Target: 31 T0+T1 Voiced &amp; RSS</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">[G0–G12] Sheets</div>
          <div class="font-display text-2xl font-bold text-brand-white mt-1">{T.sourcesheets_count}/{C.studies_count}</div>
          <div class="font-mono text-[11px] text-brand-slate">Ed25519 + Zenodo Relations</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">AAC &amp; Braille HTML</div>
          <div class="font-display text-2xl font-bold text-brand-amber mt-1">{T.aac_concepts_count} · {T.braille_html_transcripts_count}</div>
          <div class="font-mono text-[11px] text-brand-slate">Mulberry + Tawasol CC BY-SA</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Review Status</div>
          <div class="font-display text-xl font-bold text-emerald-300 mt-1">machine</div>
          <div class="font-mono text-[11px] text-brand-slate">Signed · Self-Checked</div>
        </div>
      </div>

      <!-- Section Jump Navigation (§0–§9) -->
      <nav aria-label="Blueprint v1.0 sections" class="mt-6 flex flex-wrap gap-2">
        <a href="#planetary-player" class="font-mono text-xs px-3 py-1.5 rounded-md bg-brand-amber text-brand-dark font-semibold no-underline">Theater (15s/90s · AD Mix · Easy Read)</a>
        <a href="#sec-0-position" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">§0 Position</a>
        <a href="#sec-1-state" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">§1 Live State</a>
        <a href="#sec-2-landscape" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">§2 13-Org Landscape</a>
        <a href="#sec-3-aac" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">§3 AAC &amp; COGA</a>
        <a href="#sec-4-pipeline" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">§4 T0/T1/T2/Sign</a>
        <a href="#sec-5-energy" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">§5 J/min Shunts</a>
        <a href="#sec-6-channels" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">§6 Channels</a>
        <a href="#g0-g12-inspector" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-emerald-400/45 text-emerald-300 bg-emerald-500/10 no-underline">§7 [G0–G12] Inspector</a>
        <a href="#sec-8-proprietary" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">§8 Open vs PBC</a>
        <a href="#sec-9-scorecard" class="font-mono text-xs px-2.5 py-1.5 rounded-md border border-brand-amber/45 text-brand-amber bg-brand-amber/10 no-underline">§9 90-Day Scorecard</a>
      </nav>
    </header>

    <!-- INTERACTIVE TOP THEATER: T0/T1/T2/SIGN + 15S/90S + EASY READ (29 TV + 17 RADIO) + VOICED AD MIX + ACCESSIBLE CUES -->
    <section id="planetary-player" class="scroll-mt-24 glass-card p-5 md:p-7 mb-12 border-t-2 border-t-brand-amber">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 mb-5 border-b border-brand-border">
        <div>
          <div class="font-mono text-[11px] uppercase tracking-wider text-brand-amber mb-1">
            Interactive Reference Theater · {T.voiced_15s_languages_count} Voiced / {C.spoken_selector_codes_count} Selector Codes + {C.sign_language_slots_count} Sign (co_design_pending)
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-white m-0">
            31-Target Voiced / 50-Code Caption / Easy Read / Voiced AD Mix Player
          </h2>
        </div>

        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Projection mode switcher">
          <button id="bp-mode-multilingual" type="button" aria-pressed="true" class="bp-mode-btn bp-mode-active font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-amber text-brand-white cursor-pointer">
            🌐 Voiced / Captioned
          </button>
          <button id="bp-mode-easyread" type="button" aria-pressed="false" class="bp-mode-btn font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-border text-brand-light cursor-pointer">
            📖 Easy Read (29 TV + 17 Radio)
          </button>
          <button id="bp-mode-ad" type="button" aria-pressed="false" class="bp-mode-btn font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-border text-brand-light cursor-pointer">
            🎧 AD (.ad.m4a)
          </button>
          <button id="bp-mode-admix" type="button" aria-pressed="false" class="bp-mode-btn font-mono text-xs px-3 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 cursor-pointer">
            🎧 Voiced AD Mix
          </button>
          <button id="bp-mode-cues" type="button" aria-pressed="false" class="bp-mode-btn font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-cyan/40 text-brand-cyan cursor-pointer">
            🔔 Accessible Cues
          </button>
        </div>
      </div>

      <!-- Study + Depth Slot (15s vs 90s) + Radio Episode Easy-Read Selector -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          <label for="bp-study-select" class="font-mono text-xs text-brand-cyan">Study ({C.studies_count}):</label>
          <select id="bp-study-select" class="font-mono text-xs px-3 py-1.5 rounded-lg bg-[#0b1020] border border-brand-border text-brand-white">
            {artifacts.map((art) => (
              <option value={art.slug} selected={art.slug === initialArt.slug}>
                {art.short_title}
              </option>
            ))}
          </select>
          <div class="inline-flex rounded-lg border border-brand-border overflow-hidden font-mono text-xs">
            <button id="bp-slot-15s" type="button" class="px-2.5 py-1.5 bg-brand-amber text-brand-dark font-bold cursor-pointer border-none">15s</button>
            <button id="bp-slot-90s" type="button" class="px-2.5 py-1.5 bg-transparent text-brand-light cursor-pointer border-none">90s</button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2 font-mono text-[11px]">
          <span id="bp-j-badge" class="px-2.5 py-1 rounded bg-emerald-500/15 border border-emerald-400/35 text-emerald-300">
            Thor INA3221: {C.tool_energy_j_per_min?.local_edge_pipeline_thor_ina3221_j_per_min ?? 794.21} J/min · KV260 Net: {C.tool_energy_j_per_min?.local_edge_pipeline_kv260_net_j_per_min ?? 213.67} J/min (measured_j) · Cloud TTS: unmetered
          </span>
        </div>
      </div>

      <!-- T0 (12) + T1 (19) = 31 Voiced Target + T2 (19) = 50 Selector Codes + Sign (5) -->
      <div class="space-y-3 mb-5">
        <div>
          <div class="font-mono text-[11px] text-brand-amber mb-1.5">
            T0 Core Hubs (12 Languages) + T1 Regional/National (19 Languages) = 31-Language Voiced Target:
          </div>
          <div class="grid grid-cols-3 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-11 gap-1.5">
            {[...t0Langs, ...t1Langs].map((lg) => (
              <button
                type="button"
                data-bp-lang={lg.code}
                aria-pressed={lg.code === 'en' ? 'true' : 'false'}
                class={`bp-lang-pill font-mono text-[10.5px] px-2 py-1.5 rounded-lg border border-brand-border text-left cursor-pointer bg-white/[0.02] hover:border-brand-cyan ${lg.code === 'en' ? 'bp-lang-active' : ''}`}
              >
                <div class="font-bold text-brand-white truncate">{lg.native}</div>
                <div class="text-[9.5px] text-brand-gray flex justify-between">
                  <span>{lg.code}</span>
                  <span class="text-brand-cyan">{lg.tier}</span>
                </div>
              </button>
            ))}
          </div>
        </div>
        <div>
          <div class="font-mono text-[11px] text-brand-cyan mb-1.5">
            T2 Captions &amp; Easy-Read (19 Languages → 50 Selector Codes) + 5 Human Deaf Signer Slots (co_design_pending):
          </div>
          <div class="grid grid-cols-3 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-12 gap-1.5">
            {t2Langs.map((lg) => (
              <button
                type="button"
                data-bp-lang={lg.code}
                aria-pressed="false"
                class="bp-lang-pill font-mono text-[10.5px] px-2 py-1 rounded-lg border border-brand-border text-left cursor-pointer bg-white/[0.015] hover:border-brand-amber"
              >
                <div class="font-bold text-brand-white truncate">{lg.native}</div>
                <div class="text-[9.5px] text-brand-gray flex justify-between">
                  <span>{lg.code}</span>
                  <span>T2</span>
                </div>
              </button>
            ))}
            {signLangs.map((sl) => (
              <span
                title={`${sl.name}: human Deaf signer co-design pending (zero unreviewed AI avatars)`}
                class="font-mono text-[10px] px-2 py-1 rounded-lg border border-dashed border-brand-amber/40 text-brand-amber/90 bg-brand-amber/[0.04]"
              >
                <div class="font-bold truncate">🤟 {sl.code}</div>
                <div class="text-[9px] text-brand-gray truncate">co-design</div>
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Video + Audio + Right Panel -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7">
          <div class="relative rounded-xl overflow-hidden border border-brand-border bg-[#0b1020] aspect-video shadow-xl">
            <video
              id="bp-video"
              muted
              playsinline
              preload="metadata"
              poster={initialArt.modality_variants.poster_url}
              src={initialArt.modality_variants.tv_15s_video_url}
              class="w-full h-full object-contain bg-[#0b1020]"
            >
              <track id="bp-vtt-track" kind="captions" srclang="en" label="Synced Captions" src={initialVar.vtt_url} default />
            </video>
          </div>

          <div class="mt-3 p-3.5 rounded-xl border border-brand-cyan/35 bg-white/[0.03]">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <div class="font-mono text-xs text-brand-cyan font-semibold" id="bp-audio-label">
                ▶ Voiced Track · English (-16 LUFS Stereo · review_status: machine)
              </div>
              <div class="flex items-center gap-2 font-mono text-[11px]">
                <span id="bp-modality-pill" class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-400/30">modality: voiced</span>
                <a id="bp-download-m4a" href={initialVar.audio_url} class="text-brand-amber no-underline hover:underline">.m4a</a>
                <span class="text-brand-gray">·</span>
