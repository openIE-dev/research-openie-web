    const VAR_MAP = {};
    (DATA.variants || []).forEach((v) => {
      if (v.ship_allowed !== false) VAR_MAP[v.study_slug + ':' + v.lang] = v;
    });

    let activeSlug = 'ecosystem-avalanche';
    let activeLang = 'en';
    let activeMode = 'multilingual'; // 'multilingual' | 'easyread' | 'ad'

    const studySelectEl = document.getElementById('bp-study-select');
    const videoEl = document.getElementById('bp-video');
    const trackEl = document.getElementById('bp-vtt-track');
    const audioEl = document.getElementById('bp-audio');
    const audioLabelEl = document.getElementById('bp-audio-label');
    const dlM4aEl = document.getElementById('bp-download-m4a');
    const dlVttEl = document.getElementById('bp-download-vtt');
    const verdictEl = document.getElementById('bp-gate-verdict');
    const cidEl = document.getElementById('bp-canonical-id');
    const cometEl = document.getElementById('bp-score-comet');
    const labseEl = document.getElementById('bp-score-labse');
    const chrfEl = document.getElementById('bp-score-chrf');
    const bleuEl = document.getElementById('bp-score-bleu');
    const titleEl = document.getElementById('bp-active-title');
    const rungEl = document.getElementById('bp-active-rung');
    const langBadgeEl = document.getElementById('bp-lang-badge');
    const bulletsWrapEl = document.getElementById('bp-bullets-wrap');
    const bulletsListEl = document.getElementById('bp-bullets-list');
    const erPanelEl = document.getElementById('bp-easyread-panel');
    const erSymbolsEl = document.getElementById('bp-er-symbols');
    const erSentencesEl = document.getElementById('bp-er-sentences');
    const adPanelEl = document.getElementById('bp-ad-panel');
    const adOverviewEl = document.getElementById('bp-ad-overview');
    const adCuesEl = document.getElementById('bp-ad-cues');
    const linkPaperEl = document.getElementById('bp-link-paper');
    const linkTvEl = document.getElementById('bp-link-tv');
    const linkCommonsEl = document.getElementById('bp-link-commons');
    const linkErAllEl = document.getElementById('bp-link-easyread-all');

    function esc(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function render(autoplay) {
      const art = ART_BY_SLUG[activeSlug] || DATA.artifacts[0];
      if (!VAR_MAP[art.slug + ':' + activeLang]) {
        activeLang = 'en';
      }
      const lg = LANG_BY_CODE[activeLang] || DATA.tier1Langs[0];
      const v = VAR_MAP[art.slug + ':' + lg.code] || VAR_MAP[art.slug + ':en'] || DATA.variants[0];
      const ad = AD_BY_SLUG[art.slug];
      const er = ER_BY_SLUG[art.slug] || ER_BY_SLUG[art.tv_id];

      if (studySelectEl && studySelectEl.value !== art.slug) {
        studySelectEl.value = art.slug;
      }

      document.querySelectorAll('[data-bp-study]').forEach((b) => {
        const on = b.getAttribute('data-bp-study') === art.slug;
        b.classList.toggle('bp-pill-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      document.querySelectorAll('[data-bp-lang]').forEach((b) => {
        const code = b.getAttribute('data-bp-lang');
        const hasVar = Boolean(VAR_MAP[art.slug + ':' + code]);
        const on = code === lg.code;
        b.classList.toggle('bp-lang-active', on);
        b.classList.toggle('bp-lang-disabled', !hasVar);
        b.setAttribute('aria-pressed', String(on));
      });
      [
        ['bp-mode-multilingual', 'multilingual'],
        ['bp-mode-easyread', 'easyread'],
        ['bp-mode-ad', 'ad'],
      ].forEach(([id, m]) => {
        const el = document.getElementById(id);
        if (el) {
          el.classList.toggle('bp-mode-active', activeMode === m);
          el.setAttribute('aria-pressed', String(activeMode === m));
        }
      });

      if (videoEl && videoEl.getAttribute('src') !== art.modality_variants.tv_15s_video_url) {
        videoEl.pause();
        videoEl.setAttribute('poster', art.modality_variants.poster_url);
        videoEl.setAttribute('src', art.modality_variants.tv_15s_video_url);
        videoEl.load();
      }

      const useAd = activeMode === 'ad' && ad;
      const targetAudio = useAd ? ad.ad_audio_url : v.audio_url;
      const targetVtt = useAd ? ad.ad_vtt_url : v.vtt_url;
      const dir = (lg.dir || v.dir || 'ltr');

      if (trackEl) {
        trackEl.setAttribute('srclang', useAd ? 'en' : lg.code);
        trackEl.setAttribute('src', targetVtt);
      }
      if (audioEl && audioEl.getAttribute('src') !== targetAudio) {
        audioEl.pause();
        audioEl.setAttribute('src', targetAudio);
        audioEl.load();
      }

      if (audioLabelEl) {
        audioLabelEl.textContent = useAd
          ? '🎧 Extended Audio Description · ' + art.short_title + ' (-16 LUFS Stereo .ad.m4a)'
          : '▶ Native Neural Audio · ' + lg.name + ' (' + v.voice + ' · -16 LUFS Stereo AAC)';
      }
      if (dlM4aEl) dlM4aEl.setAttribute('href', targetAudio);
      if (dlVttEl) dlVttEl.setAttribute('href', targetVtt);

      if (verdictEl) verdictEl.textContent = '✓ GATE: ' + v.gate_status + ' (Attempt ' + v.attempts + '/2)';
      if (cidEl) cidEl.textContent = useAd ? ad.canonical_id : v.canonical_id;
      if (cometEl) cometEl.textContent = Number(v.comet_calibrated || 0).toFixed(4);
      if (labseEl) labseEl.textContent = Number(v.labse_cosine || 0).toFixed(4);
      if (chrfEl) chrfEl.textContent = Number(v.backtrans_chrfpp || 0).toFixed(1);
      if (bleuEl) bleuEl.textContent = Number(v.backtrans_bleu || 0).toFixed(1);

      if (titleEl) titleEl.textContent = art.title;
      if (rungEl) rungEl.textContent = art.difficulty_rung + ' · ' + art.energy_cost_j.label;
      if (langBadgeEl) langBadgeEl.textContent = lg.code + ' · Tier ' + (lg.tier || v.tier || 1) + ' · ' + dir.toUpperCase();

      if (bulletsWrapEl) {
        bulletsWrapEl.setAttribute('dir', dir);
        bulletsWrapEl.setAttribute('lang', lg.code);
      }
      if (bulletsListEl) {
        bulletsListEl.innerHTML = (v.bullets || []).map((b) => '<li>' + esc(b) + '</li>').join('');
      }

      if (erPanelEl) {
        erPanelEl.classList.toggle('hidden', activeMode !== 'easyread');
        if (er && erSymbolsEl && erSentencesEl) {
          erSymbolsEl.innerHTML = er.symbol_tags.map((t) =>
            '<span class="px-2.5 py-1 rounded-full border border-brand-cyan/35 bg-white/5 font-mono text-[11px] text-brand-white">' +
            '<span aria-hidden="true">' + esc(t.unicode) + '</span> ' + esc(t.core_word) + ': ' + esc(t.label) + '</span>'
          ).join('');
          erSentencesEl.innerHTML = er.one_idea_sentences.map((s) => '<li>' + esc(s) + '</li>').join('');
        }
      }

      if (adPanelEl) {
        adPanelEl.classList.toggle('hidden', activeMode !== 'ad');
        if (ad && adOverviewEl && adCuesEl) {
          adOverviewEl.textContent = ad.visual_overview;
          adCuesEl.innerHTML = ad.cues.map((c, idx) =>
            '<div class="p-2.5 rounded border border-brand-border bg-[#0b1020] text-xs">' +
            '<div class="font-mono text-[10px] text-emerald-300 mb-0.5">Scene ' + (idx + 1) + ' Visual Description</div>' +
            '<div class="text-brand-light mb-1">' + esc(c.visual) + '</div>' +
            '<div class="text-brand-amber font-mono text-[11px]">' + esc(c.takeaway) + '</div>' +
            '</div>'
          ).join('');
        }
      }

      if (linkPaperEl) linkPaperEl.setAttribute('href', art.modality_variants.paper_url);
      if (linkTvEl) linkTvEl.setAttribute('href', '/tv/?study=' + encodeURIComponent(art.tv_id) + '&tier=15s');
      if (linkCommonsEl) linkCommonsEl.setAttribute('href', art.modality_variants.commons_trail_url);
      if (linkErAllEl) linkErAllEl.setAttribute('href', art.modality_variants.easy_read_url);

      const waiSelect = document.getElementById('wai1-select');
      const waiPre = document.getElementById('wai1-json');
      if (waiSelect && waiPre && waiSelect.value !== '__blueprint__') {
        waiSelect.value = art.slug;
        waiPre.textContent = JSON.stringify(art, null, 2);
      }

      if (autoplay && audioEl) {
        if (videoEl) { videoEl.currentTime = 0; videoEl.play().catch(() => {}); }
        audioEl.currentTime = 0;
        audioEl.play().catch(() => {});
      }
    }

    if (audioEl && videoEl) {
      audioEl.addEventListener('play', () => {
        if (videoEl.duration) videoEl.currentTime = audioEl.currentTime % videoEl.duration;
        videoEl.play().catch(() => {});
      });
      audioEl.addEventListener('pause', () => { videoEl.pause(); });
      audioEl.addEventListener('ended', () => { videoEl.pause(); });
    }

    studySelectEl?.addEventListener('change', () => {
      activeSlug = studySelectEl.value || 'ecosystem-avalanche';
      render(false);
    });

    document.querySelectorAll('[data-bp-study]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeSlug = btn.getAttribute('data-bp-study') || 'ecosystem-avalanche';
        render(false);
      });
    });

    document.querySelectorAll('[data-bp-lang]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-bp-lang') || 'en';
        if (!VAR_MAP[activeSlug + ':' + code]) {
          // Automatically jump to a 50-language flagship when clicking a Tier-2 language from a Tier-1-only study
          if (VAR_MAP['ecosystem-avalanche:' + code]) activeSlug = 'ecosystem-avalanche';
          else if (VAR_MAP['lut6-codon-nucleus:' + code]) activeSlug = 'lut6-codon-nucleus';
        }
        activeLang = code;
        if (activeMode === 'ad') activeMode = 'multilingual';
        render(true);
      });
    });

    document.querySelectorAll('[data-matrix-study]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeSlug = btn.getAttribute('data-matrix-study') || 'ecosystem-avalanche';
        activeLang = btn.getAttribute('data-matrix-lang') || 'en';
        activeMode = 'multilingual';
        render(true);
        document.getElementById('planetary-player')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    document.getElementById('bp-mode-multilingual')?.addEventListener('click', () => { activeMode = 'multilingual'; render(false); });
    document.getElementById('bp-mode-easyread')?.addEventListener('click', () => { activeMode = 'easyread'; render(false); });
    document.getElementById('bp-mode-ad')?.addEventListener('click', () => { activeMode = 'ad'; render(true); });

    const waiSelect = document.getElementById('wai1-select');
    const waiPre = document.getElementById('wai1-json');
    waiSelect?.addEventListener('change', () => {
      const val = waiSelect.value;
      const obj = val === '__blueprint__' ? DATA.blueprintArtifact : (ART_BY_SLUG[val] || DATA.blueprintArtifact);
      if (waiPre) waiPre.textContent = JSON.stringify(obj, null, 2);
    });
    document.getElementById('wai1-copy')?.addEventListener('click', (ev) => {
      if (!waiPre) return;
      navigator.clipboard?.writeText(waiPre.textContent || '');
      const btn = ev.currentTarget;
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 1400);
    });

    render(false);
  })();
  </script>
</Layout>
