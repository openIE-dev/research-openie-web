---
import Layout from '../layouts/Layout.astro';
import unsiloeing from '../data/planetary-unsiloeing.json';

const SITE = 'https://research.openie.dev';
const M: any = unsiloeing.summary_metrics;
const artifacts = unsiloeing.canonical_artifacts as any[];
const flagshipArtifacts = artifacts.filter((a) => a.flagship !== false);
const tier2FlagshipArtifacts = artifacts.filter((a) => a.tier2_50 === true);
const tier1Langs = unsiloeing.tier1_languages as any[];
const tier2Langs = ((unsiloeing as any).tier2_languages ?? unsiloeing.tier2_roadmap) as any[];
const variants = unsiloeing.variants as any[];
const adTracks = unsiloeing.audio_descriptions as any[];
const easyReadFlagship = unsiloeing.easy_read_flagship as any[];
const aacConcepts = unsiloeing.aac_concepts_preview as any[];
const surfaces = unsiloeing.ecosystem_surfaces as any[];
const advAudit = unsiloeing.gate_specification.adversarial_audit as any[];

const totalPassed = M.passed_variants ?? M.tier1_passed_variants;
const totalVariants = M.total_variants ?? M.tier1_total_variants;
const totalFlagged = M.flagged_variants ?? M.tier1_flagged_variants;
const activeLangCount = M.active_languages ?? (tier1Langs.length + tier2Langs.filter((l) => (l.passed_count ?? 0) > 0).length);
const totalSpeakersB = (((M.total_speakers_millions ?? (M.tier1_speakers_millions + M.tier2_speakers_millions)) || 7949) / 1000).toFixed(2);
const totalAudioMb = M.total_planetary_audio_mb ?? M.total_tier1_audio_mb;

const initialArt = artifacts.find((a) => a.slug === 'ecosystem-avalanche') ?? artifacts[0];
const initialVar = variants.find((v) => v.study_slug === initialArt.slug && v.lang === 'en') ?? variants[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: unsiloeing.blueprint_artifact.title,
  datePublished: '2026-11-24',
  dateModified: '2026-11-24',
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  url: `${SITE}/blueprint/`,
  identifier: unsiloeing.blueprint_artifact.canonical_id,
  publisher: {
    '@type': 'Organization',
    name: 'Open Interface Engineering, Inc.',
    url: 'https://openie.dev',
  },
  about: [
    'Canonical Artifact Substrate',
    'WAI1 Attested Media Envelope',
    '50-Language Plain-Language Science Dissemination',
    'WCAG 2.2 AA Full-Catalog Easy Read and Extended Audio Description',
    'SKOS Augmentative and Alternative Communication Concepts',
  ],
};

const clientPayload = JSON.stringify({
  artifacts,
  tier1Langs,
  tier2Langs,
  variants,
  adTracks,
  easyReadFlagship,
  blueprintArtifact: unsiloeing.blueprint_artifact,
});
---

<Layout
  title="Unsiloeing the OpenIE Ecosystem — 50-Language Canonical Artifact & Accessibility Blueprint"
  description="Canonical Artifact Substrate (WAI1 BLAKE3/Ed25519), 620 verified 15-second plain-language variants across 50 languages (~7.95B speakers), and 28/28 full-catalog WCAG 2.2 AA Easy-Read, Extended Audio-Description, and SKOS AAC projections."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-5 md:px-10 pt-10 pb-24">
    <!-- Hero Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="section-label">Canonical Blueprint Artifact · /blueprint/</span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-amber/15 text-brand-amber border border-brand-amber/35">
          CC0-1.0 Public-Domain Text &amp; Accessibility
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/35">
          Apache-2.0 Schema &amp; WAI1 Envelope
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-emerald-500/15 text-emerald-300 border border-emerald-400/35">
          {totalPassed} / {totalVariants} Gate Pass · {activeLangCount} Languages (~{totalSpeakersB}B Speakers) · {totalFlagged} Quarantined
        </span>
      </div>

      <h1 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-brand-white leading-tight mb-4">
        Unsiloeing the Open<span class="text-brand-cyan">IE</span> Ecosystem
      </h1>
      <p class="font-display text-lg md:text-2xl text-brand-amber mb-4">
        Canonical Artifact Substrate + Planetary 50-Language Research Dissemination Blueprint
      </p>
      <p class="font-body text-base text-brand-slate max-w-4xl leading-relaxed mb-6">
        One deterministic pipeline under a public-benefit mandate: a research record enters once and verified, energy-labeled, 50-language, and 100% catalog-accessible projections exit across <a href="/tv/" class="text-brand-amber">Research TV</a>, <a href="/radio/" class="text-brand-cyan">Research Radio</a>, <a href="https://scholar.askdavidc.ai">The Commons</a>, the <a href="https://github.com/openIE-dev/free-humanoid-corpus">Free Humanoid Corpus</a>, and <a href="https://avalanche.openie.dev">OpenIE Avalanche</a>.
      </p>

      <!-- Top Summary KPI Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Verified 15s Fleet</div>
          <div class="font-display text-2xl font-bold text-brand-amber mt-1">{totalPassed}/{totalVariants}</div>
          <div class="font-mono text-[11px] text-brand-slate">28×20 T1 + 2×30 T2</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Speaker Reach</div>
          <div class="font-display text-2xl font-bold text-brand-cyan mt-1">{totalSpeakersB}B</div>
          <div class="font-mono text-[11px] text-brand-slate">{activeLangCount} Active Languages (T1+T2)</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Neural Semantic Gate</div>
          <div class="font-display text-2xl font-bold text-emerald-300 mt-1">{M.fleet_mean_comet_calibrated.toFixed(3)}</div>
          <div class="font-mono text-[11px] text-brand-slate">LaBSE {M.fleet_mean_labse_cosine.toFixed(3)} · mE5 {M.fleet_mean_me5_cosine.toFixed(3)}</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Round-Trip chrF++</div>
          <div class="font-display text-2xl font-bold text-brand-white mt-1">{M.fleet_mean_backtrans_chrfpp.toFixed(1)}</div>
          <div class="font-mono text-[11px] text-brand-slate">NLLB-200 BLEU {M.fleet_mean_backtrans_bleu.toFixed(1)}</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Easy-Read + AD</div>
          <div class="font-display text-2xl font-bold text-brand-amber mt-1">{M.easy_read_studies}/{M.catalog_studies ?? 29} · {M.audio_described_films}/{M.catalog_studies ?? 29}</div>
          <div class="font-mono text-[11px] text-brand-slate">100% Catalog · WCAG 2.2 AA</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">AAC SKOS Concepts</div>
          <div class="font-display text-2xl font-bold text-brand-cyan mt-1">{M.aac_concepts_count}</div>
          <div class="font-mono text-[11px] text-brand-slate">&le; {M.aac_max_plain_words} Plain Words Each</div>
        </div>
      </div>

      <!-- Quick Section Jump Nav -->
      <nav aria-label="Blueprint sections" class="mt-6 flex flex-wrap gap-2">
        <a href="#planetary-player" class="font-mono text-xs px-3 py-1.5 rounded-md bg-brand-amber text-brand-dark font-semibold no-underline">1. 50-Language 15s &amp; 29/29 AD Player</a>
        <a href="#gate-scoreboard" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">2. 620-Variant Gate Matrix (T1 + T2)</a>
        <a href="#accessibility" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">3. 29/29 Easy Read, AD &amp; AAC</a>
        <a href="#wai1-inspector" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">4. Schema &amp; WAI1 Inspector</a>
        <a href="#blueprint-text" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">5. Full Blueprint (§§1–10)</a>
        <a href="/syndication/" class="font-mono text-xs px-3 py-1.5 rounded-md border border-emerald-400/45 text-emerald-300 bg-emerald-500/10 no-underline hover:bg-emerald-500/20">6. 9:16 TikTok + X ↔ Medium &amp; 6-Tier Ecosystem Studio →</a>
      </nav>
    </header>

    <!-- INTERACTIVE 50-LANGUAGE (TIER-1 + TIER-2) 15S PLAIN-WORDS PLAYER + 29/29 ACCESSIBILITY SWITCHER -->
    <section id="planetary-player" class="scroll-mt-24 glass-card p-5 md:p-7 mb-12 border-t-2 border-t-brand-amber">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 mb-6 border-b border-brand-border">
        <div>
          <div class="font-mono text-[11px] uppercase tracking-wider text-brand-amber mb-1">
            Step 5 &amp; §5 Live Projection · {totalPassed} Neural Audio &amp; WebVTT Variants ({totalAudioMb} MB Stereo -16 LUFS Bundle) + 29/29 AD
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-white m-0">
            Planetary 50-Language <span class="text-brand-amber">15s Plain-Words</span> &amp; 29/29 Accessibility Theater
          </h2>
        </div>

        <!-- Mode Toggles: Standard Multilingual vs Easy Read vs Extended Audio Description -->
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Projection mode switcher">
          <button
            id="bp-mode-multilingual"
            type="button"
            aria-pressed="true"
            class="bp-mode-btn bp-mode-active font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-amber text-brand-white cursor-pointer transition-all"
          >
            🌐 {activeLangCount}-Language Neural Audio
          </button>
          <button
            id="bp-mode-easyread"
            type="button"
            aria-pressed="false"
            class="bp-mode-btn font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all"
          >
            📖 Easy Read + Symbols (29/29)
          </button>
          <button
            id="bp-mode-ad"
            type="button"
            aria-pressed="false"
            class="bp-mode-btn font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all"
          >
            🎧 Audio Description (29/29 .ad.m4a)
          </button>
        </div>
      </div>

      <!-- Full 29-Study Selector + Quick Flagship Pills -->
      <div class="mb-4">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
          <div class="font-mono text-[11px] text-brand-gray">
            Select Any of All {M.catalog_studies ?? 29} Research TV Studies (Tier-1 Languages + AD + Easy-Read on All Studies · 50 Languages on Core Flagships):
          </div>
          <div class="flex items-center gap-2">
            <label for="bp-study-select" class="font-mono text-[11px] text-brand-cyan">All {M.catalog_studies ?? 29} Studies:</label>
            <select
              id="bp-study-select"
              aria-label="Choose any Research TV study"
              class="font-mono text-xs px-3 py-1.5 rounded-lg bg-[#0b1020] border border-brand-border text-brand-white focus:border-brand-amber"
            >
              {artifacts.map((art) => (
                <option value={art.slug} selected={art.slug === initialArt.slug}>
                  {art.short_title} {art.tier2_50 ? '(50 Langs · T1+T2)' : '(20 Langs · T1)'}
                </option>
              ))}
            </select>
          </div>
        </div>
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Quick flagship study shortcuts">
          {flagshipArtifacts.map((art) => (
            <button
              type="button"
              data-bp-study={art.slug}
              aria-pressed={art.slug === initialArt.slug ? 'true' : 'false'}
              class={`bp-study-pill font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer bg-transparent transition-all ${art.slug === initialArt.slug ? 'bp-pill-active' : ''}`}
            >
              {art.short_title} {art.tier2_50 ? '· 50L' : ''}
            </button>
          ))}
        </div>
      </div>

      <!-- 20 Tier-1 Language Selector Grid (Active Across All 28 Studies) -->
      <div class="mb-4">
        <div class="font-mono text-[11px] text-brand-gray mb-2">
          Tier-1 Languages — Top 20 by Global Speaker Population (Active Across All 28 / 28 Studies · 560 Variants · 6.54B Speakers):
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-10 gap-1.5" role="radiogroup" aria-label="Select Tier-1 language">
          {tier1Langs.map((lg) => (
            <button
              type="button"
              data-bp-lang={lg.code}
              data-bp-tier="1"
              aria-pressed={lg.code === 'en' ? 'true' : 'false'}
              class={`bp-lang-pill font-mono text-[11px] px-2.5 py-2 rounded-lg border border-brand-border text-left cursor-pointer bg-white/[0.02] hover:border-brand-cyan transition-all ${lg.code === 'en' ? 'bp-lang-active' : ''}`}
            >
              <div class="font-bold text-brand-white truncate">{lg.native}</div>
              <div class="text-[10px] text-brand-gray flex justify-between">
                <span>{lg.code}</span>
                <span>{lg.speakers_m}M</span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- 30 Tier-2 Language Selector Grid (Active on Core Flagships: Nine-Rung Avalanche & 64-Codon Lookup Nucleus) -->
      <div class="mb-6">
        <div class="font-mono text-[11px] text-brand-cyan mb-2">
          Tier-2 Languages — Next 30 Global Languages (+1.41B Speakers = ~{totalSpeakersB}B Total · Live on <em>Nine-Rung Intelligence Avalanche</em> &amp; <em>64-Codon Lookup Nucleus</em>):
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-10 gap-1.5" role="radiogroup" aria-label="Select Tier-2 language">
          {tier2Langs.map((lg) => (
            <button
              type="button"
              data-bp-lang={lg.code}
              data-bp-tier="2"
              aria-pressed="false"
              class="bp-lang-pill font-mono text-[11px] px-2.5 py-1.5 rounded-lg border border-brand-border text-left cursor-pointer bg-white/[0.015] hover:border-brand-amber transition-all"
            >
              <div class="font-bold text-brand-white truncate">{lg.native}</div>
              <div class="text-[10px] text-brand-gray flex justify-between">
                <span>{lg.code}</span>
                <span>{lg.speakers_m}M</span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Split Video/Audio Stage + Live 3-Bullet / Easy-Read / AD Transcript -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7">
          <div class="relative rounded-xl overflow-hidden border border-brand-border bg-[#0b1020] aspect-video shadow-xl">
            <video
              id="bp-video"
              muted
              playsinline
              preload="metadata"
              poster={initialArt.modality_variants.poster_url}
              src={initialArt.modality_variants.tv_15s_video_url}
              class="w-full h-full object-contain bg-[#0b1020]"
            >
              <track
                id="bp-vtt-track"
                kind="captions"
                srclang="en"
                label="Synced Captions"
                src={initialVar.vtt_url}
                default
              />
            </video>
          </div>

          <!-- Dedicated Native Neural Audio Bar (-16 LUFS Stereo .m4a) -->
          <div class="mt-3 p-3.5 rounded-xl border border-brand-cyan/35 bg-white/[0.03]">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <div class="font-mono text-xs text-brand-cyan font-semibold" id="bp-audio-label">
                ▶ Native Neural Audio · English (en-US-AvaNeural · -16 LUFS Stereo AAC)
              </div>
              <div class="flex items-center gap-2">
                <a id="bp-download-m4a" href={initialVar.audio_url} class="font-mono text-[11px] text-brand-amber no-underline hover:underline">
                  .m4a
                </a>
                <span class="text-brand-gray">·</span>
                <a id="bp-download-vtt" href={initialVar.vtt_url} class="font-mono text-[11px] text-brand-cyan no-underline hover:underline">
                  .vtt
                </a>
              </div>
            </div>
            <audio
              id="bp-audio"
              controls
              preload="metadata"
              src={initialVar.audio_url}
              class="w-full h-10"
              aria-label="Synchronized multilingual or audio-described voiceover player"
            ></audio>
          </div>

          <!-- Gate Verification Receipt Strip for Active Variant -->
          <div class="mt-3 p-3.5 rounded-xl border border-brand-border bg-white/[0.015] font-mono text-xs">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-emerald-300 font-semibold" id="bp-gate-verdict">
                ✓ GATE: PASS_FIRST_TRY (Attempt 1/2)
              </span>
              <span class="text-brand-gray truncate" id="bp-canonical-id">
                {initialVar.canonical_id}
              </span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2.5 pt-2.5 border-t border-brand-border text-[11px]">
              <div><span class="text-brand-gray">COMET-Cal:</span> <span id="bp-score-comet" class="text-brand-amber font-bold">{initialVar.comet_calibrated.toFixed(4)}</span></div>
              <div><span class="text-brand-gray">LaBSE Cos:</span> <span id="bp-score-labse" class="text-brand-cyan font-bold">{initialVar.labse_cosine.toFixed(4)}</span></div>
              <div><span class="text-brand-gray">NLLB chrF++:</span> <span id="bp-score-chrf" class="text-brand-white font-bold">{initialVar.backtrans_chrfpp.toFixed(1)}</span></div>
              <div><span class="text-brand-gray">NLLB BLEU:</span> <span id="bp-score-bleu" class="text-brand-light font-bold">{initialVar.backtrans_bleu.toFixed(1)}</span></div>
            </div>
          </div>
        </div>

        <!-- Right Column: 3 Zero-Acronym Takeaways + Conditional Easy-Read / AD Projection -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="glass-card p-5">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-brand-amber" id="bp-card-kicker">
                3 Zero-Acronym Plain-Language Takeaways
              </span>
              <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-white/5 text-brand-cyan border border-brand-border" id="bp-lang-badge">
                en · LTR
              </span>
            </div>
            <h3 id="bp-active-title" class="font-display text-xl font-bold text-brand-white mb-1">
              {initialArt.title}
            </h3>
            <div id="bp-active-rung" class="font-mono text-[11px] text-brand-cyan mb-3">
              {initialArt.difficulty_rung} · {initialArt.energy_cost_j.label}
            </div>

            <div id="bp-bullets-wrap" dir="ltr" lang="en" class="p-4 rounded-xl border border-brand-amber/30 bg-white/[0.025]">
              <ol id="bp-bullets-list" class="list-decimal pl-5 space-y-2.5 font-body text-sm text-brand-light leading-relaxed m-0">
                {initialVar.bullets.map((b: string) => <li>{b}</li>)}
              </ol>
            </div>

            <!-- Easy Read Overlay Panel (shown when Easy Read mode active) -->
            <div id="bp-easyread-panel" class="hidden mt-4 p-4 rounded-xl border border-brand-cyan/40 bg-brand-cyan/[0.06]">
              <div class="font-mono text-[11px] uppercase tracking-wider text-brand-cyan mb-2">
                Easy-Read Companion · WCAG 2.2 AA · One Idea Per Sentence
              </div>
              <div id="bp-er-symbols" class="flex flex-wrap gap-1.5 mb-3"></div>
              <ol id="bp-er-sentences" class="list-decimal pl-5 space-y-1.5 font-body text-sm text-brand-white leading-relaxed m-0"></ol>
            </div>

            <!-- Audio Description Panel (shown when AD mode active) -->
            <div id="bp-ad-panel" class="hidden mt-4 p-4 rounded-xl border border-emerald-400/40 bg-emerald-500/[0.06]">
              <div class="font-mono text-[11px] uppercase tracking-wider text-emerald-300 mb-1.5">
                Extended Audio Description · 3D Geometry &amp; Color Algebra
              </div>
              <p id="bp-ad-overview" class="font-body text-xs text-brand-slate mb-2.5"></p>
              <div id="bp-ad-cues" class="space-y-2 max-h-56 overflow-y-auto pr-1"></div>
            </div>

            <!-- Cross-Surface Unsiloeing Links -->
            <div class="mt-4 pt-4 border-t border-brand-border flex flex-wrap gap-2">
              <a id="bp-link-paper" href={initialArt.modality_variants.paper_url} class="font-mono text-xs px-3 py-1.5 rounded-md bg-brand-amber text-brand-dark font-semibold no-underline">
                Paper →
              </a>
              <a id="bp-link-tv" href={`/tv/?study=${initialArt.tv_id}`} class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">
                Open in /tv/ Studio
              </a>
              <a id="bp-link-commons" href={initialArt.modality_variants.commons_trail_url} class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-cyan/40 text-brand-cyan no-underline hover:bg-brand-cyan/10">
                Commons Trail ↗
              </a>
              <a id="bp-link-easyread-all" href={initialArt.modality_variants.easy_read_url} class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-slate no-underline hover:text-brand-white">
                28-Study Easy Read &amp; AD
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: DETERMINISTIC NO-HUMAN VERIFICATION GATE SCOREBOARD (560 TIER-1 + 60 TIER-2 = 620 VARIANTS) -->
    <section id="gate-scoreboard" class="scroll-mt-24 mb-14">
      <div class="mb-5">
        <span class="section-label">§§4 &amp; 6 · Zero Human Review Gates · 50 Active Languages</span>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-white mt-1">
          Deterministic 620-Variant Gate Scoreboard (28×20 Tier-1 + 2×30 Tier-2)
        </h2>
        <p class="font-body text-sm text-brand-slate max-w-4xl leading-relaxed mt-2">
