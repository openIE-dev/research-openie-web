  <script is:inline>
    (function () {
      var slVel = document.getElementById('sl-velocity');
      var slCompat = document.getElementById('sl-compat');
      var slEdge = document.getElementById('sl-edge');
      var slProof = document.getElementById('sl-proof');

      function updateRecommender() {
        if (!slVel || !slCompat || !slEdge || !slProof) return;
        var v = Number(slVel.value);
        var c = Number(slCompat.value);
        var e = Number(slEdge.value);
        var p = Number(slProof.value);

        document.getElementById('val-velocity').textContent = v + '%';
        document.getElementById('val-compat').textContent = c + '%';
        document.getElementById('val-edge').textContent = e + '%';
        document.getElementById('val-proof').textContent = p + '%';

        // Layer 1: Sandbox & Meter
        var l1 =
          e >= 70
            ? 'Wasmtime + WASI fuel + TI INA260 / INA3221 physical DC shunt (measured_j)'
            : p >= 85 && c < 45
            ? 'Clean-Room RCE Deterministic Host Fold + Wasmtime WASI Envelope'
            : 'Wasmtime + WASI fuel + Linux RAPL / Apple IOReport (reported_j)';

        // Layer 2: Surface Languages & Verification
        var l2 =
          p >= 85 && c < 50
            ? 'Lean 4.36.0 (6-Kernel Audit) + Nameless De Bruijn RCE Equivalence IR'
            : p >= 60
            ? 'Rust + Verus / Dafny / Lean 4 Contracts (Mapped via 113-Construct Bridge)'
            : 'Mainstream Rust / Python / TypeScript / Go + Property Test Suites';

        // Layer 3: Specification Fidelity
        var l3 =
          p >= 65
            ? 'Spec ⊥ Impl Isolation + SMT Non-Vacuity Proof + Mutant Gate + llguidance'
            : 'Context-Isolated Specs (Spec ⊥ Impl) + Mutant Kill Gate + Outlines/llguidance';

        // Layer 4: Downward Compilation & Cascade Rung
        var l4 =
          e >= 75
            ? 'Rungs 1–3 + Rung 4 Hardware Path: LLVM MLIR + CIRCT (comb/hw → SystemVerilog)'
            : e >= 45
            ? 'Rungs 1–3: Exact Lookup → Wasm Skills → 0.5B–2B Packed-Int WHT+XNOR Kernel'
            : 'Stop at Rungs 1–3: Exact Hash Lookup → Synthesized Rust/Wasm Skill Library';

        // Layer 5: Wire Protocols & Energy Telemetry
        var l5 =
          e >= 60 || v < 50
            ? 'Apache-2.0 OTel Joule Spans + Zero-Copy FlatBuffers + RFC 9052 COSE_Sign1'
            : 'Apache-2.0 OpenTelemetry Joule Conventions + RFC 9052 COSE_Sign1 Receipts';

        var title = 'Drop-In Production Standards Bridge (Rungs 1–3 · Zero Custom Lock-In)';
        var badge = 'Est. Integration: 1–3 Days · 100% Apache-2.0';
        var rationale =
          'Keeps 100% of your existing surface languages and observability pipeline intact. Adds context-isolated mutation testing + grammar-constrained decoding up front, crystallizes repeated calls into Wasmtime skill routines, and exports orthogonal joule spans to OpenTelemetry.';

        if (e >= 75) {
          title = 'Sub-Millijoule Edge & MLIR/CIRCT Hardware Bridge (Rungs 1–4)';
          badge = 'Est. Integration: 2–4 Weeks · Hardware Shunt + CIRCT RTL';
          rationale =
            'Pairs Wasmtime skill caching with physical TI INA260/INA3221 rail shunts (measured_j) and lowers ultra-hot inner policies through LLVM MLIR + CIRCT (comb/hw → SystemVerilog) with exhaustive translation validation.';
        } else if (p >= 85 && c < 50) {
          title = 'Clean-Room Formal Kernel & 6-Checker Mechanized Audit';
          badge = 'Research / High-Assurance Audit · Lean 4.36.0 + RCE IR';
          rationale =
            'Prioritizes minimal-TCB proof checking across all 6 independent Lean 4.36.0 kernels and nameless de Bruijn equivalence while still exporting standard RFC 9052 COSE_Sign1 + OpenTelemetry receipts.';
        } else if (p >= 60) {
          title = 'Verified Mainstream Stack (Rust + Verus / Lean 4 + Wasmtime Bridge)';
          badge = 'Est. Integration: 1–2 Weeks · SMT Verified + Apache-2.0';
          rationale =
            'Combines Rust + Verus or Dafny/Lean 4 specifications with Spec ⊥ Impl context isolation, mutant/vacuity kill gates, Wasmtime sandboxing, and COSE_Sign1 signed OpenTelemetry joule receipts.';
        }

        document.getElementById('rec-l1').textContent = l1;
        document.getElementById('rec-l2').textContent = l2;
        document.getElementById('rec-l3').textContent = l3;
        document.getElementById('rec-l4').textContent = l4;
        document.getElementById('rec-l5').textContent = l5;
        document.getElementById('rec-profile-title').textContent = title;
        document.getElementById('rec-ramp-badge').textContent = badge;
        document.getElementById('rec-rationale').textContent = rationale;
      }

      [slVel, slCompat, slEdge, slProof].forEach(function (el) {
        if (el) el.addEventListener('input', updateRecommender);
      });

      document.querySelectorAll('[data-std-preset]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var parts = (btn.getAttribute('data-std-preset') || '85,95,15,25').split(',').map(Number);
          if (parts.length === 4) {
            slVel.value = String(parts[0]);
            slCompat.value = String(parts[1]);
            slEdge.value = String(parts[2]);
            slProof.value = String(parts[3]);
            document.querySelectorAll('[data-std-preset]').forEach(function (b) {
              var on = b === btn;
              b.className = on
                ? 'std-preset-btn px-2.5 py-1 rounded border border-brand-amber bg-brand-amber/15 text-brand-amber font-mono text-[11px] cursor-pointer'
                : 'std-preset-btn px-2.5 py-1 rounded border border-brand-border text-brand-slate hover:text-brand-white font-mono text-[11px] cursor-pointer';
            });
            updateRecommender();
          }
        });
      });

      // Sync <details data-gw-rung="builder|formal"> with Global 4-Altitude Reading Depth Bar
      function syncDepthDetails(depth) {
        var bDet = document.getElementById('gw-rung-builder');
        var fDet = document.getElementById('gw-rung-formal');
        if (bDet) bDet.open = depth === 'builder' || depth === 'formal';
        if (fDet) fDet.open = depth === 'formal';
      }
      syncDepthDetails(document.documentElement.getAttribute('data-reading-depth') || 'plain');
      window.addEventListener('openie:reading-depth', function (ev) {
        if (ev && ev.detail && ev.detail.depth) syncDepthDetails(ev.detail.depth);
      });

      // Copy buttons
      document.querySelectorAll('[data-copy-cmd]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var cmd = btn.getAttribute('data-copy-cmd') || '';
          var orig = btn.textContent;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(cmd).then(function () {
              btn.textContent = '✓ Copied!';
              setTimeout(function () { btn.textContent = orig; }, 1800);
            });
          }
        });
      });

      updateRecommender();
    })();
  </script>
</Layout>
