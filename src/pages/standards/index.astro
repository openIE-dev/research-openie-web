    {/* DEPTH 4: FORMAL SPECIFICATION & FALSIFIERS */}
    <details id="gw-rung-formal" data-gw-rung="formal" class="mt-4 glass-card border border-brand-indigo/35 overflow-hidden">
      <summary class="px-6 py-4 cursor-pointer flex flex-wrap items-center justify-between gap-2 select-none">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="font-mono text-[10px] tracking-[0.14em] uppercase px-2.5 py-0.5 rounded bg-brand-indigo/20 text-brand-indigo font-semibold">
            Depth 4 · Formal Gate Conditions &amp; Falsifiers
          </span>
