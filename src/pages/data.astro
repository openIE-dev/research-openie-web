---
import Layout from '../layouts/Layout.astro';
const R = 'https://github.com/openIE-dev/openie-research-experiments/tree/main/';
const groups = [
  { id: 'agency', title: 'Thermodynamic Bounds and an Optimal Tempo for Goal-Holding Agents', paper: '/papers/agency/', rows: [
    ['§8.11 preregistered acceptor run', 'agency-run/', 'Preregistrations v1, v2 and second machine; agents, meters, tasks, analysis; episodes and receipts'],
    ['§8.11 results, run 1', 'agency-run/results/', 'Episode rows and receipts'],
    ['§8.11.1 and §8.11.2 results', 'agency-run/results2/', 'Second run; the second machine is in results_jetson/ and results_jetson_cyc/'],
  ]},
  { id: 'rce', title: 'The Reality Code Engine', paper: '/papers/rce/', rows: [
    ['§2.3 and §6.1 to §6.3 ladder: L0 and L1 held-out results, RAPL subsample', 'rce/bench/ladder/', 'LADDER.md, PREREG.json with splits, RESULTS.md, report.py, per-task rows, results/jetson-rapl-2026-10-11'],
    ['§4.5 and §5.1 Form compiler, five-target differential test', 'rce/bench/forms/', 'Harness and recorded traces; test in rce/tests/form_targets.rs'],
    ['flowG cross-backend conformance (RCE §1, flowG)', 'flowg-conformance/', 'Suite, fixtures by tier, recorded 18 of 18 report, CI job'],
    ['§8.1 Defects4J', 'rce/bench/defects4j/', 'Harness, TBar port comparison, REVIEW.md, results'],
    ['§3.8 dimension runs dim-r1 and dim-r2', 'rce/bench/dimension/', 'PREREG.json with amendments and hash sidecar, pilot, RESULTS.md, per-program rows in results/'],
    ['§3.5 and §12.4 surveys of 22 and 23 October 2026', 'rce/surveys/', 'The three design reports, the database survey and their reading notes'],
  ]},
  { id: 'rce-jepa', title: 'RCE-JEPA', paper: '/about/rce-jepa/', rows: [
    ['W1 Form corpus v1 and H1 (Form space against source space)', 'rce/bench/form-space/', 'PREREG.json with hash sidecar, CARD.md (dataset card), RESULTS.md, results/forms.jsonl, results/negatives.jsonl, summary.json; generator scripts/corpus.py in openIE-dev/rce'],
  ]},
  { id: 'gates', title: 'Metered Commit Gates', paper: '/papers/gates/', rows: [
    ['Part I and II', null, 'The gate and cascade use the WCA reference implementation described in the paper. Its board logs are cited in the paper\'s Appendix A.'],
  ]},
  { id: 'economics', title: 'Economics companions: AI-Coding Market, Task Satiation, Spell Check', paper: '/papers/ai-coding-market/', rows: [
    ['Measurements cited', 'rce/', 'The essay\'s measured rows come from RCE §6; the projections cite public sources in each paper\'s references.'],
  ]},
];
---
<Layout title="Data and code | OpenIE Research" description="Where each paper's results live in the public experiments repository.">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="font-display text-3xl text-brand-white">Data and code</h1>
    <p class="mt-4 font-body text-sm text-brand-slate leading-relaxed">The reproducible material for these papers is in <a href="https://github.com/openIE-dev/openie-research-experiments">github.com/openIE-dev/openie-research-experiments</a>: preregistrations with their SHA-256, scripts, results, receipts, a checksum file for every file, and pinned references for large corpora (CORPORA.md). Code is Apache-2.0 and data is CC BY 4.0. Energy labels: est_j is an estimate, reported_j an operating-system or on-chip counter, measured_j a wall or shunt meter, empty in every result.</p>
    {groups.map((g) => (
      <section id={g.id} class="mt-10">
        <h2 class="font-display text-xl text-brand-white"><a href={g.paper}>{g.title}</a></h2>
        <table class="mt-3 w-full font-body text-sm text-brand-slate">
          <thead><tr><th class="text-left pr-4">Result</th><th class="text-left pr-4">Repository path</th><th class="text-left">Contents</th></tr></thead>
          <tbody>{g.rows.map(([r, p, c]) => (<tr><td class="pr-4 py-1 align-top">{r}</td><td class="pr-4 py-1 align-top">{p ? <a href={R + p}><code>{p}</code></a> : 'n/a'}</td><td class="py-1 align-top">{c}</td></tr>))}</tbody>
        </table>
      </section>
    ))}
  </main>
</Layout>
