---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/ni.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description={`${frontmatter.title}: OpenIE teaching paper / research study draft. board_synth_claimed=false.`}
  headings={headings}
  paperId={frontmatter.id}
  genre="Research study · reference implementation"
>
  <Content />
</PaperLayout>
