---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/three-body.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Computing has three bodies, theorists, makers and users. Instability lives in the unexamined interfaces between them. Pursuing AGI forces every interface assumption to be explicit and checked."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research paper · engineering and theory"
>
  <Content />
</PaperLayout>
