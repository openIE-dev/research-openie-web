---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/rce-economics.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="The economics companion to the Reality Code Engine paper: the one-path assumption behind the trillion-dollar AI coding race, as an economic error."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Economics essay"
>
  <Content />
</PaperLayout>
