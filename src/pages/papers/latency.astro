---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/latency.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Methods that lower the cost of computer intelligence, the gap before products use them, a cadence model with a forcing-function result, the financing and cost of the infrastructure that runs them, and refutable predictions."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research study"
>
  <Content />
</PaperLayout>
