---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/rce.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="The Reality Code Engine: one Form, many fits. Autonomous coding as a design space, with RCE as one point that optimizes it: the specification, the reference checker and its emitters, the Lean proofs, the dimension of programs, the design of the engine, and protocols."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research paper · Form, engine design, verification, protocols"
>
  <Content />
</PaperLayout>
