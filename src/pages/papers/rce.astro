---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/rce.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="The Reality Code Engine: one Form, many fits. Two paths to autonomy told apart by energy and entropy, the engine, verification, measured results and protocols."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research paper · Form, engine, verification, results"
>
  <Content />
</PaperLayout>
