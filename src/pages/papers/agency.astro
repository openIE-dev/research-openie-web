---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/agency.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="The proposed Universal Law of Agency as a definition plus a gate. Kinematic bounds, intelligence as the derivative of agency in joules, and an optimal tempo."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research paper · definition, kinematic bounds, calculus"
>
  <Content />
</PaperLayout>
