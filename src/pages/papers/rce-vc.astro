---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/rce-vc.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="RCE-VC states a Law of Version Control and reports the reference at openIE-dev/rce-vc, commit 8bf9c9af. Each change is admitted to one name-free repository state or refused with a recorded reason. Wall times were measured on that build. Receipt costs are a stated table. No joules were measured. The reference is not the Reality Code Engine language."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research study, draft: a version-control statement, the M0 to M2 reference, measured wall times, and a stated cost table"
>
  <Content />
</PaperLayout>
