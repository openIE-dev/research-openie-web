---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/rce-vc.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="RCE-VC states a Law of Version Control and reports the reference at openIE-dev/rce-vc, commit aba99fce (49 offline tests). At 100,000 units on Apple M5 Max, admission takes 69.7–73.6 µs and 317–365 µJ L3 reported_j (measured_j = None, board_metered = false). Receipt est_uj costs remain a stated table."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research study, draft: a version-control statement, the M0 to M2 reference at aba99fce, measured wall times, Apple M5 Max reported_j, and a stated cost table"
>
  <Content />
</PaperLayout>
