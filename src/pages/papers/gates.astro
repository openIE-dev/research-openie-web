---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/gates.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="A proposal may not authorize itself. The cheapest sufficient gear runs first. Systems are ranked by the joules needed to reach a correct completion."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research paper · systems"
>
  <Content />
</PaperLayout>
