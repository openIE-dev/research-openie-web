---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/jouleos.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Secure compute requires one law, one meter, and one refusal. A review and design guide for an operating system built on energy to run."
  headings={headings}
  paperId={frontmatter.id}
  genre="Review and design guide"
>
  <Content />
</PaperLayout>
