---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/ai-reads-human.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Software agents exchange data in formats made for people to read. This work in progress defines the extra cost, and reports parse time and token counts on a reproducible corpus. Energy is not yet measured."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research topic, work in progress"
>
  <Content />
</PaperLayout>
