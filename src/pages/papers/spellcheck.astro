---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/spellcheck.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description={`Spell Check is Global: OpenIE economic opinion. Spell check is the existence proof of the automation path. Access framing more than 7 billion people versus fewer than 500 million people. board_synth_claimed=false.`}
  headings={headings}
  paperId={frontmatter.id}
  genre="Economic opinion"
>
  <Content />
</PaperLayout>
