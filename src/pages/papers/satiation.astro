---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/satiation.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Task-level satiation holds once a task is complete. Aggregate demand can still grow. Jevons rebound is the identification problem."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/papers/"
  genre="Research paper · economics"
>
  <Content />
</PaperLayout>
