---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/satiation.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Satiation defines when work is done. After a completeness test holds, more calls add no value. Cheap inference does not mean free energy."
  headings={headings}
  paperId={frontmatter.id}
  genre="Research study · position / definitions"
>
  <Content />
</PaperLayout>
