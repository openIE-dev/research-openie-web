---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/papers/mol.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Mixture of Limits names the floors past which more tokens, parameters, or joules stop buying progress. Compression beats enumeration."
  headings={headings}
  paperId={frontmatter.id}
  genre="Research study · navigation law / soft-ref reference"
>
  <Content />
</PaperLayout>
