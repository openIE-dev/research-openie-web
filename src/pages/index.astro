---
import Layout from '../layouts/Layout.astro';
import homeJsonLd from '../data/home-jsonld.json';

const projects = [
  {
    "id": "agency",
    "title": "Thermodynamic Bounds and an Optimal Tempo for Goal-Holding Agents",
    "deck": "The proposed Universal Law of Agency, stated as a definition plus a gate. Agency comes first: a prediction fixed before the act, coupling to the world through intervention, consequence borne, and a joule budget with refusal on a receipt. Kinematic bounds say how fast agency moves per second and per joule. Intelligence is the derivative of agency in joules, read in hindsight off a completed run. Prediction 1 gives an optimal act time for an agent that holds a goal, with a lab protocol to test it. Energy to run is the only true metric of computer intelligence.",
    "status": "Research paper",
    "group": "research",
    "about": "/about/agency/",
    "paper": "/papers/agency/",
    "pdf": "/pdfs/agency.pdf",
    "figures": "/living/",
    "tags": [
      "proposed Universal Law of Agency",
      "definition plus a gate",
      "kinematic bounds",
      "Prediction 1"
    ]
  },
  {
    "id": "gates",
    "title": "Metered Commit Gates: Energy-to-Correct-Completion for Agentic Systems",
    "deck": "Notational Intelligence and Mixture of Limits in one systems paper. A proposal may not authorize itself: an irreversible act runs only behind a certificate, and every decision is written to a receipt. The cheapest sufficient gear runs first, Lookup, then Formula, then Solver, then Model, and the cascade stops when the task completion predicate holds. Systems are ranked by the joules needed to reach a correct completion. A KV260 board reading gives 11,428 pJ per gate cycle at board level.",
    "status": "Research paper",
    "group": "research",
    "about": "/about/gates/",
    "paper": "/papers/gates/",
    "pdf": "/pdfs/gates.pdf",
    "figures": "/living/ni/",
    "tags": [
      "commit gate",
      "cascade",
      "J*",
      "receipts",
      "KV260 board level"
    ]
  },
  {
    "id": "satiation",
    "title": "Task Satiation vs. Aggregate Rebound in AI Demand",
    "deck": "Task-level satiation holds by definition once a task completion predicate is true: more synthesis on that task buys nothing. Aggregate demand can still grow, because cheaper synthesis opens new tasks and raises total use. The paper separates the two, states hypotheses H1 (spend after completion) and H2 (Jevons in tasks), and gives the data design that would identify them. Capability scales. Appetite per task does not.",
    "status": "Research paper",
    "group": "research",
    "about": "/about/satiation/",
    "paper": "/papers/satiation/",
    "pdf": "/pdfs/satiation.pdf",
    "figures": "/living/satiation/",
    "tags": [
      "task completion",
      "Jevons rebound",
      "H1 and H2",
      "price series"
    ]
  },
  {
    "id": "spellcheck",
    "title": "Spell Check is Global : The Future of Computer Intelligence in the hands of the many (7B+) and not the few (under 500M)",
    "deck": "People used to pay a premium for spell check. Now it is free and bundled into the editor, the browser, and the phone. A history of that path, from dated prices to the local library in every editor. Technology built for global access reaches more than 7 billion people. Scarcity pricing keeps a capability with fewer than 500 million. Energy to run is what remains.",
    "status": "History essay",
    "group": "essay",
    "about": "/about/spellcheck/",
    "paper": "/papers/spellcheck/",
    "pdf": "/pdfs/spellcheck.pdf",
    "figures": "/living/spellcheck/",
    "tags": [
      "history essay",
      "dated prices",
      "bundling",
      "the many"
    ]
  },
  {
    "id": "mei",
    "title": "Metabolic Intelligence: Budget-Native Compute from Tag to Campus",
    "deck": "Metabolic Intelligence is the AI product. A fixed energy budget is the physical condition of the best answer. Work that would break the budget is refused or deferred. It spans coin-cell tags at the edge to a resource-optimized central datacenter and runs on any compute fabric. Klere (klere.ai) is the hardware that builds the Energy Processing Unit (EPU).",
    "status": "Product white paper",
    "group": "product",
    "about": "/products/mei/",
    "paper": "/products/mei/",
    "pdf": "/pdfs/mei.pdf",
    "figures": "/living/mei/",
    "tags": [
      "product white paper",
      "energy budget",
      "Klere",
      "edge and central"
    ]
  },
  {
    "id": "jouleos",
    "title": "The Search for JouleOS",
    "deck": "A review of how secure compute is composed today and a design guide for what a machine must speak if an agent is to be scheduled, metered, and refused. It places the energy-as-resource operating systems that came before, names what they lack, and describes JouleOS: one intent stream lowered onto the coordinate the runtime measured.",
    "status": "Product white paper (review and design guide)",
    "group": "product",
    "about": "/products/jouleos/",
    "paper": "/products/jouleos/",
    "pdf": "/pdfs/jouleos.pdf",
    "figures": "/living/",
    "tags": [
      "product white paper",
      "secure compute",
      "WebAssembly"
    ]
  }
];
const research = projects.filter((p) => p.group !== 'product');
const products = projects.filter((p) => p.group === 'product');
---

<Layout title="Research catalog" description="OpenIE research: three research papers and one history essay. Thermodynamic Bounds and an Optimal Tempo for Goal-Holding Agents, Metered Commit Gates, Task Satiation vs. Aggregate Rebound in AI Demand, and Spell Check is Global. Two product white papers are kept apart.">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(homeJsonLd)} />
  <section class="px-6 md:px-10 pt-16 md:pt-24 pb-12 max-w-7xl mx-auto">
    <p class="section-label mb-4">research.openie.dev</p>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-brand-white max-w-3xl">
      Research catalog
    </h1>
    <p class="mt-6 font-body text-base md:text-lg text-brand-slate max-w-2xl leading-relaxed">
      Three research papers and one history essay. The flagship states the proposed Universal Law of Agency as a definition plus a gate: agency first, kinematic bounds second, and intelligence as the derivative of agency in joules.
      Energy to run is the only true metric of computer intelligence. All other factors collapse to zero.
      Two product white papers sit apart from the research catalog.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/papers/agency/" class="inline-flex items-center font-mono text-xs text-brand-dark bg-brand-amber px-4 py-2.5 rounded-md no-underline hover:bg-brand-gold transition-colors">
        Thermodynamic Bounds and an Optimal Tempo
      </a>
      <a href="/papers/gates/" class="inline-flex items-center font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10 transition-colors">
        Metered Commit Gates
      </a>
      <a href="/papers/satiation/" class="inline-flex items-center font-mono text-xs text-brand-cyan border border-brand-cyan/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-cyan/10 transition-colors">
        Task Satiation vs. Aggregate Rebound
      </a>
      <a href="/papers/spellcheck/" class="inline-flex items-center font-mono text-xs text-brand-gold border border-brand-gold/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-gold/10 transition-colors">
        Spell Check is Global (essay)
      </a>
      <a href="/#products" class="inline-flex items-center font-mono text-xs text-brand-cyan border border-brand-cyan/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-cyan/10 transition-colors">
        Product white papers
      </a>
      <a href="/living/" class="inline-flex items-center font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:bg-brand-slate/10 transition-colors">
        Figures hub
      </a>
      <a href="/glossary/" class="inline-flex items-center font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10 transition-colors">
        Glossary
      </a>
      <a href="/about/" class="inline-flex items-center font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:bg-brand-slate/10 transition-colors">
        About
      </a>
      <a href="/living/fpga-sim/alchitry/" class="inline-flex items-center font-mono text-xs text-brand-cyan border border-brand-cyan/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-cyan/10 transition-colors">
        Alchitry guide
      </a>
    </div>
  </section>

  <section id="universal-law-of-agency" class="px-6 md:px-10 pb-12 max-w-7xl mx-auto">
    <div class="glass-card p-6 md:p-8">
      <p class="section-label mb-3">Research paper · definition, kinematic bounds, calculus</p>
      <h2 class="text-xl md:text-2xl text-brand-white mb-3">Thermodynamic Bounds and an Optimal Tempo for Goal-Holding Agents</h2>
      <p class="font-body text-sm text-brand-slate leading-relaxed max-w-3xl mb-5">
        David Charlot's proposal, the Universal Law of Agency, in order. Agency comes first, and its definition is required. In form it is a definition plus a gate: a prediction fixed before the act, coupling to the world through intervention, consequence borne, and a joule budget with refusal on a receipt.
        The kinematic bounds follow. They say how fast agency moves per second and per joule.
        Intelligence is the calculus of agency. It is read in hindsight off a completed run, as the derivative of agency in joules.
        Energy to run is the only true metric of computer intelligence. All other factors collapse to zero.
        Mixture of Limits is the philosophy. Notational Intelligence is the receipt. Metabolic Intelligence is the product on any fabric. Klere is the hardware.
      </p>
      <a href="/papers/agency/" class="block rounded-lg border border-brand-border p-4 no-underline hover:border-brand-amber/50 transition-colors max-w-xl">
        <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-amber mb-2">Flagship research paper</p>
        <p class="text-brand-white text-sm font-semibold mb-2">The proposed Universal Law of Agency</p>
        <p class="font-body text-xs text-brand-slate leading-relaxed">Proven, demonstrated and opinion sources for each layer. Findings organized by method. Prediction 1, an optimal act time, with a lab protocol and a real meter. Estimates are never measured_j.</p>
        <p class="font-mono text-[10px] text-brand-gray mt-3">/papers/agency/</p>
      </a>
    </div>
  </section>

  <section id="companion-laws" class="px-6 md:px-10 pb-12 max-w-7xl mx-auto">
    <div class="glass-card p-6 md:p-8">
      <p class="section-label mb-3">How the papers fit</p>
      <h2 class="text-xl md:text-2xl text-brand-white mb-3">Definition, gate and cascade, stop</h2>
      <p class="font-body text-sm text-brand-slate leading-relaxed max-w-3xl mb-5">
        The flagship defines agency and bounds its motion. Metered Commit Gates builds the machine: a proposal may not authorize itself, and the cheapest sufficient gear runs first. Task satiation names the stop: once a task is complete, more synthesis on it buys nothing. Analytical estimates are not board power. Package <code class="text-brand-cyan">measured_j</code> is set only when a named meter reads it.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/papers/agency/" class="block rounded-lg border border-brand-border p-4 no-underline hover:border-brand-amber/50 transition-colors">
          <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-amber mb-2">Definition and bounds</p>
          <p class="text-brand-white text-sm font-semibold mb-2">Thermodynamic Bounds and an Optimal Tempo</p>
          <p class="font-body text-xs text-brand-slate leading-relaxed">The proposed Universal Law of Agency as a definition plus a gate. Kinematic bounds per second and per joule. Intelligence as the derivative of agency in joules.</p>
          <p class="font-mono text-[10px] text-brand-gray mt-3">/papers/agency/</p>
        </a>
        <a href="/papers/gates/" class="block rounded-lg border border-brand-border p-4 no-underline hover:border-brand-cyan/50 transition-colors">
          <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-cyan mb-2">Gate and cascade</p>
          <p class="text-brand-white text-sm font-semibold mb-2">Metered Commit Gates</p>
          <p class="font-body text-xs text-brand-slate leading-relaxed">Part I, Notational Intelligence: propose, certify, commit or refuse, receipt. Part II, Mixture of Limits: Lookup → Formula → Solver → Model. Ranked by energy to correct completion.</p>
          <p class="font-mono text-[10px] text-brand-gray mt-3">/papers/gates/</p>
        </a>
        <a href="/papers/satiation/" class="block rounded-lg border border-brand-border p-4 no-underline hover:border-brand-gold/50 transition-colors">
          <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-gold mb-2">Stop</p>
          <p class="text-brand-white text-sm font-semibold mb-2">Task Satiation vs. Aggregate Rebound in AI Demand</p>
          <p class="font-body text-xs text-brand-slate leading-relaxed">Task completion stops spend on a task. Cheaper synthesis can still raise total use. Jevons rebound is the identification problem.</p>
          <p class="font-mono text-[10px] text-brand-gray mt-3">/papers/satiation/</p>
        </a>
      </div>
    </div>
  </section>

  <section id="spell-check" class="px-6 md:px-10 pb-12 max-w-7xl mx-auto">
    <div class="glass-card p-6 md:p-8">
      <p class="section-label mb-3">History essay</p>
      <h2 class="text-xl md:text-2xl text-brand-white mb-3">Spell Check is Global</h2>
      <p class="font-body text-sm text-brand-slate leading-relaxed max-w-3xl mb-5">
        People used to pay a premium for spell check. It cannot be sold anymore. It is free, and it is bundled into the editor, the browser, and the phone.
        That is what happens when a technology is built for global access instead of priced by scarcity.
        Global access is for more than 7 billion people. Scarcity pricing keeps a capability with fewer than 500 million people.
      </p>
      <a href="/papers/spellcheck/" class="block rounded-lg border border-brand-border p-4 no-underline hover:border-brand-gold/50 transition-colors max-w-xl">
        <p class="font-mono text-[10px] tracking-[2px] uppercase text-brand-gold mb-2">Essay</p>
        <p class="text-brand-white text-sm font-semibold mb-2">Spell Check is Global</p>
        <p class="font-body text-xs text-brand-slate leading-relaxed">Lookup, then a short edit, on the machine that already holds the word. A suggestion is a proposal until commit. Further candidates stop when the token is kept.</p>
        <p class="font-mono text-[10px] text-brand-gray mt-3">/papers/spellcheck/</p>
      </a>
    </div>
  </section>

  <section id="catalog" class="px-6 md:px-10 pb-12 max-w-7xl mx-auto">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="section-label mb-2">Catalog</p>
        <h2 class="text-2xl md:text-3xl text-brand-white">Research papers and essay</h2>
      </div>
      <p class="font-mono text-[11px] text-brand-gray hidden sm:block">FPGA board result: KV260, in Metered Commit Gates only</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {research.map((p) => (
        <article class="glass-card p-6 md:p-8 flex flex-col">
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="font-mono text-[10px] tracking-[2px] uppercase text-brand-amber">{p.status}</span>
            <span class="font-mono text-[10px] text-brand-gray">{p.id}</span>
          </div>
          <h3 class="text-xl md:text-2xl text-brand-white mb-3">{p.title}</h3>
          <p class="font-body text-sm text-brand-slate leading-relaxed flex-1">{p.deck}</p>
          <div class="flex flex-wrap gap-2 mt-5 mb-6">
            {p.tags.map((t) => (
              <span class="font-mono text-[10px] px-2 py-1 rounded border border-brand-border text-brand-gray">{t}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={p.paper} class="font-mono text-xs text-brand-amber no-underline hover:text-brand-gold transition-colors">Read →</a>
            <a href={p.pdf} class="font-mono text-xs text-brand-cyan no-underline hover:text-brand-teal transition-colors" download>Download PDF</a>
            <a href={p.figures} class="font-mono text-xs text-brand-slate no-underline hover:text-brand-white transition-colors">Figures</a>
            <a href={p.about} class="font-mono text-xs text-brand-gray no-underline hover:text-brand-white transition-colors">About</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="products" class="px-6 md:px-10 pb-12 max-w-7xl mx-auto">
    <div class="mb-8">
      <p class="section-label mb-2">Product white papers</p>
      <h2 class="text-2xl md:text-3xl text-brand-white">Kept apart from the research catalog</h2>
      <p class="mt-3 font-body text-sm text-brand-slate leading-relaxed max-w-3xl">These describe products. Metabolic Intelligence is the AI product. Klere (klere.ai) is the hardware that builds the Energy Processing Unit (EPU). JouleOS is the operating system design. Research owns the claims. The products embody them.</p>
    </div>
    <div id="metabolic-intelligence" class="mb-6"></div>
    <div id="jouleos"></div>
    <div class="grid md:grid-cols-2 gap-6">
      {products.map((p) => (
        <article class="glass-card p-6 md:p-8 flex flex-col">
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="font-mono text-[10px] tracking-[2px] uppercase text-brand-amber">{p.status}</span>
            <span class="font-mono text-[10px] text-brand-gray">{p.id}</span>
          </div>
          <h3 class="text-xl md:text-2xl text-brand-white mb-3">{p.title}</h3>
          <p class="font-body text-sm text-brand-slate leading-relaxed flex-1">{p.deck}</p>
          <div class="flex flex-wrap gap-2 mt-5 mb-6">
            {p.tags.map((t) => (
              <span class="font-mono text-[10px] px-2 py-1 rounded border border-brand-border text-brand-gray">{t}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={p.paper} class="font-mono text-xs text-brand-amber no-underline hover:text-brand-gold transition-colors">Read →</a>
            <a href={p.pdf} class="font-mono text-xs text-brand-cyan no-underline hover:text-brand-teal transition-colors" download>Download PDF</a>
            <a href={p.figures} class="font-mono text-xs text-brand-slate no-underline hover:text-brand-white transition-colors">Figures</a>
            <a href={p.about} class="font-mono text-xs text-brand-gray no-underline hover:text-brand-white transition-colors">About</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-10 pb-24 max-w-7xl mx-auto">
    <div class="glass-card p-6 md:p-8">
      <p class="section-label mb-3">Measurement</p>
      <h2 class="text-xl text-brand-white mb-3">Research papers, not journal finals</h2>
      <ul class="space-y-2 font-body text-sm text-brand-slate leading-relaxed list-disc pl-5">
        <li>Prose lives at <code class="text-brand-cyan">/papers/</code> and <code class="text-brand-cyan">/products/</code>; real PDFs at <code class="text-brand-cyan">/pdfs/</code>.</li>
        <li>Shared terms: <a href="/glossary/" class="text-brand-cyan no-underline hover:text-brand-teal">/glossary/</a>. About index: <a href="/about/" class="text-brand-cyan no-underline hover:text-brand-teal">/about/</a>.</li>
        <li>Interactive figures stay under <code class="text-brand-cyan">/living/</code>. They are companions, not papers.</li>
        <li>No Notion AI, Elicit, Consensus, or other paid research services in the runtime.</li>
        <li>Claim ledgers bind web, PDF, Medium, demos, and metadata. Forbidden claims stay off the UI.</li>
        <li>Stage C programmed an Alchitry Pt V2 (SRAM; energy still unmetered on Pt V2). AMD Kria KV260 with its onboard INA260: board-level metered A/B/A differences for the WCA gate fabric (11,428 pJ per gate cycle, standard error 129 pJ, N = 4) and the seed fabric (98.0 pJ per seed cycle, standard error 30.8 pJ, N = 4). Board level, not core rail. Not a closed-loop plant joule cost. OpCounter joules elsewhere are analytical estimates, not board power. Guide: <a href="/living/fpga-sim/alchitry/#energy" class="text-brand-cyan no-underline hover:text-brand-teal">/living/fpga-sim/alchitry/#energy</a>.</li>
      </ul>
    </div>
  </section>
</Layout>
