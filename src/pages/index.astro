---
import Layout from '../layouts/Layout.astro';
import homeJsonLd from '../data/home-jsonld.json';
import coverageSummary from '../data/coverage-summary.json';
import gravityWell from '../data/gravity-well.json';
import { getExportedStudies } from '../lib/markdownExport';

const exported = await getExportedStudies();
const gwMap = gravityWell.studies as Record<string, any>;
const clusters = gravityWell.clusters as { id: string; label: string; short: string; description: string }[];
const capstone = gwMap['from-ephemeral-inference-to-compiled-agency'];

const clusterLabels: Record<string, string> = Object.fromEntries(clusters.map((c) => [c.id, c.short]));

const projects = exported.map((s) => {
  const gw = gwMap[s.id] ?? null;
  return {
    id: s.id,
    title: s.title,
    deck: s.summary,
    status: s.kind,
    group: s.group,
    about: s.aboutPath,
    paper: s.path,
    markdown: s.markdownPath,
    pdf: s.pdfPath,
    figures: s.figures,
    hasLiving: s.figures.startsWith('/living/') && s.figures !== '/living/',
    tags: s.keywords.slice(0, 4),
    allKeywords: s.keywords,
    sections: s.headings.map((h) => ({ slug: h.slug, text: h.text })),
    cluster: gw?.cluster ?? 'check-first',
    clusterLabel: clusterLabels[gw?.cluster ?? 'check-first'] ?? 'Check Before Acting',
    plainTitle: gw?.plainTitle ?? s.title,
    oneLineHook: gw?.oneLineHook ?? s.summary,
    everydayAnalogy: gw?.everydayAnalogy ?? '',
    keyNumberPlain: gw?.keyNumberPlain ?? '',
    evidenceClass: gw?.evidenceClass ?? 'unmetered',
    evidenceBadge: gw?.evidenceBadge ?? s.kind,
    readingMinutesPlain: gw?.readingMinutesPlain ?? 1,
    readingMinutesFull: gw?.readingMinutesFull ?? 25,
  };
});

const catalogLd = {
  ...homeJsonLd,
  '@graph': homeJsonLd['@graph'].map((g: any) => {
    if (g['@type'] === 'CollectionPage') {
      return {
        ...g,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: exported.map((s, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: s.url,
            name: s.title,
          })),
        },
      };
    }
    if (g['@type'] === 'WebSite') {
      return {
        ...g,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: 'https://research.openie.dev/?q={search_term_string}',
          },
          'query-input': 'required name=search_term_string',
        },
      };
    }
    return g;
  }),
};

const research = projects.filter((p) => p.group !== 'product');
const products = projects.filter((p) => p.group === 'product');
---

<Layout title="Research catalog" description="OpenIE research in plain words first, with 15-second multilingual films, interactive simulators, signed source sheets, clean Markdown, and full formal papers as a last resort.">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(catalogLd)} />

  <!-- GRAVITY-WELL WELCOMING HERO -->
  <section class="px-6 md:px-10 pt-10 md:pt-16 pb-10 max-w-7xl mx-auto">
    <p class="section-label mb-3">research.openie.dev · Open Public-Benefit Research</p>
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-brand-white max-w-4xl leading-[1.1]">
      Software shouldn't burn supercomputer energy to re-answer routine questions.
    </h1>

    <!-- Crisp 3-Beat And · But · Therefore Plain-English Story -->
    <div class="mt-6 grid md:grid-cols-3 gap-3.5 max-w-6xl">
      <div class="glass-card p-4 border border-emerald-400/30">
        <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-emerald-300 font-semibold mb-1">
          1 · The Setup (And)
        </div>
        <p class="font-body text-sm text-brand-light leading-relaxed m-0">
          Today's neural networks are remarkable at cracking brand-new, open-ended questions across code, science, and language.
        </p>
      </div>
      <div class="glass-card p-4 border border-brand-amber/35">
        <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-brand-amber font-semibold mb-1">
          2 · The Problem (But)
        </div>
        <p class="font-body text-sm text-brand-light leading-relaxed m-0">
          Most real-world software traffic repeats the same routine patterns—and waking a billion-parameter model every single time wastes massive electricity and risks fresh mistakes.
        </p>
      </div>
      <div class="glass-card p-4 border border-brand-cyan/35">
        <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-brand-cyan font-semibold mb-1">
          3 · Our Thesis (Therefore)
        </div>
        <p class="font-body text-sm text-brand-light leading-relaxed m-0">
          Check every permanent action with a tiny safety gate, save tested answers into microsecond lookup tables, and wake giant models only as a last resort.
        </p>
      </div>
    </div>

    <!-- INTERACTIVE 10-SECOND "FEEL THE GRAVITY WELL" MICRO-SIMULATOR -->
    <div
      id="gw-hero-sim"
      class="mt-7 glass-card p-5 md:p-7 border border-brand-amber/40 bg-gradient-to-br from-brand-amber/[0.06] via-brand-navy/60 to-brand-cyan/[0.05]"
    >
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-4">
        <div>
          <span class="font-mono text-[10px] tracking-[0.14em] uppercase px-2.5 py-0.5 rounded bg-brand-amber text-brand-dark font-bold">
            Try It in 10 Seconds · Real Hardware Shunt Joules (@ 6a22dee)
          </span>
          <h2 class="text-lg sm:text-xl font-bold text-brand-white mt-2 m-0">
            Feel the Gravity Well: Re-Ask Every Time vs. Check Once &amp; Look It Up
          </h2>
        </div>

        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Choose an everyday task">
          <button
            type="button"
            data-gw-task="safety"
            aria-pressed="true"
            class="gw-sim-task-btn font-mono text-[11px] px-3 py-1.5 rounded-md border border-brand-amber bg-brand-amber/20 text-brand-amber font-semibold cursor-pointer transition-all"
          >
            🛡️ Check a safety rule
          </button>
          <button
            type="button"
            data-gw-task="route"
            aria-pressed="false"
            class="gw-sim-task-btn font-mono text-[11px] px-3 py-1.5 rounded-md border border-brand-border bg-brand-dark/50 text-brand-slate hover:text-brand-white cursor-pointer transition-all"
          >
            🎫 Route a support ticket
          </button>
          <button
            type="button"
            data-gw-task="parse"
            aria-pressed="false"
            class="gw-sim-task-btn font-mono text-[11px] px-3 py-1.5 rounded-md border border-brand-border bg-brand-dark/50 text-brand-slate hover:text-brand-white cursor-pointer transition-all"
          >
            📋 Parse structured records
          </button>
        </div>
      </div>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] gap-6 items-center">
        <!-- Slider Control -->
        <div class="p-4 rounded-xl border border-brand-border bg-brand-dark/55 space-y-3">
          <label for="gw-sim-slider" class="block font-display text-sm sm:text-base font-bold text-brand-white">
            How many times does this routine question show up?
          </label>
          <div class="flex items-baseline justify-between gap-2">
            <span id="gw-sim-count-label" class="font-display text-2xl sm:text-3xl font-bold text-brand-amber">
              300 times
            </span>
            <span id="gw-sim-saving-pill" class="font-mono text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/45 text-emerald-300 font-bold">
              29.9× less energy
            </span>
          </div>
          <input
            id="gw-sim-slider"
            type="range"
            min="0"
            max="5"
            step="1"
            value="2"
            aria-label="Number of times the routine question repeats"
            class="w-full accent-amber-400 cursor-pointer"
          />
          <div class="flex justify-between font-mono text-[10px] text-brand-gray select-none">
            <span>1×</span>
            <span>25×</span>
            <span>300×</span>
            <span>2,500×</span>
            <span>50k×</span>
            <span>1,000,000×</span>
          </div>
          <p id="gw-sim-verdict" class="font-body text-xs text-brand-light leading-relaxed m-0 pt-1">
            On the very first unseen arrival, both paths wake a neural model—by 300 realistic Zipf(0.85) arrivals, lookup-first cuts physical Jetson Thor shunt energy from 396.3 J down to 13.3 J.
          </p>
        </div>

        <!-- Animated Energy Bar Comparison -->
        <div class="space-y-3.5">
          <div class="p-3.5 rounded-xl border border-rose-400/30 bg-brand-dark/45">
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="font-body text-xs sm:text-sm font-semibold text-rose-200">
                🔥 Re-ask a neural network every single time
              </span>
              <span id="gw-bar-llm-joules" class="font-mono text-xs sm:text-sm font-bold text-rose-300">
                2,641.8 J
              </span>
            </div>
            <div class="h-3.5 w-full rounded-full bg-white/[0.06] overflow-hidden">
              <div
                id="gw-bar-llm-fill"
                class="h-full rounded-full bg-gradient-to-r from-amber-500 to-rose-500 transition-all duration-300"
                style="width: 100%"
              ></div>
            </div>
            <div id="gw-bar-llm-equiv" class="mt-1.5 font-mono text-[11px] text-brand-slate">
              ≈ lights a 10W desk LED bulb for 4.4 minutes
            </div>
          </div>

          <div class="p-3.5 rounded-xl border border-emerald-400/35 bg-emerald-500/[0.05]">
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="font-body text-xs sm:text-sm font-semibold text-emerald-200">
                ⚡ Check once, compile &amp; look it up (Big model = last resort)
              </span>
              <span id="gw-bar-lut-joules" class="font-mono text-xs sm:text-sm font-bold text-emerald-300">
                13.27 J
              </span>
            </div>
            <div class="h-3.5 w-full rounded-full bg-white/[0.06] overflow-hidden">
              <div
                id="gw-bar-lut-fill"
                class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400 transition-all duration-300"
                style="width: 3.4%"
              ></div>
            </div>
            <div id="gw-bar-lut-equiv" class="mt-1.5 font-mono text-[11px] text-emerald-300/90">
              ≈ lights a 10W desk LED bulb for 1.3 seconds (4 KiB lookup + solver cascade)
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[10.5px] text-brand-gray">
            <span id="gw-sim-sensor-note">
              Meter: Jetson AGX Thor TI INA3221 physical DC shunt (measured_j · Signed Provenance · Self-Checked)
            </span>
            <a href="/living/compiled-agency/" class="text-brand-cyan no-underline hover:underline">
              Open Full 4-Substrate Simulator →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 CLEAR ENTRY DOORS -->
    <div class="mt-7 grid md:grid-cols-3 gap-4">
      <div class="glass-card p-5 border border-brand-amber/35 flex flex-col justify-between gap-3">
        <div>
          <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-brand-amber font-semibold mb-1">
            Door 1 · Watch or Listen First
          </div>
          <h2 class="text-lg font-bold text-brand-white m-0">15-Second Plain-Words TV &amp; Radio</h2>
          <p class="mt-1.5 font-body text-xs sm:text-sm text-brand-slate leading-relaxed m-0">
            Every study opens with a 15-second jargon-free video in {coverageSummary.totals.voiced_15s_languages_count} voiced and {coverageSummary.spoken_selector_codes_count} captioned languages, plus {coverageSummary.radio_episodes_count} multi-voice talk episodes.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/tv/" class="inline-flex items-center font-mono text-xs text-brand-dark bg-brand-amber px-3.5 py-2 rounded-md no-underline hover:bg-brand-gold font-semibold">
            ▶ Research TV ({coverageSummary.total_films_count} films)
          </a>
          <a href="/radio/" class="inline-flex items-center font-mono text-xs text-brand-cyan border border-brand-cyan/45 px-3 py-2 rounded-md no-underline hover:bg-brand-cyan/10">
            ◉ Radio ({coverageSummary.radio_episodes_count} eps)
          </a>
        </div>
      </div>

      <div class="glass-card p-5 border border-brand-cyan/35 flex flex-col justify-between gap-3">
        <div>
          <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-brand-cyan font-semibold mb-1">
            Door 2 · Touch Working Models
          </div>
          <h2 class="text-lg font-bold text-brand-white m-0">Browser Simulators &amp; 4-Step Labs</h2>
          <p class="mt-1.5 font-body text-xs sm:text-sm text-brand-slate leading-relaxed m-0">
            Drag sliders on real hardware telemetry in <code>/living/</code> or learn hands-on through 13 guided Predict → Break → Repair → Verify labs.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/living/" class="inline-flex items-center font-mono text-xs text-brand-cyan border border-brand-cyan/50 bg-brand-cyan/10 px-3.5 py-2 rounded-md no-underline hover:bg-brand-cyan/20 font-semibold">
            🔬 Living Figures Hub
          </a>
          <a href="/tutorials/" class="inline-flex items-center font-mono text-xs text-brand-amber border border-brand-amber/40 px-3 py-2 rounded-md no-underline hover:bg-brand-amber/10">
            🎓 13 Guided Labs
          </a>
        </div>
      </div>

      <div class="glass-card p-5 border border-emerald-400/35 flex flex-col justify-between gap-3">
        <div>
          <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-emerald-300 font-semibold mb-1">
            Door 3 · Read at Your Own Altitude
          </div>
          <h2 class="text-lg font-bold text-brand-white m-0">Browse {projects.length} Studies by Plain Question</h2>
          <p class="mt-1.5 font-body text-xs sm:text-sm text-brand-slate leading-relaxed m-0">
            Every study starts with a 1-minute plain-English guide and everyday analogy—keeping the dense formal paper tucked away as a last resort.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="#catalog" class="inline-flex items-center font-mono text-xs text-emerald-200 border border-emerald-400/50 bg-emerald-500/15 px-3.5 py-2 rounded-md no-underline hover:bg-emerald-500/25 font-semibold">
            ↓ Jump to Plain-First Catalog
          </a>
          <a href="/about/" class="inline-flex items-center font-mono text-xs text-brand-slate border border-brand-border px-3 py-2 rounded-md no-underline hover:text-brand-white">
            About Notes
          </a>
        </div>
      </div>
    </div>

    <!-- COMPACT / COLLAPSIBLE VERIFICATION, ACCESSIBILITY & RAW DATA SHELF -->
    <details class="mt-5 glass-card border border-brand-border overflow-hidden">
      <summary class="px-4 py-3 cursor-pointer font-mono text-xs text-brand-slate hover:text-brand-white flex flex-wrap items-center justify-between gap-2 select-none">
        <span>🔍 Verification, Accessibility &amp; Raw Data Shelf ({coverageSummary.studies_count} Source Sheets · {coverageSummary.totals.braille_html_transcripts_count} Braille Transcripts · Blueprint v1.0 · RCE Playground · Data)</span>
        <span class="text-brand-amber">Open Shelf ▾</span>
      </summary>
      <div class="px-4 pb-4 pt-2 border-t border-brand-border flex flex-wrap gap-2.5 font-mono text-xs">
        <a href="/sourcesheets/" class="text-emerald-300 border border-emerald-400/40 px-3 py-1.5 rounded-md no-underline hover:bg-emerald-500/10">
          📑 Source Sheets ({coverageSummary.studies_count} [G0–G12])
        </a>
        <a href="/transcripts/" class="text-brand-cyan border border-brand-cyan/40 px-3 py-1.5 rounded-md no-underline hover:bg-brand-cyan/10">
          ⠃ Braille HTML Transcripts ({coverageSummary.totals.braille_html_transcripts_count})
        </a>
        <a href="/blueprint/" class="text-brand-amber border border-brand-amber/40 px-3 py-1.5 rounded-md no-underline hover:bg-brand-amber/10">
          🌐 Planetary Media Blueprint v1.0 ({coverageSummary.totals.voiced_15s_languages_count} voiced · {coverageSummary.spoken_selector_codes_count} selector langs)
        </a>
        <a href="/coverage.json" class="text-emerald-300 border border-emerald-400/40 px-3 py-1.5 rounded-md no-underline hover:bg-emerald-500/10">
          /coverage.json
        </a>
        <a href="/data/" class="text-brand-slate border border-brand-border px-3 py-1.5 rounded-md no-underline hover:text-brand-white">
          Data &amp; Code
        </a>
        <a href="/glossary/" class="text-brand-slate border border-brand-border px-3 py-1.5 rounded-md no-underline hover:text-brand-white">
          Glossary &amp; 38 AAC Concepts
        </a>
        <a href="https://openie-dev.github.io/rce/" class="text-brand-cyan border border-brand-cyan/40 px-3 py-1.5 rounded-md no-underline hover:bg-brand-cyan/10">
          RCE Playground
        </a>
        <a href="/living/fpga-sim/alchitry/" class="text-brand-cyan border border-brand-cyan/40 px-3 py-1.5 rounded-md no-underline hover:bg-brand-cyan/10">
          Alchitry FPGA Guide
        </a>
      </div>
    </details>

    <!-- FEATURED CAPSTONE SPOTLIGHT CARD (STUDY #29: FROM EPHEMERAL INFERENCE TO COMPILED AGENCY) -->
    {capstone && (
      <div class="mt-7 glass-card p-6 md:p-7 border border-emerald-400/45 bg-gradient-to-r from-emerald-500/[0.08] via-brand-navy/60 to-brand-amber/[0.06]">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-[10px] tracking-[0.14em] uppercase px-2.5 py-0.5 rounded bg-emerald-400 text-[#05120e] font-bold">
              Capstone Position Study (#29)
            </span>
            <span class="font-mono text-[10.5px] text-emerald-300">
              {capstone.evidenceBadge}
            </span>
          </div>
          <span class="font-mono text-[10.5px] text-brand-gray">
            Oct–Nov 2026 6-Model SOTA Hardware Shunt Panel (@ 6a22dee)
          </span>
        </div>

        <h2 class="text-2xl md:text-3xl font-bold text-brand-white m-0">
          <a href="/syndication/medium/from-ephemeral-inference-to-compiled-agency/" class="text-brand-white no-underline hover:text-brand-amber transition-colors">
            {capstone.plainTitle}
          </a>
        </h2>
        <p class="mt-1 font-mono text-xs text-brand-gray">
          Formal title: From Ephemeral Inference to Compiled Agency — A Position Paper on Verifiable, Energy-Accounted Computing
        </p>
        <p class="mt-3 font-body text-sm md:text-base text-brand-light leading-relaxed max-w-4xl">
          {capstone.oneLineHook} <span class="text-brand-slate">{capstone.everydayAnalogy}</span>
        </p>
        <p class="mt-2 font-mono text-xs text-emerald-300">
          Headline result: {capstone.keyNumberPlain}
        </p>

        <details class="gw-card-video-toggle mt-3 rounded-xl border border-brand-border bg-brand-dark/50 overflow-hidden max-w-2xl" data-gw-video-src="/media/tv/films/from-ephemeral-inference-to-compiled-agency-15s.mp4" data-gw-vtt-src="/media/tv/planetary-15s/captions/from-ephemeral-inference-to-compiled-agency/en.vtt">
          <summary class="px-3.5 py-2 cursor-pointer font-mono text-xs text-brand-amber flex items-center justify-between select-none">
            <span>▶ Watch 15-Second Plain-Words Film Right Here</span>
            <span class="text-brand-gray">▾</span>
          </summary>
          <div class="p-2 border-t border-brand-border gw-lazy-video-slot"></div>
        </details>

        <div class="mt-4 flex flex-wrap gap-2.5 font-mono text-xs">
          <a href="/syndication/medium/from-ephemeral-inference-to-compiled-agency/" class="px-3.5 py-2 rounded-md bg-brand-amber text-brand-dark font-bold no-underline hover:bg-brand-gold">
            Open Capstone Essay →
          </a>
          <a href="/living/compiled-agency/" class="px-3.5 py-2 rounded-md border border-emerald-400/50 bg-emerald-500/10 text-emerald-300 no-underline hover:bg-emerald-500/20">
            ⚡ Interactive 4-Substrate Observatory
          </a>
          <a href="/tv/?study=from-ephemeral-inference-to-compiled-agency" class="px-3 py-2 rounded-md border border-brand-amber/40 text-brand-amber no-underline hover:bg-brand-amber/10">
            TV (28 Voiced / 50 Captioned)
          </a>
          <a href="/sourcesheets/from-ephemeral-inference-to-compiled-agency/" class="px-3 py-2 rounded-md border border-brand-cyan/40 text-brand-cyan no-underline hover:bg-brand-cyan/10">
            📑 [G0–G12] Source Sheet
          </a>
          <a href="/data/#compiled-agency" class="px-3 py-2 rounded-md border border-brand-border text-brand-slate no-underline hover:text-brand-white">
            Raw Shunt Receipts (@ 6a22dee)
          </a>
        </div>
      </div>
    )}

    <!-- SEARCH + PLAIN-QUESTION FILTERS -->
    <form id="catalog-search-form" role="search" aria-label="Search research studies, plain ideas, keywords, and sections" class="mt-8 glass-card p-4 md:p-5" onsubmit="return false;">
      <div class="flex flex-col md:flex-row gap-3 md:items-center">
        <div class="flex-1 relative">
          <label for="catalog-search" class="sr-only">Search plain titles, analogies, summaries, keywords, and paper sections</label>
          <input
            id="catalog-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search in plain words or technical terms (e.g. lookup table, safety gate, game replay, spell check, LUT6, JEPA) — press /"
            class="w-full font-body text-sm text-brand-white bg-brand-dark/60 border border-brand-border rounded-md px-3.5 py-2.5 focus:outline-none focus:border-brand-amber"
          />
        </div>
        <button
          id="catalog-search-clear"
          type="button"
          hidden
          class="font-mono text-xs text-brand-slate border border-brand-border px-3 py-2 rounded-md cursor-pointer bg-transparent hover:text-brand-white"
        >
          Reset Filters
        </button>
      </div>

      <!-- Primary Plain-Question Filter Row -->
      <div class="mt-3.5 flex flex-wrap items-center gap-2" role="group" aria-label="Filter by plain question">
        <span class="font-mono text-[10px] tracking-[0.12em] uppercase text-brand-amber mr-1">Plain Question:</span>
        {clusters.map((c, idx) => (
          <button
            type="button"
            data-filter-cluster={c.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            title={c.description}
            class={`cluster-filter-btn font-mono text-[11px] px-2.5 py-1 rounded border cursor-pointer bg-transparent transition-colors ${
              idx === 0
                ? 'border-brand-amber text-brand-amber font-semibold'
                : 'border-brand-border text-brand-slate hover:text-brand-white'
            }`}
          >
            {c.short}
          </button>
        ))}
      </div>

      <!-- Secondary Format Filter Row -->
      <div class="mt-2.5 pt-2.5 border-t border-brand-border/60 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by document type">
          <span class="font-mono text-[10px] tracking-[0.12em] uppercase text-brand-gray mr-1">Format:</span>
