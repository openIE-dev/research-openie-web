---
import Layout from '../layouts/Layout.astro';
import homeJsonLd from '../data/home-jsonld.json';
import coverageSummary from '../data/coverage-summary.json';
import gravityWell from '../data/gravity-well.json';
import { getExportedStudies } from '../lib/markdownExport';

const exported = await getExportedStudies();
const gwMap = gravityWell.studies as Record<string, any>;
const clusters = gravityWell.clusters as { id: string; label: string; short: string; description: string }[];
const capstone = gwMap['from-ephemeral-inference-to-compiled-agency'];

const clusterLabels: Record<string, string> = Object.fromEntries(clusters.map((c) => [c.id, c.short]));

const projects = exported.map((s) => {
  const gw = gwMap[s.id] ?? null;
  return {
    id: s.id,
    title: s.title,
    deck: s.summary,
    status: s.kind,
    group: s.group,
    about: s.aboutPath,
    paper: s.path,
    markdown: s.markdownPath,
    pdf: s.pdfPath,
    figures: s.figures,
    hasLiving: s.figures.startsWith('/living/') && s.figures !== '/living/',
    tags: s.keywords.slice(0, 4),
    allKeywords: s.keywords,
    sections: s.headings.map((h) => ({ slug: h.slug, text: h.text })),
    cluster: gw?.cluster ?? 'check-first',
    clusterLabel: clusterLabels[gw?.cluster ?? 'check-first'] ?? 'Check Before Acting',
    plainTitle: gw?.plainTitle ?? s.title,
    oneLineHook: gw?.oneLineHook ?? s.summary,
    everydayAnalogy: gw?.everydayAnalogy ?? '',
    keyNumberPlain: gw?.keyNumberPlain ?? '',
    evidenceClass: gw?.evidenceClass ?? 'unmetered',
    evidenceBadge: gw?.evidenceBadge ?? s.kind,
    readingMinutesPlain: gw?.readingMinutesPlain ?? 1,
    readingMinutesFull: gw?.readingMinutesFull ?? 25,
  };
});

const catalogLd = {
  ...homeJsonLd,
  '@graph': homeJsonLd['@graph'].map((g: any) => {
    if (g['@type'] === 'CollectionPage') {
      return {
        ...g,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: exported.map((s, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: s.url,
            name: s.title,
          })),
        },
      };
    }
    if (g['@type'] === 'WebSite') {
      return {
        ...g,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: 'https://research.openie.dev/?q={search_term_string}',
          },
          'query-input': 'required name=search_term_string',
        },
      };
    }
    return g;
  }),
};

const research = projects.filter((p) => p.group !== 'product');
const products = projects.filter((p) => p.group === 'product');
---

<Layout title="Research catalog" description="OpenIE research in plain words first, with 15-second multilingual films, interactive simulators, signed source sheets, clean Markdown, and full formal papers as a last resort.">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(catalogLd)} />

  <!-- SECTION 1: LIVING GRAVITY-WELL FULL-VIEWPORT HERO -->
  <section id="hero-stage" class="relative min-h-[86vh] py-28 md:py-40 flex items-center overflow-hidden">
    <!-- Ambient Radial Aurora Glows -->
    <div class="hero-aurora-layer pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>

    <!-- 60fps 2D Canvas: Gravity-Well Harmonic Field (Zero WebGL, Offscreen-Paused) -->
    <canvas
      id="gw-hero-canvas"
      class="pointer-events-none absolute inset-0 w-full h-full z-1"
      aria-hidden="true"
    ></canvas>

    <!-- Bottom Atmospheric Vignette -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-32 z-2 bg-gradient-to-t from-[var(--color-brand-dark)] to-transparent"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 md:px-12">
      <p class="font-mono text-[11px] tracking-[0.24em] uppercase text-brand-amber mb-7">
        Open Public-Benefit Research
      </p>

      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold tracking-[-0.03em] leading-[1.05] text-brand-white max-w-4xl">
        Software shouldn’t burn supercomputer energy to re-answer routine questions.
      </h1>

      <p class="font-body max-w-2xl text-lg md:text-xl text-brand-slate leading-relaxed mt-7">
        Check every permanent action with a tiny safety gate, save verified answers into microsecond lookup tables, and wake giant neural models only as a last resort.
      </p>

      <div class="mt-11 flex flex-wrap items-center gap-4">
        <a
          href="#catalog"
          class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-semibold px-6 py-3.5 rounded-full bg-brand-amber text-[#090b10] no-underline hover:bg-brand-gold transition-all shadow-lg shadow-brand-amber/15"
        >
          Explore {projects.length} Studies ↓
        </a>
        <a
          href="/tv/"
          class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-medium px-6 py-3.5 rounded-full border border-brand-border bg-white/[0.03] text-brand-white no-underline hover:border-brand-amber/50 hover:bg-white/[0.06] transition-all backdrop-blur-md"
        >
          ▶ Watch 15s Stories
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2: CALM EDITORIAL 3-BEAT STORY -->
  <section aria-label="Three-part research thesis" class="py-28 md:py-36 px-6 md:px-12 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14">
      <div class="editorial-reveal pt-7 border-t border-emerald-400/35" style="--reveal-delay: 0ms;">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-emerald-300 font-semibold mb-4">
          01 · The Setup
        </div>
        <p class="font-body text-base md:text-[17px] text-brand-light leading-[1.8] m-0">
          Today’s neural networks are remarkable at cracking brand-new, open-ended questions across code, science, and human language.
        </p>
      </div>

      <div class="editorial-reveal pt-7 border-t border-brand-amber/40" style="--reveal-delay: 90ms;">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-brand-amber font-semibold mb-4">
          02 · The Problem
        </div>
        <p class="font-body text-base md:text-[17px] text-brand-light leading-[1.8] m-0">
          Most real-world software traffic repeats the same routine patterns—and waking a billion-parameter model every single time wastes electricity and invites fresh mistakes.
        </p>
      </div>

      <div class="editorial-reveal pt-7 border-t border-brand-cyan/40" style="--reveal-delay: 180ms;">
        <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-brand-cyan font-semibold mb-4">
          03 · Our Thesis
        </div>
        <p class="font-body text-base md:text-[17px] text-brand-light leading-[1.8] m-0">
          Guard every permanent action with a tiny safety gate, crystallize tested answers into microsecond lookup tables, and wake giant models only when a problem is genuinely new.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: SPACIOUS INTERACTIVE "FEEL THE GRAVITY WELL" STAGE -->
  <section aria-labelledby="gw-sim-heading" class="py-28 md:py-36 px-6 md:px-12 relative">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(ellipse 55% 45% at 50% 50%, rgba(245, 158, 11, 0.06), transparent 72%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-5xl mx-auto editorial-reveal">
      <div class="max-w-2xl mb-12">
        <p class="section-label mb-3">Try It in 10 Seconds · Real Hardware Shunt Joules (@ 6a22dee)</p>
        <h2 id="gw-sim-heading" class="text-3xl sm:text-4xl font-bold tracking-tight text-brand-white">
          Feel the Gravity Well
        </h2>
        <p class="mt-4 font-body text-base md:text-lg text-brand-slate leading-[1.75]">
          Drag the repetition slider below to compare re-asking a neural network every time against checking once and serving repeats from a 4 KiB lookup table.
        </p>
      </div>

      <div
        id="gw-hero-sim"
        class="glass-card p-8 md:p-12 rounded-3xl border border-brand-border bg-gradient-to-br from-brand-amber/[0.04] via-brand-navy/50 to-brand-cyan/[0.04] shadow-2xl"
      >
        <div class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-brand-border">
          <span class="font-mono text-xs text-brand-slate">
            Select an everyday workload:
          </span>

          <div class="flex flex-wrap gap-2" role="group" aria-label="Choose an everyday task">
            <button
              type="button"
              data-gw-task="safety"
              aria-pressed="true"
              class="gw-sim-task-btn font-mono text-xs px-4 py-2 rounded-full border border-brand-amber bg-brand-amber/15 text-brand-amber font-semibold cursor-pointer transition-all"
            >
              🛡️ Check a safety rule
            </button>
            <button
              type="button"
              data-gw-task="route"
              aria-pressed="false"
              class="gw-sim-task-btn font-mono text-xs px-4 py-2 rounded-full border border-brand-border bg-white/[0.02] text-brand-slate hover:text-brand-white cursor-pointer transition-all"
            >
              🎫 Route a support ticket
            </button>
            <button
              type="button"
              data-gw-task="parse"
              aria-pressed="false"
              class="gw-sim-task-btn font-mono text-xs px-4 py-2 rounded-full border border-brand-border bg-white/[0.02] text-brand-slate hover:text-brand-white cursor-pointer transition-all"
            >
              📋 Parse structured records
            </button>
          </div>
        </div>

        <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-10 md:gap-12 items-center pt-8">
          <!-- Slider Control -->
          <div class="space-y-5">
            <label for="gw-sim-slider" class="block font-display text-base sm:text-lg font-semibold text-brand-white">
              How many times does this routine question show up?
            </label>
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <span id="gw-sim-count-label" class="font-display text-3xl sm:text-4xl font-bold text-brand-amber tracking-tight">
                300 times
              </span>
              <span id="gw-sim-saving-pill" class="font-mono text-xs px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-400/40 text-emerald-300 font-bold">
                29.9× less energy
              </span>
            </div>
            <input
              id="gw-sim-slider"
              type="range"
              min="0"
              max="5"
              step="1"
              value="2"
              aria-label="Number of times the routine question repeats"
              class="w-full accent-amber-400 cursor-pointer h-2"
            />
            <div class="flex justify-between font-mono text-[10.5px] text-brand-gray select-none">
              <span>1×</span>
              <span>25×</span>
              <span>300×</span>
              <span>2,500×</span>
              <span>50k×</span>
              <span>1M×</span>
            </div>
            <p id="gw-sim-verdict" class="font-body text-sm text-brand-slate leading-[1.75] m-0 pt-1">
              Across 300 arrivals, verified 4 KiB table hits cost microjoules—so total energy stays flat while re-asking a neural network climbs linearly.
            </p>
          </div>

          <!-- Fluid Animated Energy Bar Comparison -->
          <div class="space-y-6">
            <div class="p-5 rounded-2xl bg-rose-500/[0.04] border border-rose-400/20">
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="font-body text-sm font-medium text-rose-200">
                  Re-ask a neural network every time
                </span>
                <span id="gw-bar-llm-joules" class="font-mono text-sm font-bold text-rose-300">
                  396.27 J
                </span>
              </div>
              <div class="h-3 w-full rounded-full bg-white/[0.06] overflow-hidden">
                <div
                  id="gw-bar-llm-fill"
                  class="h-full rounded-full bg-gradient-to-r from-amber-500 to-rose-500 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
                  style="width: 100%"
                ></div>
              </div>
              <div id="gw-bar-llm-equiv" class="mt-2 font-mono text-[11px] text-brand-slate">
                ≈ lights a 10W desk LED bulb for 39.6 seconds
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-emerald-500/[0.05] border border-emerald-400/25">
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="font-body text-sm font-medium text-emerald-200">
                  Check once, compile &amp; look it up
                </span>
                <span id="gw-bar-lut-joules" class="font-mono text-sm font-bold text-emerald-300">
                  13.27 J
                </span>
              </div>
              <div class="h-3 w-full rounded-full bg-white/[0.06] overflow-hidden">
                <div
                  id="gw-bar-lut-fill"
                  class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
                  style="width: 3.35%"
                ></div>
              </div>
              <div id="gw-bar-lut-equiv" class="mt-2 font-mono text-[11px] text-emerald-300/90">
                ≈ lights a 10W desk LED bulb for 1.3 seconds (4 KiB table + rule cascade)
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-1 font-mono text-[11px] text-brand-gray">
              <span id="gw-sim-sensor-note">
                Meter: Jetson AGX Thor TI INA3221 physical DC shunt (measured_j · Signed Provenance · Self-Checked)
              </span>
              <a href="/living/compiled-agency/" class="text-brand-cyan no-underline hover:underline shrink-0">
                Open 4-Substrate Observatory →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: CLEAN 3 DOORS (WATCH · TOUCH · READ) -->
  <section aria-labelledby="doors-heading" class="py-24 md:py-32 px-6 md:px-12 max-w-6xl mx-auto">
    <div class="max-w-2xl mb-14 editorial-reveal">
      <p class="section-label mb-3">Three Calm Ways In</p>
      <h2 id="doors-heading" class="text-3xl sm:text-4xl font-bold tracking-tight text-brand-white">
        Watch, touch, or read at your own pace
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="glass-card door-card spotlight-card p-8 md:p-10 rounded-3xl flex flex-col justify-between gap-8 editorial-reveal" style="--reveal-delay: 0ms;">
        <div>
          <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-brand-amber font-semibold mb-3">
            Watch
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-brand-white m-0 leading-snug">
            15-Second Plain-Words TV &amp; Radio
          </h3>
          <p class="mt-4 font-body text-sm sm:text-[15px] text-brand-slate leading-[1.75] m-0">
            Every study opens with a 15-second jargon-free video in {coverageSummary.totals.voiced_15s_languages_count} voiced and {coverageSummary.spoken_selector_codes_count} captioned languages, plus {coverageSummary.radio_episodes_count} multi-voice talk episodes.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="/tv/" class="inline-flex items-center font-mono text-xs text-[#090b10] bg-brand-amber px-4 py-2.5 rounded-full no-underline hover:bg-brand-gold font-semibold transition-colors">
            ▶ Research TV ({coverageSummary.total_films_count})
          </a>
          <a href="/radio/" class="inline-flex items-center font-mono text-xs text-brand-cyan px-3 py-2 rounded-full no-underline hover:underline">
            Radio ({coverageSummary.radio_episodes_count}) →
          </a>
        </div>
      </div>

      <div class="glass-card door-card spotlight-card p-8 md:p-10 rounded-3xl flex flex-col justify-between gap-8 editorial-reveal" style="--reveal-delay: 90ms;">
        <div>
          <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-brand-cyan font-semibold mb-3">
            Touch
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-brand-white m-0 leading-snug">
            Browser Simulators &amp; Guided Labs
          </h3>
          <p class="mt-4 font-body text-sm sm:text-[15px] text-brand-slate leading-[1.75] m-0">
            Drag sliders on real hardware telemetry in <code>/living/</code> or step hands-on through 14 guided Predict → Break → Repair → Verify labs.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="/living/" class="inline-flex items-center font-mono text-xs text-brand-cyan border border-brand-cyan/45 bg-brand-cyan/10 px-4 py-2.5 rounded-full no-underline hover:bg-brand-cyan/20 font-semibold transition-colors">
            🔬 Living Figures
          </a>
          <a href="/tutorials/" class="inline-flex items-center font-mono text-xs text-brand-amber px-3 py-2 rounded-full no-underline hover:underline">
            14 Labs →
          </a>
        </div>
      </div>

      <div class="glass-card door-card spotlight-card p-8 md:p-10 rounded-3xl flex flex-col justify-between gap-8 editorial-reveal" style="--reveal-delay: 180ms;">
        <div>
          <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-emerald-300 font-semibold mb-3">
            Read
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-brand-white m-0 leading-snug">
            {projects.length} Studies by Plain Question
          </h3>
          <p class="mt-4 font-body text-sm sm:text-[15px] text-brand-slate leading-[1.75] m-0">
            Every study starts with a 1-minute plain-English guide and everyday analogy—keeping the dense formal paper tucked away until you ask for it.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="#catalog" class="inline-flex items-center font-mono text-xs text-emerald-200 border border-emerald-400/45 bg-emerald-500/15 px-4 py-2.5 rounded-full no-underline hover:bg-emerald-500/25 font-semibold transition-colors">
            ↓ Browse Studies
          </a>
          <a href="/about/" class="inline-flex items-center font-mono text-xs text-brand-slate px-3 py-2 rounded-full no-underline hover:text-brand-white">
            About →
          </a>
        </div>
      </div>
    </div>

    <!-- TUCKED IN PLAIN MODE: CAPSTONE DETAILS & VERIFICATION / ACCESSIBILITY SHELF (Revealed at Depth 2–4) -->
    <div class="gw-hide-in-plain mt-14 space-y-6">
      {capstone && (
        <div class="glass-card p-8 md:p-10 rounded-3xl border border-emerald-400/30 bg-gradient-to-r from-emerald-500/[0.06] via-brand-navy/50 to-brand-amber/[0.04]">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="font-mono text-[10px] tracking-[0.14em] uppercase px-3 py-1 rounded-full bg-emerald-400 text-[#05120e] font-bold">
                Capstone Position Study (#29)
              </span>
              <span class="font-mono text-[11px] text-emerald-300">
                {capstone.evidenceBadge}
              </span>
            </div>
            <span class="font-mono text-[11px] text-brand-gray">
              Oct–Nov 2026 6-Model SOTA Hardware Shunt Panel (@ 6a22dee)
            </span>
          </div>

          <h3 class="text-2xl md:text-3xl font-bold text-brand-white m-0">
            <a href="/syndication/medium/from-ephemeral-inference-to-compiled-agency/" class="text-brand-white no-underline hover:text-brand-amber transition-colors">
              {capstone.plainTitle}
            </a>
          </h3>
          <p class="mt-3 font-body text-sm md:text-base text-brand-light leading-[1.75] max-w-4xl">
            {capstone.oneLineHook} <span class="text-brand-slate">{capstone.everydayAnalogy}</span>
          </p>
          <p class="mt-3 font-mono text-xs text-emerald-300">
            Headline result: {capstone.keyNumberPlain}
          </p>

          <div class="mt-6 flex flex-wrap gap-3 font-mono text-xs">
            <a href="/syndication/medium/from-ephemeral-inference-to-compiled-agency/" class="px-4 py-2 rounded-full bg-brand-amber text-[#090b10] font-bold no-underline hover:bg-brand-gold">
              Open Capstone Essay →
            </a>
            <a href="/living/compiled-agency/" class="px-4 py-2 rounded-full border border-emerald-400/45 bg-emerald-500/10 text-emerald-300 no-underline hover:bg-emerald-500/20">
              ⚡ Interactive 4-Substrate Observatory
            </a>
            <a href="/tv/?study=from-ephemeral-inference-to-compiled-agency" class="px-4 py-2 rounded-full border border-brand-amber/35 text-brand-amber no-underline hover:bg-brand-amber/10">
              TV (28 Voiced / 50 Captioned)
            </a>
            <a href="/sourcesheets/from-ephemeral-inference-to-compiled-agency/" class="px-4 py-2 rounded-full border border-brand-cyan/35 text-brand-cyan no-underline hover:bg-brand-cyan/10">
              📑 [G0–G12] Source Sheet
            </a>
            <a href="/data/#compiled-agency" class="px-4 py-2 rounded-full border border-brand-border text-brand-slate no-underline hover:text-brand-white">
              Raw Shunt Receipts (@ 6a22dee)
            </a>
          </div>
        </div>
      )}

      <details class="glass-card rounded-2xl border border-brand-border overflow-hidden">
        <summary class="px-6 py-4 cursor-pointer font-mono text-xs text-brand-slate hover:text-brand-white flex flex-wrap items-center justify-between gap-2 select-none">
          <span>🔍 Verification, Accessibility &amp; Raw Data Shelf ({coverageSummary.studies_count} Source Sheets · {coverageSummary.totals.braille_html_transcripts_count} Braille Transcripts · Blueprint v1.0 · RCE Playground · Data)</span>
          <span class="text-brand-amber">Open Shelf ▾</span>
        </summary>
        <div class="px-6 pb-5 pt-3 border-t border-brand-border flex flex-wrap gap-2.5 font-mono text-xs">
          <a href="/sourcesheets/" class="text-emerald-300 border border-emerald-400/40 px-3.5 py-1.5 rounded-full no-underline hover:bg-emerald-500/10">
            📑 Source Sheets ({coverageSummary.studies_count} [G0–G12])
          </a>
          <a href="/transcripts/" class="text-brand-cyan border border-brand-cyan/40 px-3.5 py-1.5 rounded-full no-underline hover:bg-brand-cyan/10">
            ⠃ Braille HTML Transcripts ({coverageSummary.totals.braille_html_transcripts_count})
          </a>
          <a href="/blueprint/" class="text-brand-amber border border-brand-amber/40 px-3.5 py-1.5 rounded-full no-underline hover:bg-brand-amber/10">
            🌐 Planetary Media Blueprint v1.0 ({coverageSummary.totals.voiced_15s_languages_count} voiced · {coverageSummary.spoken_selector_codes_count} selector langs)
          </a>
          <a href="/coverage.json" class="text-emerald-300 border border-emerald-400/40 px-3.5 py-1.5 rounded-full no-underline hover:bg-emerald-500/10">
            /coverage.json
          </a>
          <a href="/data/" class="text-brand-slate border border-brand-border px-3.5 py-1.5 rounded-full no-underline hover:text-brand-white">
            Data &amp; Code
          </a>
          <a href="/glossary/" class="text-brand-slate border border-brand-border px-3.5 py-1.5 rounded-full no-underline hover:text-brand-white">
            Glossary &amp; 38 AAC Concepts
          </a>
          <a href="https://openie-dev.github.io/rce/" class="text-brand-cyan border border-brand-cyan/40 px-3.5 py-1.5 rounded-full no-underline hover:bg-brand-cyan/10">
