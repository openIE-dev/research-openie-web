  <script is:inline>
    (function () {
      // 0. 60fps 2D Canvas Living Hero Background: "Gravity-Well Harmonic Field"
      (function initHeroCanvas() {
        var canvas = document.getElementById('gw-hero-canvas');
        var hero = document.getElementById('hero-stage');
        if (!canvas || !hero || !canvas.getContext) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        var width = 0, height = 0, dpr = 1;
        var rafId = 0;
        var inView = true;
        var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var targetX = 0.66, targetY = 0.46;
        var wellX = 0.66, wellY = 0.46;
