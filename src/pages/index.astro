---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: 'ni',
    title: 'Notational Intelligence as Commit Law',
    deck: 'System One decides in software. WCA decides whether the machine is allowed to move.',
    status: 'Living P0 shell',
    about: '/about/ni',
    living: '/papers/ni/',
    tags: ['commit law', 'MCP gate', 'honesty grades'],
  },
  {
    id: 'satiation',
    title: 'Satiation & Scarcity after Free AI',
    deck: 'Capability scales. Appetite does not. Design to done.',
    status: 'Living P0 shell',
    about: '/about/satiation',
    living: '/papers/satiation/',
    tags: ['satiation', 'scarcity', 'bliss surface'],
  },
];
---

<Layout title="Living papers" description="Catalog of OpenIE research projects and living whitepapers. Interactive first; PDF twin; no paid services.">
  <section class="px-6 md:px-10 pt-16 md:pt-24 pb-12 max-w-7xl mx-auto">
    <p class="section-label mb-4">research.openie.dev</p>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-brand-white max-w-3xl">
      Living papers hub
    </h1>
    <p class="mt-6 font-body text-base md:text-lg text-brand-slate max-w-2xl leading-relaxed">
      Dedicated catalog for OpenIE research. Interactive web is canonical; PDF twin maps the same object and claim IDs.
      No paid third-party research services in the product stack.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/living/" class="inline-flex items-center font-mono text-xs text-brand-dark bg-brand-amber px-4 py-2.5 rounded-md no-underline hover:bg-brand-gold transition-colors">
        Open living hub
      </a>
      <a href="/living/pdf-twin/" class="inline-flex items-center font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10 transition-colors">
        PDF twin v0
      </a>
    </div>
  </section>

  <section id="catalog" class="px-6 md:px-10 pb-20 max-w-7xl mx-auto">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="section-label mb-2">Catalog</p>
        <h2 class="text-2xl md:text-3xl text-brand-white">Research projects</h2>
      </div>
      <p class="font-mono text-[11px] text-brand-gray hidden sm:block">board_synth_claimed=false</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((p) => (
        <article class="glass-card p-6 md:p-8 flex flex-col">
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="font-mono text-[10px] tracking-[2px] uppercase text-brand-amber">{p.status}</span>
            <span class="font-mono text-[10px] text-brand-gray">{p.id}</span>
          </div>
          <h3 class="text-xl md:text-2xl text-brand-white mb-3">{p.title}</h3>
          <p class="font-body text-sm text-brand-slate leading-relaxed flex-1">{p.deck}</p>
          <div class="flex flex-wrap gap-2 mt-5 mb-6">
            {p.tags.map((t) => (
              <span class="font-mono text-[10px] px-2 py-1 rounded border border-brand-border text-brand-gray">{t}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={p.living} class="font-mono text-xs text-brand-cyan no-underline hover:text-brand-teal transition-colors">
              Living paper →
            </a>
            <a href={p.about} class="font-mono text-xs text-brand-slate no-underline hover:text-brand-white transition-colors">
              About
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-10 pb-24 max-w-7xl mx-auto">
    <div class="glass-card p-6 md:p-8">
      <p class="section-label mb-3">Contract</p>
      <h2 class="text-xl text-brand-white mb-3">Living paper contract</h2>
      <ul class="space-y-2 font-body text-sm text-brand-slate leading-relaxed list-disc pl-5">
        <li>Interactive web is canonical; PDF is a twin with the same section / object / claim IDs.</li>
        <li>No Notion AI, Elicit, Consensus, or other paid research services in the runtime.</li>
        <li>Claim ledgers bind web, PDF, Medium, demos, and metadata. Forbidden claims stay off the UI.</li>
        <li>Materials also archived under <code class="text-brand-cyan">openie-web/research/</code> for permanence.</li>
      </ul>
    </div>
  </section>
</Layout>
