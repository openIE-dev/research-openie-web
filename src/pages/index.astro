            radiusNorm: 0.10 + ((i * 37) % 100) / 118,
            speed: (0.0014 + ((i * 17) % 10) * 0.00022) * (i % 2 === 0 ? 1 : 0.78),
            eccentricity: 0.56 + ((i * 13) % 10) * 0.025,
            tilt: -0.22 + ((i * 7) % 9) * 0.045,
            size: 1.2 + (i % 4) * 0.55,
            hue: isAmber ? 'amber' : (i % 6 === 0 ? 'emerald' : 'cyan'),
            phase: i * 0.73
          });
        }

        function resize() {
          var rect = hero.getBoundingClientRect();
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = Math.max(1, Math.floor(rect.width));
