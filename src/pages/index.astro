  <script is:inline>
    (function () {
      // 1. Hero 10-Second "Feel the Gravity Well" Micro-Simulator (strictly grounded in @ 6a22dee physical DC shunt measured_j)
      var STOPS = [1, 25, 300, 2500, 50000, 1000000];
      var TASKS = {
        safety: {
          sensor: 'Jetson AGX Thor TI INA3221 physical DC shunt (measured_j · @ 6a22dee Inkling-2-Mini vs 4 KiB LUT + Solver)',
          llmPerQueryJ: 8.806,       // 396.27 J / 45 confirmatory runs on Thor INA3221
          firstCompileJ: 8.82,       // First unseen verification + 4 KiB crystallization
          streamPerQueryJ: 0.04423,  // 13.27 J / 300 queries (includes 7-8% novel escalations; at 300 queries: ~13.27 J vs 396.27 J)
          pureLutHitJ: 0.00001334    // 13.34 µJ Shape D classical guard on Thor INA3221
        },
        route: {
          sensor: 'Jetson AGX Thor TI INA3221 physical DC shunt (measured_j · @ 6a22dee Nemotron-3.5-Bolt-E4B vs Lookup Cascade)',
          llmPerQueryJ: 3.402,       // 153.11 J / 45 runs on Thor INA3221
          firstCompileJ: 3.42,
          streamPerQueryJ: 0.0185,
          pureLutHitJ: 0.00001334
        },
        parse: {
          sensor: 'AMD Kria KV260 TI INA260 SOM_5V_DC physical shunt (measured_j · @ 6a22dee LFM3-1.7B vs 4.78 µJ Shape D)',
          llmPerQueryJ: 12.013,      // 540.57 J / 45 runs on KV260 INA260
          firstCompileJ: 12.02,
          streamPerQueryJ: 0.08337,  // 25.01 J / 300 queries (21.61x cut)
          pureLutHitJ: 0.00000478    // 4.78 µJ Shape D classical best on KV260 INA260
        }
      };

      var activeTask = 'safety';
      var simSlider = document.getElementById('gw-sim-slider');
      var countLbl = document.getElementById('gw-sim-count-label');
      var savingPill = document.getElementById('gw-sim-saving-pill');
      var verdictEl = document.getElementById('gw-sim-verdict');
      var llmJoulesEl = document.getElementById('gw-bar-llm-joules');
      var lutJoulesEl = document.getElementById('gw-bar-lut-joules');
      var llmFill = document.getElementById('gw-bar-llm-fill');
      var lutFill = document.getElementById('gw-bar-lut-fill');
      var llmEquiv = document.getElementById('gw-bar-llm-equiv');
      var lutEquiv = document.getElementById('gw-bar-lut-equiv');
      var sensorNote = document.getElementById('gw-sim-sensor-note');

      function fmtJoules(j) {
        if (j >= 1000000) return (j / 1000000).toFixed(2) + ' MJ';
        if (j >= 1000) return (j / 1000).toFixed(2) + ' kJ';
        if (j >= 1) return j.toFixed(2) + ' J';
        return (j * 1000).toFixed(1) + ' mJ';
      }

      function fmtEveryday(j) {
        // 10-Watt desk LED bulb: 1 second = 10 Joules; typical smartphone battery ≈ 45,000 Joules (12.5 Wh)
        var ledSec = j / 10;
        var phonePct = (j / 45000) * 100;
        if (ledSec < 1) return '≈ lights a 10W desk LED bulb for ' + (ledSec * 1000).toFixed(0) + ' milliseconds';
        if (ledSec < 90) return '≈ lights a 10W desk LED bulb for ' + ledSec.toFixed(1) + ' seconds';
        if (ledSec < 3600) return '≈ lights a 10W desk LED bulb for ' + (ledSec / 60).toFixed(1) + ' minutes (' + phonePct.toFixed(1) + '% of a phone charge)';
        return '≈ lights a 10W desk LED bulb for ' + (ledSec / 3600).toFixed(1) + ' hours (' + (j / 45000).toFixed(1) + ' full smartphone charges)';
      }

      function updateHeroSim() {
        if (!simSlider) return;
        var idx = parseInt(simSlider.value, 10) || 0;
        var n = STOPS[idx] || 300;
        var cfg = TASKS[activeTask] || TASKS.safety;

        // Re-asking a neural model on every routine arrival vs. checking once, compiling into <= 4 KiB LUT, and looking up recurring hits
        var llmTotal = n === 300 && activeTask === 'safety' ? 396.27 : (n === 300 && activeTask === 'parse' ? 540.57 : n * cfg.llmPerQueryJ);
        var lutTotal;
        if (n === 1) {
          lutTotal = cfg.firstCompileJ;
        } else if (n === 300 && activeTask === 'safety') {
          lutTotal = 13.27;
        } else if (n === 300 && activeTask === 'parse') {
          lutTotal = 25.01;
        } else {
          // Sublinear Zipfian novelty tail (~n^0.32 new classes) + microjoule table lookups on all routine repeats
          var novelTail = Math.max(0, Math.pow(n, 0.32) - 1) * cfg.llmPerQueryJ * 0.22;
          lutTotal = cfg.firstCompileJ + novelTail + (n - 1) * cfg.pureLutHitJ;
        }

        var ratio = llmTotal / Math.max(0.001, lutTotal);
        if (countLbl) countLbl.textContent = n === 1 ? '1 time (cold)' : n.toLocaleString('en-US') + ' times';
        if (savingPill) {
          savingPill.textContent = n === 1 ? '1.0× (payback starts next hit)' : (ratio >= 100 ? Math.round(ratio).toLocaleString('en-US') : ratio.toFixed(1)) + '× less energy';
        }
        if (llmJoulesEl) llmJoulesEl.textContent = fmtJoules(llmTotal);
        if (lutJoulesEl) lutJoulesEl.textContent = fmtJoules(lutTotal);
        if (llmFill) llmFill.style.width = '100%';
        if (lutFill) lutFill.style.width = Math.max(1.5, Math.min(100, (lutTotal / llmTotal) * 100)).toFixed(2) + '%';
        if (llmEquiv) llmEquiv.textContent = fmtEveryday(llmTotal);
        if (lutEquiv) lutEquiv.textContent = fmtEveryday(lutTotal) + ' (4 KiB table + rule cascade)';
        if (sensorNote) sensorNote.textContent = 'Meter: ' + cfg.sensor;
        if (verdictEl) {
          verdictEl.textContent = n === 1
            ? 'On a brand-new unseen question (1×), you pay the model once and verify the answer. Drag the slider right to watch what happens as routine traffic repeats.'
            : 'Across ' + n.toLocaleString('en-US') + ' arrivals, verified 4 KiB table hits cost microjoules—so total energy stays flat while re-asking a neural network climbs linearly.';
        }
      }

      if (simSlider) {
        simSlider.addEventListener('input', updateHeroSim);
      }
      document.querySelectorAll('.gw-sim-task-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeTask = btn.getAttribute('data-gw-task') || 'safety';
          document.querySelectorAll('.gw-sim-task-btn').forEach(function (b) {
            var on = b === btn;
            b.setAttribute('aria-pressed', String(on));
            b.className = on
              ? 'gw-sim-task-btn font-mono text-[11px] px-3 py-1.5 rounded-md border border-brand-amber bg-brand-amber/20 text-brand-amber font-semibold cursor-pointer transition-all'
              : 'gw-sim-task-btn font-mono text-[11px] px-3 py-1.5 rounded-md border border-brand-border bg-brand-dark/50 text-brand-slate hover:text-brand-white cursor-pointer transition-all';
          });
          updateHeroSim();
        });
      });
      updateHeroSim();

      // 2. Lazy-load inline 15s video previews inside Study Cards & Sync Depth 4 abstracts
      document.querySelectorAll('.gw-card-video-toggle').forEach(function (det) {
        det.addEventListener('toggle', function () {
          var slot = det.querySelector('.gw-lazy-video-slot');
          if (!slot) return;
          if (det.open) {
            if (!slot.querySelector('video')) {
              var vsrc = det.getAttribute('data-gw-video-src') || '';
              var vtt = det.getAttribute('data-gw-vtt-src') || '';
              var v = document.createElement('video');
              v.controls = true;
              v.playsInline = true;
              v.preload = 'metadata';
              v.className = 'w-full rounded aspect-video bg-black block';
              v.src = vsrc;
              if (vtt) {
                var tr = document.createElement('track');
                tr.kind = 'captions';
                tr.srclang = 'en';
                tr.label = 'English';
                tr.default = true;
                tr.src = vtt;
                v.appendChild(tr);
              }
              slot.appendChild(v);
              v.play().catch(function () {});
            }
          } else {
            var vid = slot.querySelector('video');
            if (vid) vid.pause();
          }
        });
      });

      function syncHomeDepth(depth) {
        document.querySelectorAll('.gw-tech-abstract').forEach(function (det) {
          det.open = depth === 'formal';
        });
      }
      syncHomeDepth(document.documentElement.getAttribute('data-reading-depth') || 'plain');
      window.addEventListener('openie:reading-depth', function (ev) {
        syncHomeDepth((ev && ev.detail && ev.detail.depth) || 'plain');
      });

      // 3. Catalog Search + Plain-Question Cluster + Format Filtering
      var input = document.getElementById('catalog-search');
      var clearBtn = document.getElementById('catalog-search-clear');
      var statusEl = document.getElementById('catalog-search-status');
      var filterBtns = Array.prototype.slice.call(document.querySelectorAll('.cat-filter-btn'));
      var clusterBtns = Array.prototype.slice.call(document.querySelectorAll('.cluster-filter-btn'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('.study-card'));
      var researchSec = document.getElementById('catalog');
      var productsSec = document.getElementById('products');
      var activeGroup = 'all';
      var activeCluster = 'all';

      function applyFilter(queryStr, groupStr, clusterStr, syncUrl) {
        if (typeof queryStr === 'string' && input && input.value !== queryStr) input.value = queryStr;
        if (groupStr) activeGroup = groupStr;
        if (clusterStr) activeCluster = clusterStr;
        var q = String((input && input.value) || '').toLowerCase().trim();
        var terms = q ? q.split(/[^a-z0-9_+.-]+/).filter(function (t) { return t.length > 0; }) : [];
        if (clearBtn) clearBtn.hidden = !q && activeGroup === 'all' && activeCluster === 'all';

        filterBtns.forEach(function (btn) {
          var on = btn.getAttribute('data-filter-group') === activeGroup;
          btn.setAttribute('aria-pressed', String(on));
          btn.className = on
            ? 'cat-filter-btn font-mono text-[11px] px-2.5 py-1 rounded border border-brand-cyan text-brand-cyan cursor-pointer bg-transparent'
            : 'cat-filter-btn font-mono text-[11px] px-2.5 py-1 rounded border border-brand-border text-brand-slate cursor-pointer bg-transparent hover:text-brand-white';
        });

        clusterBtns.forEach(function (btn) {
          var on = btn.getAttribute('data-filter-cluster') === activeCluster;
          btn.setAttribute('aria-pressed', String(on));
          btn.className = on
            ? 'cluster-filter-btn font-mono text-[11px] px-2.5 py-1 rounded border border-brand-amber text-brand-amber font-semibold cursor-pointer bg-transparent transition-colors'
            : 'cluster-filter-btn font-mono text-[11px] px-2.5 py-1 rounded border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer bg-transparent transition-colors';
        });

        var shown = 0, researchShown = 0, productsShown = 0;
        var matchedIds = [];

        cards.forEach(function (card) {
          var g = card.getAttribute('data-study-group') || '';
          var cl = card.getAttribute('data-study-cluster') || '';
          var hasLiv = card.getAttribute('data-has-living') === 'true';
          var hay = card.getAttribute('data-study-haystack') || '';
          var groupOk =
            activeGroup === 'all' ||
            (activeGroup === 'living' ? hasLiv : g === activeGroup);
          var clusterOk = activeCluster === 'all' || cl === activeCluster;
          var textOk = !terms.length || terms.every(function (t) { return hay.indexOf(t) !== -1; });
          var visible = groupOk && clusterOk && textOk;
          card.style.display = visible ? '' : 'none';

          var secBox = card.querySelector('.matched-sections');
          if (secBox) {
            if (visible && terms.length) {
              var secs = [];
              try { secs = JSON.parse(card.getAttribute('data-study-sections') || '[]'); } catch (_e) {}
              var baseUrl = card.getAttribute('data-study-url') || '';
              var hits = secs.filter(function (s) {
                var st = String(s.text || '').toLowerCase();
                return terms.some(function (t) { return t.length > 1 && st.indexOf(t) !== -1; });
              }).slice(0, 3);
              if (hits.length) {
                secBox.innerHTML = '';
                hits.forEach(function (h) {
                  var row = document.createElement('div');
                  row.appendChild(document.createTextNode('↳ '));
                  var link = document.createElement('a');
                  link.setAttribute('href', baseUrl + '#' + encodeURIComponent(h.slug));
                  link.className = 'text-brand-cyan no-underline hover:underline';
                  link.textContent = String(h.text || '');
                  row.appendChild(link);
                  secBox.appendChild(row);
                });
                secBox.classList.remove('hidden');
              } else {
                secBox.innerHTML = '';
                secBox.classList.add('hidden');
              }
            } else {
              secBox.innerHTML = '';
              secBox.classList.add('hidden');
            }
          }

          if (visible) {
            shown += 1;
            matchedIds.push(card.getAttribute('data-study-id'));
            if (g === 'product') productsShown += 1;
            else researchShown += 1;
          }
        });

        if (researchSec) researchSec.style.display = researchShown > 0 || shown === 0 ? '' : 'none';
        if (productsSec) productsSec.style.display = productsShown > 0 ? '' : 'none';

        if (statusEl) {
          statusEl.textContent = (!q && activeGroup === 'all' && activeCluster === 'all')
            ? 'Showing all ' + cards.length + ' studies'
            : 'Matching ' + shown + ' of ' + cards.length + ' studies';
        }

        if (syncUrl !== false && window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
          if (activeGroup && activeGroup !== 'all') url.searchParams.set('group', activeGroup); else url.searchParams.delete('group');
          if (activeCluster && activeCluster !== 'all') url.searchParams.set('cluster', activeCluster); else url.searchParams.delete('cluster');
          window.history.replaceState(null, '', url.pathname + url.search + url.hash);
        }

        return { visible_count: shown, total_count: cards.length, matched_ids: matchedIds, query: q, group: activeGroup, cluster: activeCluster };
      }

      window.__openieApplyCatalogFilter = function (q, g, c) { return applyFilter(q, g, c || 'all', true); };

      if (input) {
        input.addEventListener('input', function () { applyFilter(input.value, activeGroup, activeCluster, true); });
      }
      if (clearBtn) {
        clearBtn.addEventListener('click', function () { applyFilter('', 'all', 'all', true); if (input) input.focus(); });
      }
      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          applyFilter(input ? input.value : '', btn.getAttribute('data-filter-group') || 'all', activeCluster, true);
        });
      });
      clusterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          applyFilter(input ? input.value : '', activeGroup, btn.getAttribute('data-filter-cluster') || 'all', true);
        });
      });
      document.querySelectorAll('.tag-pill').forEach(function (pill) {
        pill.addEventListener('click', function () {
          applyFilter(pill.getAttribute('data-tag-query') || '', activeGroup, activeCluster, true);
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === '/' && input && document.activeElement !== input && !/^(INPUT|TEXTAREA|SELECT)$/.test((document.activeElement && document.activeElement.tagName) || '')) {
          e.preventDefault();
          input.focus();
        }
      });

      var params = new URLSearchParams(window.location.search);
      var initQ = params.get('q') || '';
      var initG = params.get('group') || 'all';
      var initC = params.get('cluster') || 'all';
      if (initQ || initG !== 'all' || initC !== 'all') {
        applyFilter(initQ, initG, initC, false);
      }
    })();
  </script>
</Layout>
