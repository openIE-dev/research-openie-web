---
import Layout from '../../layouts/Layout.astro';
import tvCatalog from '../../data/tv-catalog.json';
import radioFeed from '../../data/radio-feed.json';
import planetaryEasyRead from '../../data/planetary-easy-read.json';

export function getStaticPaths() {
  const tvList = (tvCatalog.studies || []) as any[];
  const radioList = (radioFeed.episodes || []) as any[];
  const tvEasyMap = Object.fromEntries(((planetaryEasyRead.tv_studies || []) as any[]).map((x) => [x.id, x]));
  const radioEasyMap = Object.fromEntries(((planetaryEasyRead.radio_episodes || []) as any[]).map((x) => [x.id, x]));

  const paths: any[] = [];
  for (const st of tvList) {
    paths.push({
      params: { slug: st.id },
      props: { kind: 'tv', item: st, easy: tvEasyMap[st.id] },
    });
  }
  for (const ep of radioList) {
    paths.push({
      params: { slug: ep.id },
      props: { kind: 'radio', item: ep, easy: radioEasyMap[ep.id] },
    });
  }
  return paths;
}

const { kind, item, easy } = Astro.props as { kind: 'tv' | 'radio'; item: any; easy: any };

function fmtTime(sec: number) {
  const s = Math.max(0, Math.floor(sec || 0));
  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
}

const pageTitle = kind === 'tv'
  ? `Braille & Linear Transcript · ${item.short_title}`
  : `Braille & Linear Transcript · Ep ${String(item.number).padStart(2, '0')} ${item.title}`;

const sourceSheetUrl = easy?.source_sheet_url || (kind === 'tv' ? `/sourcesheets/${item.id}/` : '/sourcesheets/');
---

<Layout
  title={pageTitle}
  description={`Deafblind Braille-display-friendly semantic HTML transcript with Easy Read summary, Mulberry and Tawasol AAC symbols, speaker labels, and ranked sound cues for ${item.title}.`}
>
  <article class="max-w-3xl mx-auto px-5 md:px-10 pt-10 pb-24">
    <p class="font-mono text-xs text-brand-cyan mb-2">
      <a href="/transcripts/" class="text-brand-cyan hover:underline">← All 46 Braille HTML Transcripts</a>
      {' · '}
      <span>Zero-Table Linear Layout (Sense International Standard)</span>
    </p>

    <h1 class="font-display text-2xl md:text-4xl font-bold text-brand-white leading-tight mb-4">
      {item.title}
    </h1>

    <nav aria-label="In-page Braille landmarks" class="p-4 rounded-xl border border-brand-border bg-white/[0.02] mb-8">
      <h2 class="font-mono text-xs uppercase tracking-wider text-brand-amber mb-2">Jump to Section</h2>
      <ol class="list-decimal pl-5 space-y-1 font-mono text-xs">
        <li><a href="#easy-read-summary" class="text-brand-amber hover:underline">Easy Read Summary &amp; AAC Core Words</a></li>
        <li><a href="#ranked-sound-cues" class="text-brand-cyan hover:underline">Importance-Ranked Non-Speech [sound] Cues</a></li>
        <li><a href="#spoken-transcript" class="text-emerald-300 hover:underline">Full Speaker-Labeled Spoken Transcript</a></li>
        <li><a href="#verification-links" class="text-brand-light hover:underline">Source Sheet &amp; Primary Artifact Links</a></li>
      </ol>
    </nav>

    <section id="easy-read-summary" aria-labelledby="h-easy-read" class="mb-10">
      <h2 id="h-easy-read" class="font-display text-xl font-bold text-brand-amber mb-3">
        1. Easy Read Summary (One Idea Per Sentence)
      </h2>
      <p class="font-mono text-xs text-brand-slate mb-3">
        AAC Symbols (CC BY-SA 4.0, zero NC pictograms):{' '}
        {(easy?.mulberry_symbols || []).map((s: any) => `${s.core_word} (${s.symbol_id})`).join(' · ')}
      </p>
      <ol class="list-decimal pl-6 space-y-2 font-body text-base text-brand-white leading-relaxed">
        {(easy?.one_idea_sentences || []).map((sent: string) => (
          <li>{sent}</li>
        ))}
      </ol>
      {easy?.visual_overview && (
        <p class="font-body text-sm text-brand-slate mt-4 leading-relaxed">
          <strong>Visual Description Overview:</strong> {easy.visual_overview}
        </p>
      )}
    </section>

    <section id="ranked-sound-cues" aria-labelledby="h-sound-cues" class="mb-10">
      <h2 id="h-sound-cues" class="font-display text-xl font-bold text-brand-cyan mb-3">
        2. Importance-Ranked Non-Speech [sound] &amp; Visual Cues
      </h2>
      <ol class="list-decimal pl-6 space-y-2 font-body text-sm text-brand-light leading-relaxed">
        {(easy?.ranked_sound_cues || []).map((sc: any) => (
          <li>
            <strong>[Priority {sc.priority} · {sc.rank_label} @ {fmtTime(sc.at_sec)}]</strong> {sc.cue}
            {sc.visual_sync ? ` — ${sc.visual_sync}` : ''}
          </li>
        ))}
      </ol>
    </section>

    <section id="spoken-transcript" aria-labelledby="h-spoken" class="mb-10">
      <h2 id="h-spoken" class="font-display text-xl font-bold text-emerald-300 mb-4">
        3. Full Speaker-Labeled Transcript
      </h2>

      {kind === 'tv' ? (
        <div class="space-y-8">
          {(['15s', '45s', '90s', '180s'] as const).map((slot) => {
            const td = item.tiers?.[slot];
            if (!td) return null;
            const cues = (td.cues || []) as any[];
            return (
              <section aria-labelledby={`slot-${slot}`}>
                <h3 id={`slot-${slot}`} class="font-display text-lg font-bold text-brand-white mb-2">
                  Depth Slot: {slot} ({Math.round(td.duration_s)} seconds · Presenter: {item.narrator_name || 'Studio Host'})
                </h3>
                {cues.length > 0 ? (
                  <ol class="list-decimal pl-6 space-y-2 font-body text-base text-brand-light leading-relaxed">
                    {cues.map((c: any) => (
                      <li>
                        <strong>[{fmtTime(c.start)} – {fmtTime(c.end)}] {item.narrator_name || 'Presenter'}:</strong> {c.text}
                      </li>
                    ))}
                  </ol>
                ) : (
                  <p class="font-body text-base text-brand-light leading-relaxed">
                    <strong>[00:00] {item.narrator_name || 'Presenter'}:</strong> {td.transcript}
                  </p>
                )}
              </section>
            );
          })}
        </div>
      ) : (
        <ol class="list-decimal pl-6 space-y-3 font-body text-base text-brand-light leading-relaxed">
          {(item.turns || []).map((t: any) => (
            <li>
              <strong>[{fmtTime(t.start_sec)}] {t.speaker}{t.role ? ` (${t.role.split('·')[0].trim()})` : ''}:</strong> {t.text}
            </li>
          ))}
        </ol>
      )}
    </section>

    <section id="verification-links" aria-labelledby="h-verify" class="pt-6 border-t border-brand-border">
      <h2 id="h-verify" class="font-display text-lg font-bold text-brand-white mb-3">
        4. Verification &amp; Media Links
      </h2>
      <ul class="list-disc pl-6 space-y-1.5 font-mono text-xs">
        <li><a href={sourceSheetUrl} class="text-brand-amber hover:underline">Checkable [G0–G12] Source Sheet ({sourceSheetUrl})</a></li>
        {kind === 'tv' ? (
          <>
            <li><a href={`/tv/?study=${item.id}`} class="text-brand-cyan hover:underline">Open Study in Research TV (/tv/?study={item.id})</a></li>
            <li><a href={item.paper_url} class="text-emerald-300 hover:underline">Read Primary Paper ({item.paper_url})</a></li>
          </>
        ) : (
          <li><a href={`/radio/?ep=${item.id}`} class="text-brand-cyan hover:underline">Listen in Research Radio (/radio/?ep={item.id})</a></li>
        )}
        <li><a href="/coverage.json" class="text-brand-light hover:underline">Canonical Coverage Matrix (/coverage.json)</a></li>
      </ul>
    </section>
  </article>
</Layout>
