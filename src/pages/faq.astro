<Layout title="RCE: frequently asked questions" description="What the Reality Code Engine (RCE) is, why a change of program representation and of unit of account is needed now, what is built, proposed and measured, how energy is labelled, and ten hard questions with the falsifier each maps to.">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  <article class="faq px-4 sm:px-6 md:px-10 pt-12 md:pt-24 pb-20 max-w-3xl mx-auto">
    <p class="section-label mb-4">Reality Code Engine · questions and answers</p>
    <h1 class="text-3xl md:text-5xl font-bold text-brand-white tracking-tight">RCE: frequently asked questions</h1>
    <div class="mt-6 font-body text-base text-brand-slate leading-relaxed space-y-4" set:html={introHtml} />

    <section class="mt-10 glass-card p-5 md:p-6" aria-labelledby="terms-h">
      <h2 id="terms-h" class="font-mono text-[11px] tracking-[2px] uppercase text-brand-gray mb-3">Terms used on this page</h2>
      <dl id="terms" class="space-y-2 font-body text-sm text-brand-slate leading-relaxed">
        {terms.map(([t, d]) => <div><dt class="inline font-semibold text-brand-white">{t}</dt>: <dd class="inline m-0">{d}</dd></div>)}
      </dl>
    </section>

    <nav class="mt-8 faq-toc" aria-label="Questions on this page">
      <p class="font-mono text-[11px] tracking-[2px] uppercase text-brand-gray mb-3">Contents</p>
      <ol class="list-decimal pl-5 space-y-1 font-body text-sm">
        {rendered.map((p) => <li><a href={`#${p.id}`}>{p.title}</a></li>)}
        <li><a href="#sources">Sources</a></li>
      </ol>
    </nav>

    <figure class="mt-10 glass-card p-3 md:p-4">
      <a href="/figures/rce/spec/rce-overview.svg" aria-label="Open the figure full size"><img src="/figures/rce/spec/rce-overview.png" alt="RCE at a glance: source enters the checker, which admits it as a Form P = (S, E, delta, D, lambda) or names the rule it breaks; every step is appended to the hash-chained log D; emitters print the Form as Rust, Python, JavaScript and Scala; a host runs it." width="796" height="436" class="w-full h-auto rounded bg-white" loading="lazy" decoding="async" /></a>
      <figcaption class="mt-3 font-body text-sm text-brand-slate leading-relaxed">Figure 1. RCE at a glance, from the openIE-dev/rce repository (<code>docs/figures/rce-overview.svg</code>). The checker admits a program or names the rule it breaks; an admitted program is a Form; every step is appended to the log D; emitters print it in other languages; a host runs it.</figcaption>
    </figure>

    {rendered.map((p) => (
      <section id={p.id} class="mt-14" aria-labelledby={`${p.id}-h`}>
        <h2 id={`${p.id}-h`} class="font-display text-2xl md:text-3xl font-bold text-brand-white tracking-tight">{p.title}</h2>
        {p.lead && <p class="mt-3 font-body text-base text-brand-slate leading-relaxed">{p.lead}</p>}
        {p.items.map((it) => (
          <div id={it.id} class="mt-8 faq-item">
            <h3 class="font-display text-lg md:text-xl font-semibold text-brand-white leading-snug">{it.q}</h3>
            <div class="mt-3 faq-a font-body text-[15px] md:text-base text-brand-slate leading-relaxed" set:html={it.html} />
          </div>
        ))}
      </section>
    ))}

    <section id="sources" class="mt-16" aria-labelledby="sources-h">
      <h2 id="sources-h" class="font-display text-2xl font-bold text-brand-white tracking-tight">Sources</h2>
      <p class="mt-3 font-body text-sm text-brand-slate leading-relaxed">Numbered in order of first citation on this page. Papers on this site state their own sources; the outside figures above were read in the cited work or in the site paper that quotes it with its page.</p>
      <ol data-refs class="mt-4 space-y-3 font-body text-sm text-brand-slate leading-relaxed list-none pl-0">
        {order.map((k, i) => <li class="faq-ref">[C{i + 1}] <Fragment set:html={SOURCES[k]} /></li>)}
      </ol>
    </section>

    <div class="mt-12 flex flex-wrap gap-3">
      <a href="/papers/rce/" class="inline-flex font-mono text-xs text-brand-dark bg-brand-amber px-4 py-2.5 rounded-md no-underline hover:bg-brand-gold transition-colors">Read the RCE paper</a>
      <a href="/papers/rce-jepa/" class="inline-flex font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10 transition-colors">RCE-JEPA</a>
      <a href="/rce/spec/" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white transition-colors">Specification</a>
      <a href="/data/#rce" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white transition-colors">Data and code</a>
    </div>
  </article>
</Layout>

