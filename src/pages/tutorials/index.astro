---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/tutorials-catalog.json';

const firstLab = catalog.labs[0];
const safeCatalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

<Layout
  title="Interactive Tutorials Hub — 10 Explorable Labs"
  description="Ten interactive 60fps micro-courses across the OpenIE research catalog: predict quantitative outcomes, break naive baselines, engage verified gates, and inspect empirical receipts."
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/tutorials/tutorials.css" />
    <script is:inline>
      (function () {
        if (new URLSearchParams(window.location.search).get('embed') === '1') {
          document.documentElement.classList.add('oe-embed-mode');
        }
      })();
    </script>
  </Fragment>

  <div class="tut-shell">
    <!-- Chromeless iframe header (visible only when ?embed=1&lab=<id>) -->
    <div class="tut-embed-banner">
      <span>OpenIE Interactive Lab · <strong>Predict → Break → Repair → Verify Receipt</strong></span>
      <a id="tut-embed-open-full" href="/tutorials/" target="_blank" rel="noopener" style="color:var(--tut-cyan);text-decoration:none;font-weight:600">
        Open Full 10-Lab Hub ↗
      </a>
    </div>

    <!-- Full Hub Hero (hidden in ?embed=1 mode) -->
    <header class="tut-embed-hide" style="margin-bottom:1.35rem">
      <div class="section-label" style="margin-bottom:0.45rem">
        OpenIE Interactive Tutorials Hub · 10 Explorable Micro-Courses
      </div>
      <h1 style="font-size:clamp(1.75rem,3vw,2.5rem);letter-spacing:-0.02em;margin:0 0 0.55rem">
        Predict. Break It. Crystallize. Verify Receipt.
      </h1>
      <p style="max-width:860px;font-size:0.96rem;line-height:1.65;margin:0 0 0.85rem">
        Ten hands-on mathematical simulations spanning biological quorum gates, cryptographically attested orchestration,
        ten-camp digital enzymatic synthesis, total state machines, Q32.32 cross-OS lockstep, Beneš-routed LUT6 fabrics,
        and salted precomputation horizons.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.9rem;font-family:var(--font-mono);font-size:0.72rem">
        <span class="tone-amber">● Amber = Joules / ATP</span>
        <span class="tone-cyan">● Cyan = Signal / Form</span>
        <span class="tone-emerald">● Emerald = Verified Gate / Receipt</span>
        <span class="tone-rose">● Rose = Drift / Byzantine Fault / Falsifier</span>
      </div>
    </header>

    <!-- Mastery Progress & Track Filter Bar (hidden in ?embed=1 mode) -->
    <section class="tut-progress-bar tut-embed-hide" aria-label="Course progress and track filter">
      <div class="tut-filter-row" role="group" aria-label="Filter labs by track">
        {catalog.tracks.map((tr, i) => (
          <button
            type="button"
            class="tut-chip"
            data-track-filter={tr.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {tr.label}
          </button>
        ))}
      </div>

      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.85rem">
        <span id="tut-mastery-count" style="font-family:var(--font-mono);font-size:0.78rem;font-weight:600;color:var(--tut-emerald)">
          0 / 10 Labs Mastered
        </span>
        <div class="tut-meter-track" aria-hidden="true">
          <div id="tut-mastery-fill" class="tut-meter-fill" style="width:0%"></div>
        </div>
        <button type="button" id="tut-reset-progress" class="tut-btn" style="font-size:0.7rem;padding:0.32rem 0.65rem">
          Reset Progress
        </button>
      </div>
    </section>

    <!-- Main Split Workspace: Left Syllabus Rail + Right Interactive Stage -->
    <div class="tut-layout">
      <aside class="tut-rail" aria-label="Interactive Labs Syllabus">
        <div style="padding:0.3rem 0.5rem 0.6rem;border-bottom:1px solid var(--tut-border);margin-bottom:0.5rem;display:flex;justify-content:space-between;align-items:center">
          <span style="font-family:var(--font-mono);font-size:0.68rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--tut-muted)">
            Syllabus (10 Labs)
          </span>
          <span style="font-family:var(--font-mono);font-size:0.65rem;color:var(--tut-muted)">
            Keys: [ ] · 1–4
          </span>
        </div>
        <div id="tut-rail-list">
          {catalog.labs.map((lab, idx) => (
            <button type="button" class={`tut-lab-item ${idx === 0 ? 'active' : ''}`} data-lab-id={lab.id}>
              <span class="tut-lab-num">{String(lab.number).padStart(2, '0')}</span>
              <span style="flex:1;min-width:0">
                <span style="display:block;font-weight:600;font-size:0.83rem;line-height:1.3">{lab.title}</span>
                <span style="display:block;font-family:var(--font-mono);font-size:0.66rem;color:var(--tut-muted);margin-top:3px">
                  {lab.estimated_minutes} min · {lab.study_id}
                </span>
              </span>
            </button>
          ))}
        </div>
      </aside>

      <section class="tut-stage" aria-live="polite">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.6rem">
          <span id="tut-track-tag" style="font-family:var(--font-mono);font-size:0.72rem;color:var(--tut-amber);text-transform:uppercase;letter-spacing:0.06em">
            {firstLab.track_label} · Lab 01/10
          </span>
          <div style="display:flex;gap:0.45rem;align-items:center">
            <button type="button" id="tut-pause-btn" class="tut-btn" style="padding:0.32rem 0.65rem;font-size:0.7rem">
              ⏸ Pause
            </button>
            <button type="button" id="tut-copy-embed" class="tut-btn tut-embed-hide" style="padding:0.32rem 0.65rem;font-size:0.7rem">
              &lt;/&gt; Embed Lab
            </button>
          </div>
        </div>

        <div>
          <h2 id="tut-title" style="font-size:clamp(1.2rem,2vw,1.55rem);margin:0 0 0.35rem">{firstLab.title}</h2>
          <p id="tut-subtitle" style="margin:0 0 0.55rem;font-size:0.9rem;line-height:1.55;color:var(--tut-muted)">
            {firstLab.subtitle}
          </p>
          <div style="padding:0.55rem 0.8rem;border-radius:8px;border-left:3px solid var(--tut-cyan);background:var(--tut-card-bg);font-size:0.82rem;line-height:1.5">
            <strong class="tone-cyan" style="font-family:var(--font-mono);font-size:0.72rem">CORE MECHANISM: </strong>
            <span id="tut-concept">{firstLab.key_concept}</span>
          </div>
        </div>

        <!-- 4-Step Guided Lesson Stepper -->
        <div id="tut-stepper" class="tut-stepper" role="tablist" aria-label="Four-step guided lesson"></div>

        <!-- 60fps HiDPI Interactive Simulation Canvas + Live Telemetry -->
        <div class="tut-canvas-card">
          <div class="tut-canvas-wrap">
            <canvas id="tut-canvas" aria-label="Interactive mathematical simulation canvas"></canvas>
          </div>
          <div id="tut-telemetry" class="tut-telemetry"></div>
        </div>

        <!-- Declarative Interactive Controls -->
        <div id="tut-controls" class="tut-controls" aria-label="Simulation parameter controls"></div>

        <!-- Active Pedagogical Step Card (Predict / Break / Repair / Verify Receipt) -->
        <div id="tut-lesson-box" class="tut-lesson-box"></div>
      </section>
    </div>
  </div>

  <script id="oe-tutorials-catalog" type="application/json" is:inline set:html={safeCatalogJson}></script>
  <script is:inline src="/tutorials/core.js"></script>
  <script is:inline src="/tutorials/labs-1-3.js"></script>
  <script is:inline src="/tutorials/labs-4-6.js"></script>
  <script is:inline src="/tutorials/labs-7-10.js"></script>
  <script is:inline>
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { window.OE_TUTORIALS.boot(); });
    } else {
      window.OE_TUTORIALS.boot();
    }
  </script>
</Layout>
