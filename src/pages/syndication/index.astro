---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import syndicationCatalog from '../../data/syndication-catalog.json';
import tiktokSnackables from '../../data/tiktok-snackables.json';

const SITE = 'https://research.openie.dev';
const CHRONICLE_SYNDICATION_URL = 'https://blog.openie.dev/syndication/';
const VERIFICATION_URL = 'https://blog.openie.dev/verification/';
const GLOSSARY_URL = 'https://blog.openie.dev/glossary/';
const REPLICATE_URL = 'https://github.com/openIE-dev/openie-research-experiments/tree/main/replicate';

const S: any = syndicationCatalog;
const M: any = S.summary_metrics ?? {};
const studies = (S.studies ?? []) as any[];
const flagships = (S.flagship_launch_pack ?? []) as any[];
const tiktokById: Record<string, any> = Object.fromEntries(
  ((tiktokSnackables.studies ?? []) as any[]).map((t) => [t.id, t])
);

const enrichedStudies = studies.map((st) => {
  const mdPath = path.resolve(process.cwd(), 'public', 'syndication', 'medium', `${st.id}.md`);
  const mdText = fs.existsSync(mdPath) ? fs.readFileSync(mdPath, 'utf-8') : '';
  const tk = tiktokById[st.id] ?? {};
  return {
    ...st,
    medium_markdown: mdText,
    tiktok_real: {
      video_url: st.tiktok?.video_uri ?? tk.video_url ?? `/media/tv/tiktok/${st.id}-tiktok.mp4`,
      poster_url: st.tiktok?.poster_uri ?? tk.poster_url ?? `/media/tv/tiktok/${st.id}-tiktok.jpg`,
      vtt_url: st.tiktok?.vtt_uri ?? tk.vtt_url ?? `/media/tv/tiktok/${st.id}-tiktok.vtt`,
      duration_s: tk.duration_s ?? st.short_vertical_9x16?.duration_s ?? 22,
      bytes: tk.bytes ?? 0,
      sha256: tk.sha256 ?? st.short_vertical_9x16?.sha256 ?? '',
      blake3: st.tiktok?.content_blake3 ?? tk.blake3 ?? '',
      tiktok_caption: st.tiktok?.caption ?? tk.tiktok_caption ?? '',
      tiktok_api_v2_init_payload: st.tiktok?.api_v2_init_payload ?? tk.tiktok_api_v2_init_payload ?? null,
    },
  };
});

const initialStudy =
  enrichedStudies.find((s) => s.id === 'from-ephemeral-inference-to-compiled-agency') ??
  enrichedStudies.find((s) => s.id === 'deterministic-null') ??
  enrichedStudies[0];
const ecoMatrix = S.ecosystems ?? { tiers: [] };
const ecoTiers = (ecoMatrix.tiers ?? []) as any[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'OpenIE Planetary Syndication Studio — Post-Review Audited Flagship Launch Kit, X ↔ Medium Automation & 9:16 TikTok Snackables',
  description:
    'Post-review-remediated syndication bundles (Signed Provenance · Self-Checked) across 28 9:16 (1080x1920 @ 60fps) TikTok vertical films, 28 bidirectional X (Twitter) 5-post threads, 28 canonical Medium imports (blog.openie.dev/posts/<slug>/), and 1-command GitHub replication kits.',
  url: `${SITE}/syndication/`,
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
};

const clientPayload = JSON.stringify({
  studies: enrichedStudies,
});
---

<Layout
  title="Planetary Syndication Studio — Flagship 3 Launch Kit, X ↔ Medium Automation & 9:16 TikTok Snackables"
  description="Post-review-audited syndication workbench (Signed Provenance · Self-Checked): Flagship 3 Launch Kit, X ↔ Medium bidirectional RSS bridge, 28 native 9:16 (1080x1920 @ 60fps) TikTok snackables, and 1-command replication links."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-5 md:px-10 pt-10 pb-24">
    <!-- Hero Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="section-label">Planetary Syndication &amp; Ecosystem Bus · /syndication/</span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-emerald-500/15 text-emerald-300 border border-emerald-400/35">
          Signed Provenance · Self-Checked
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-amber/15 text-brand-amber border border-brand-amber/35">
          57-Entry Chronicle ↔ 28 Era II Medium Imports (`blog.openie.dev/medium/&lt;id&gt;/`)
        </span>
        <span
          id="syn-medium-live-counter"
          class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-emerald-500/15 text-emerald-200 border border-emerald-400/40"
        >
          Live on Medium: 0 / 28 Era II · 0 / 57 Chronicle (15m RSS Sync)
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/35">
          28 × 9:16 TikTok MP4s (1080×1920 @ 60fps · -14 LUFS) · CC0-1.0
        </span>
      </div>

      <h1 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-brand-white leading-tight mb-4">
        Planetary <span class="text-brand-amber">Syndication</span> &amp; <span class="text-brand-cyan">Ecosystem</span> Bus
      </h1>
      <p class="font-body text-base md:text-lg text-brand-slate max-w-4xl leading-relaxed mb-4">
        Every signed <code class="font-mono text-brand-cyan">WAI1</code> research record projects deterministically into <strong>native 9:16 TikTok / Shorts / Reels vertical cuts</strong>, <strong>bidirectional X (Twitter) ↔ Medium 5-post threads and illustrated essays</strong>, and <strong>1-command public replication kits</strong>—carrying explicit <code class="font-mono text-emerald-300">measured_j &perp; reported_j &perp; est_j &perp; unmetered</code> boundaries and finite-sample statistical bounds.
      </p>

      <div class="p-3.5 rounded-xl bg-[#0b1224] border border-emerald-400/30 font-mono text-xs text-brand-slate flex flex-wrap items-center justify-between gap-3 mb-6">
        <div>
          <strong class="text-emerald-300">Gate &amp; Peer-Review Disclosure (`human_in_gate = false`):</strong>{' '}
          All syndication bundles carry <strong>Signed Provenance · Self-Checked</strong> status (cryptographically signed &amp; internally audited by Open Interface Engineering, not externally peer-reviewed).
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={VERIFICATION_URL} target="_blank" rel="noopener noreferrer" class="text-brand-cyan no-underline hover:underline font-semibold">
            Verification &amp; Licensing ↗
          </a>
          <a href={GLOSSARY_URL} target="_blank" rel="noopener noreferrer" class="text-brand-amber no-underline hover:underline font-semibold">
            Epistemic Glossary ↗
          </a>
          <a href={REPLICATE_URL} target="_blank" rel="noopener noreferrer" class="text-emerald-300 no-underline hover:underline font-semibold">
            1-Command Replicate Kit ↗
          </a>
        </div>
      </div>

      <!-- KPI Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Flagship Launch</div>
          <div class="font-display text-2xl font-bold text-emerald-300 mt-1">Top 4 (#0–#3)</div>
          <div class="font-mono text-[11px] text-brand-slate">Post-Review Audited</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">9:16 TikTok Fleet</div>
          <div class="font-display text-2xl font-bold text-emerald-300 mt-1">29 / 29</div>
          <div class="font-mono text-[11px] text-brand-slate">1080×1920 @ 60fps · {tiktokSnackables.total_mb} MB</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">X Thread Fleet</div>
          <div class="font-display text-2xl font-bold text-brand-amber mt-1">{M.x_posts_total ?? 145}</div>
          <div class="font-mono text-[11px] text-brand-slate">29 × 5 Posts · Max {M.x_max_weighted_chars_observed ?? 280}/280</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Medium + Chronicle</div>
          <div id="syn-kpi-medium-live" class="font-display text-2xl font-bold text-brand-cyan mt-1">57 Ready</div>
          <div id="syn-kpi-medium-sub" class="font-mono text-[11px] text-brand-slate">20 Era 0 + 9 Era I + 28 Era II</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">Ecosystems Wired</div>
          <div class="font-display text-2xl font-bold text-brand-white mt-1">{ecoMatrix.ecosystem_entry_count ?? 36}</div>
          <div class="font-mono text-[11px] text-brand-slate">Across 6 Outbound/Inbound Tiers</div>
        </div>
        <div class="glass-card p-3.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-brand-gray">BLAKE3 Ledger</div>
          <div class="font-display text-2xl font-bold text-emerald-300 mt-1">{S.ledger?.entry_count ?? 112}</div>
          <div class="font-mono text-[11px] text-brand-slate">Signed · Self-Checked</div>
        </div>
      </div>

      <!-- Jump Navigation -->
      <nav aria-label="Syndication studio sections" class="mt-6 flex flex-wrap gap-2">
        <a href="#chronicle-57-hub" class="font-mono text-xs px-3 py-1.5 rounded-md bg-brand-cyan text-[#06121a] font-bold no-underline">
          ★ Full 57-Entry Chronicle Hub ↗
        </a>
        <a href="#flagship-launch-kit" class="font-mono text-xs px-3 py-1.5 rounded-md bg-emerald-400 text-[#06121a] font-bold no-underline">
          Flagship Launch Kit (#0–#3)
        </a>
        <a href="#interactive-studio" class="font-mono text-xs px-3 py-1.5 rounded-md bg-brand-amber text-brand-dark font-semibold no-underline">
          1. Interactive 29-Study Workbench
        </a>
        <a href="#all-28-medium-grid" class="font-mono text-xs px-3 py-1.5 rounded-md border border-emerald-400/40 text-emerald-300 no-underline hover:bg-emerald-500/10">
          All 29 Medium Imports &amp; Live Status
        </a>
        <a href="#x-medium-automation" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-amber">
          2. How X ↔ Medium Automation Works
        </a>
        <a href="#ecosystem-matrix" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-border text-brand-light no-underline hover:border-brand-cyan">
          3. Full 6-Tier Broadcast &amp; Ingest Matrix
        </a>
        <a href="/feeds/medium.xml" class="font-mono text-xs px-3 py-1.5 rounded-md border border-emerald-400/40 text-emerald-300 no-underline hover:bg-emerald-500/10">
          RSS: /feeds/medium.xml ↗
        </a>
        <a href="/syndication/ecosystem-matrix.json" class="font-mono text-xs px-3 py-1.5 rounded-md border border-brand-cyan/40 text-brand-cyan no-underline hover:bg-brand-cyan/10">
          JSON: ecosystem-matrix.json ↗
        </a>
      </nav>
    </header>

    <!-- FULL 57-ENTRY CHRONICLE SYNDICATION HUB BANNER -->
    <section id="chronicle-57-hub" class="scroll-mt-24 glass-card p-5 md:p-7 mb-10 border-t-2 border-t-brand-cyan">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="font-mono text-[11px] uppercase tracking-wider text-brand-cyan font-bold">
              Medium-First 3-Era Chronicle Architecture
            </span>
            <span class="px-2 py-0.5 rounded font-mono text-[10px] bg-emerald-500/15 text-emerald-300 border border-emerald-400/35">
              Signed Provenance · Self-Checked
            </span>
            <span
              id="syn-chronicle-live-pill"
              class="px-2 py-0.5 rounded font-mono text-[10px] bg-brand-amber/15 text-brand-amber border border-brand-amber/35"
            >
              Polled via medium-live-status.json
            </span>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-white m-0">
            Full <span class="text-brand-cyan">57-Entry</span> OpenIE Chronicle Syndication Hub
          </h2>
          <p class="font-body text-sm text-brand-slate leading-relaxed mt-2 mb-3">
            While this workbench indexes the <strong>28 Era II research &amp; systems studies</strong> on <code class="font-mono text-brand-cyan">research.openie.dev</code>, the complete three-era Medium-First import queue—covering <strong>20 Era 0 historical whitepapers</strong> (Dec 2025 – Jul 2026), <strong>9 Era I founding essays</strong> (Feb 2026), and <strong>28 Era II studies</strong> (Nov 2026), each with clean <code class="font-mono text-emerald-300">https://blog.openie.dev/medium/&lt;id&gt;/</code> importer HTML embedding <code class="font-mono text-brand-amber">&lt;link rel="canonical" href="https://blog.openie.dev/posts/&lt;id&gt;/"&gt;</code>—lives at <a href={CHRONICLE_SYNDICATION_URL} target="_blank" rel="noopener" class="text-brand-cyan font-semibold">blog.openie.dev/syndication/</a>.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 font-mono text-xs">
            <div class="p-2.5 rounded-lg bg-[#0b1020] border border-brand-border">
              <div class="text-brand-amber font-bold">20 · Era 0 Whitepapers</div>
              <div class="text-[10.5px] text-brand-slate mt-0.5">Verbatim Dec 2025–Jul 2026 + Nov 25 errata</div>
            </div>
            <div class="p-2.5 rounded-lg bg-[#0b1020] border border-brand-border">
              <div class="text-brand-cyan font-bold">9 · Era I Founding Essays</div>
              <div class="text-[10.5px] text-brand-slate mt-0.5">Verbatim Feb 2026 + Nov 25 scope addenda</div>
            </div>
            <div class="p-2.5 rounded-lg bg-[#0b1020] border border-brand-border">
              <div class="text-emerald-300 font-bold">28 · Era II Studies</div>
              <div class="text-[10.5px] text-brand-slate mt-0.5">Nov 2026 studies · 9:16 MP4 + 5-post X</div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2.5 shrink-0 lg:w-[290px]">
          <a
            href={CHRONICLE_SYNDICATION_URL}
            target="_blank"
            rel="noopener"
            class="text-center font-mono text-xs px-4 py-3 rounded-xl bg-brand-cyan text-[#06121a] font-bold no-underline hover:opacity-90 shadow-lg"
          >
            Open Full 57-Entry Chronicle Hub ↗
          </a>
          <a
            href="https://blog.openie.dev/syndication/medium-live-status.json"
            target="_blank"
            rel="noopener"
            class="text-center font-mono text-[11px] px-3 py-2 rounded-lg border border-emerald-400/40 text-emerald-300 no-underline hover:bg-emerald-500/10"
          >
            Live Ledger: medium-live-status.json ↗
          </a>
          <a
            href="https://blog.openie.dev/live/blog-corpus.json"
            target="_blank"
            rel="noopener"
            class="text-center font-mono text-[11px] px-3 py-2 rounded-lg border border-brand-amber/40 text-brand-amber no-underline hover:bg-brand-amber/10"
          >
            57-Entry JSON: blog-corpus.json ↗
          </a>
        </div>
      </div>
    </section>

    <!-- SPOTLIGHT BANNER: FLAGSHIP 3 LAUNCH KIT (POST-REVIEW AUDITED) -->
    <section id="flagship-launch-kit" class="scroll-mt-24 glass-card p-5 md:p-7 mb-12 border-t-2 border-t-brand-amber">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 mb-6 border-b border-brand-border">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="font-mono text-[11px] uppercase tracking-wider text-brand-amber font-bold">
              25 Nov 2026 Outside-Review Recommended Sequence
            </span>
            <span class="px-2 py-0.5 rounded font-mono text-[10px] bg-emerald-500/15 text-emerald-300 border border-emerald-400/35">
              Signed Provenance · Self-Checked
            </span>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-white m-0">
            Flagship Launch Kit <span class="text-emerald-300">(Capstone #0 + Top 3 · Post-Review Audited)</span>
          </h2>
          <p class="font-body text-sm text-brand-slate max-w-3xl mt-1.5 mb-0">
            Our multi-substrate Capstone Position Paper (`#0`) plus three narrowest, externally checkable empirical benchmarks—ready for 1-click Medium canonical import (<code class="font-mono text-brand-cyan">medium.com/p/import</code> &rarr; <code class="font-mono text-emerald-300">open-interface-engineering</code>), native <code class="font-mono text-brand-amber">9:16 60fps</code> TikTok posting, and automatic RSS-triggered 5-post X threads.
          </p>
        </div>
        <div class="font-mono text-[11px] text-brand-slate bg-[#0b1020] p-3 rounded-xl border border-brand-border">
          <div><strong class="text-brand-cyan">Step 1:</strong> Click <em>Copy Blog URL + Import</em> &rarr; paste in Medium</div>
          <div><strong class="text-brand-amber">Step 2:</strong> Add to <code class="text-emerald-300">open-interface-engineering</code> + 5 tags</div>
          <div><strong class="text-emerald-300">Step 3:</strong> <code class="text-brand-white">openie-medium-x-sync.timer</code> posts X thread</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        {flagships.map((f: any) => (
          <div class="p-4 rounded-2xl border border-brand-border bg-[#0b1020] flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                <span class="font-mono text-[11px] font-bold text-brand-amber">
                  Flagship #{f.rank} · `{f.id}`
                </span>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/30">
                    {f.evidence_badge}
                  </span>
                  <span
                    data-medium-ready-pill={f.id}
                    class="font-mono text-[10px] px-2 py-0.5 rounded bg-white/5 text-brand-slate border border-brand-border"
                  >
                    Ready for Medium
                  </span>
                  <a
                    data-medium-live-pill={f.id}
                    href={`https://blog.openie.dev/posts/${f.id}/`}
                    target="_blank"
                    rel="noopener"
                    class="hidden font-mono text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-200 border border-emerald-400/55 no-underline font-semibold"
                  >
                    🟢 Live on Medium ↗
                  </a>
                </div>
              </div>

              <h3 class="font-display text-lg font-bold text-brand-white leading-snug mb-2">
                {f.flagship_title}
              </h3>

              <p class="font-body text-xs text-brand-slate leading-relaxed mb-3">
                {f.narrow_claim}
              </p>

              <div class="p-2.5 rounded-lg bg-[#070b16] border border-brand-border/80 font-mono text-[10.5px] space-y-1.5 mb-3">
                <div>
                  <span class="text-brand-gray">Clean Medium Importer URL:</span>{' '}
                  <a href={`https://blog.openie.dev/medium/${f.id}/`} target="_blank" rel="noopener" class="text-emerald-300 break-all no-underline hover:underline">
                    {`https://blog.openie.dev/medium/${f.id}/`}
                  </a>
                </div>
                <div>
                  <span class="text-brand-gray">Embedded `rel="canonical"`:</span>{' '}
                  <a href={`https://blog.openie.dev/posts/${f.id}/`} target="_blank" rel="noopener" class="text-brand-cyan break-all no-underline hover:underline">
                    {`https://blog.openie.dev/posts/${f.id}/`}
                  </a>
                </div>
                <div>
                  <span class="text-brand-gray">5 Medium Tags (`{f.medium_publication}`):</span>{' '}
                  <span class="text-emerald-300">{(f.medium_tags ?? []).join(', ')}</span>
                </div>
                <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1 border-t border-brand-border/50">
                  <a href={f.paper_path ?? `/papers/${f.id}/`} class="text-brand-amber no-underline hover:underline">{f.paper_label ?? 'Primary Paper →'}</a>
                  <a href={`/syndication/medium/${f.id}/`} class="text-brand-light no-underline hover:underline">Local Mirror →</a>
                  <a href={f.public_repo_url} target="_blank" rel="noopener" class="text-emerald-300 no-underline hover:underline">GitHub Repo ↗</a>
                  <a href={f.replication_kit_url} target="_blank" rel="noopener" class="text-brand-cyan no-underline hover:underline">1-Cmd Replicate ↗</a>
                  {f.companion_url && (
                    <a href={f.companion_url} target="_blank" rel="noopener" class="text-brand-light no-underline hover:underline">
                      {f.companion_label ?? 'Companion'} ↗
                    </a>
                  )}
                </div>
              </div>
            </div>

            <div class="space-y-2 pt-2 border-t border-brand-border/60">
              <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1.5">
                <a
                  href="https://medium.com/p/import"
                  target="_blank"
                  rel="noopener"
                  data-flagship-import={`https://blog.openie.dev/medium/${f.id}/`}
                  class="flagship-import-btn text-center font-mono text-xs px-3 py-2 rounded-lg bg-emerald-400 text-[#06121a] font-bold cursor-pointer no-underline hover:opacity-90"
                >
                  ⚡ 1-Click Medium Import ↗
                </a>
                <button
                  type="button"
                  data-flagship-copy-text={`https://blog.openie.dev/medium/${f.id}/`}
                  class="flagship-copy-meta-btn font-mono text-[11px] px-2.5 py-2 rounded-lg border border-emerald-400/50 text-emerald-300 bg-transparent cursor-pointer hover:bg-emerald-500/15"
                >
                  Copy Import URL
                </button>
              </div>
              <div class="grid grid-cols-2 gap-1.5">
                <button
                  type="button"
                  data-flagship-copy-text={f.narrow_claim}
                  class="flagship-copy-meta-btn font-mono text-[11px] px-2 py-1.5 rounded-lg border border-brand-cyan/40 text-brand-cyan bg-transparent cursor-pointer hover:bg-brand-cyan/15"
                >
                  Copy Subtitle
                </button>
                <button
                  type="button"
                  data-flagship-copy-text={(f.medium_tags ?? []).join(', ')}
                  class="flagship-copy-meta-btn font-mono text-[11px] px-2 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 bg-transparent cursor-pointer hover:bg-emerald-500/15"
                >
                  Copy 5 Tags
                </button>
              </div>
              <div class="grid grid-cols-3 gap-1.5">
                <a
                  href={`/media/tv/tiktok/${f.id}-tiktok.mp4`}
                  download
                  class="text-center font-mono text-[11px] px-2 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 no-underline hover:bg-emerald-500/15"
                >
                  ⬇ 9:16 MP4
                </a>
                <button
                  type="button"
                  data-flagship-x={f.id}
                  class="flagship-copy-x-btn font-mono text-[11px] px-2 py-1.5 rounded-lg border border-brand-amber/40 text-brand-amber bg-transparent cursor-pointer hover:bg-brand-amber/15"
