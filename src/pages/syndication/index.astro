                    </div>
                    <h4 class="font-display text-base font-bold text-brand-white mb-1">{eco.name}</h4>
                    <div class="font-mono text-[10.5px] text-brand-cyan mb-2 break-words">{eco.protocol}</div>
                    <ul class="list-disc pl-4 space-y-1 font-body text-xs text-brand-slate m-0">
                      {(eco.capabilities ?? []).map((cap: string) => (
                        <li>{cap}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="mt-3 pt-2.5 border-t border-brand-border/60 font-mono text-[10px] text-brand-gray break-all">
                    {eco.surface}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ clientPayload }}>
  (function () {
    const DATA = JSON.parse(clientPayload);
    const BY_ID = Object.fromEntries((DATA.studies || []).map((s) => [s.id, s]));

    const selectEl = document.getElementById('syn-study-select');
    const videoEl = document.getElementById('syn-tiktok-video');
    const trackEl = document.getElementById('syn-tiktok-track');
    const dlTiktokEl = document.getElementById('syn-dl-tiktok');
    const vttTiktokEl = document.getElementById('syn-vtt-tiktok');
    const jsonTiktokEl = document.getElementById('syn-json-tiktok');
    const copyTiktokBtn = document.getElementById('syn-copy-tiktok-caption');
    const tiktokMetaEl = document.getElementById('syn-tiktok-meta');

    const xMaxBadgeEl = document.getElementById('syn-x-max-badge');
    const xPostsEl = document.getElementById('syn-x-posts');
    const copyXBtn = document.getElementById('syn-copy-x-thread');
    const xIntentEl = document.getElementById('syn-x-intent');
    const xJsonEl = document.getElementById('syn-x-json');

    const medStatsEl = document.getElementById('syn-med-stats');
    const medImportUrlEl = document.getElementById('syn-med-import-url');
    const medCanonicalUrlEl = document.getElementById('syn-med-canonical-url');
    const activeMedReadyEl = document.getElementById('syn-active-medium-ready');
    const activeMedLiveEl = document.getElementById('syn-active-medium-live');
    const medPaperEl = document.getElementById('syn-med-paper');
    const medReplicateEl = document.getElementById('syn-med-replicate');
    const medTagsEl = document.getElementById('syn-med-tags');
    const medPreviewEl = document.getElementById('syn-med-preview');
    const copyMedMdBtn = document.getElementById('syn-copy-med-md');
    const copyImportBtn = document.getElementById('syn-copy-import-url');
    const launchImportBtn = document.getElementById('syn-launch-medium-import');
    const openMedHtmlEl = document.getElementById('syn-open-med-html');
    const openYamlEl = document.getElementById('syn-open-yaml');

    let activeId = selectEl ? selectEl.value : 'deterministic-null';
    let mediumLiveUrls = {};

    function syncActiveMediumBadge(studyId) {
      const liveUrl = mediumLiveUrls && typeof mediumLiveUrls[studyId] === 'string' ? mediumLiveUrls[studyId] : '';
      const isLive = /^https?:\/\//.test(liveUrl);
      if (activeMedReadyEl) activeMedReadyEl.classList.toggle('hidden', isLive);
      if (activeMedLiveEl) {
        if (isLive) activeMedLiveEl.setAttribute('href', liveUrl);
        activeMedLiveEl.classList.toggle('hidden', !isLive);
      }
    }

    function esc(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function formatXThreadText(st) {
      return (st.x_thread.posts || [])
        .map((p) => '--- Post ' + p.position + '/5 (' + p.weighted_chars + '/280) ---\n' + p.text)
        .join('\n\n');
    }

    function renderStudy(studyId, autoplay) {
      const st = BY_ID[studyId];
      if (!st) return;
      activeId = st.id;
      if (selectEl && selectEl.value !== st.id) selectEl.value = st.id;

      // 1. 9:16 TikTok column
      if (videoEl) {
        videoEl.poster = st.tiktok_real.poster_url;
        if (trackEl) trackEl.src = st.tiktok_real.vtt_url;
        videoEl.src = st.tiktok_real.video_url;
        videoEl.load();
        if (autoplay) videoEl.play().catch(() => {});
      }
      if (dlTiktokEl) dlTiktokEl.href = st.tiktok_real.video_url;
      if (vttTiktokEl) vttTiktokEl.href = st.tiktok_real.vtt_url;
      if (jsonTiktokEl) jsonTiktokEl.href = st.tiktok.bundle_uri;
      if (tiktokMetaEl) {
        tiktokMetaEl.textContent =
          'Duration: ' + st.tiktok_real.duration_s + 's · Signed Provenance · Self-Checked · AIGC Voice (is_aigc: true)';
      }

      // 2. X 5-post thread column
      if (xMaxBadgeEl) {
        xMaxBadgeEl.textContent =
          'Max ' + st.x_thread.max_weighted_chars + '/280 Chars · 0 URLs in #1';
      }
      if (xPostsEl) {
        xPostsEl.innerHTML = (st.x_thread.posts || [])
          .map(
            (p) =>
              '<div class="p-3 rounded-xl border border-brand-border bg-[#0b1020]">' +
              '<div class="flex items-center justify-between gap-2 mb-1.5 font-mono text-[10px]">' +
              '<span class="text-brand-amber font-bold">Post ' +
              p.position +
              '/5 · ' +
              esc(p.role.replace(/_/g, ' ')) +
              '</span>' +
              '<span class="text-brand-cyan">' +
              p.weighted_chars +
              '/280 weighted</span>' +
              '</div>' +
              '<pre class="whitespace-pre-wrap font-body text-xs text-brand-white leading-relaxed m-0">' +
              esc(p.text) +
              '</pre>' +
              (p.position === 1
                ? '<div class="mt-2 px-2 py-1 rounded bg-emerald-500/10 border border-emerald-400/30 font-mono text-[10px] text-emerald-300">🎬 Attached Media: ' +
                  esc(st.short_vertical_9x16.video_uri) +
                  ' (OAuth 1.0a chunked upload · 0 external links in Post 1)</div>'
                : '') +
              '</div>'
          )
          .join('');
      }
      if (xIntentEl && st.x_thread.posts?.[0]) {
        xIntentEl.href =
          'https://x.com/intent/tweet?text=' + encodeURIComponent(st.x_thread.posts[0].text);
      }
      if (xJsonEl) xJsonEl.href = st.x_thread.bundle_uri;

      // 3. Medium column
      if (medStatsEl) {
        medStatsEl.textContent =
          st.medium.word_count + ' words · ' + st.medium.reading_time_min + ' min read';
      }
      const cleanImporterUrl = 'https://blog.openie.dev/medium/' + st.id + '/';
      const canonicalPostUrl = st.medium.canonical_source_url || st.medium.medium_import_url || ('https://blog.openie.dev/posts/' + st.id + '/');
      if (medImportUrlEl) {
        medImportUrlEl.href = cleanImporterUrl;
        medImportUrlEl.textContent = cleanImporterUrl;
      }
      if (medCanonicalUrlEl) {
        medCanonicalUrlEl.href = canonicalPostUrl;
        medCanonicalUrlEl.textContent = canonicalPostUrl;
      }
      syncActiveMediumBadge(st.id);
      if (medPaperEl) medPaperEl.href = st.paper_url;
      if (medReplicateEl) medReplicateEl.href = st.replication_kit_url;
      if (medTagsEl) medTagsEl.textContent = (st.medium.tags || []).join(', ');
      if (medPreviewEl) medPreviewEl.textContent = st.medium_markdown;
      if (openMedHtmlEl) openMedHtmlEl.href = st.medium.canonical_import_uri;
      if (openYamlEl) openYamlEl.href = st.medium.blog_manifest_uri;
    }

    selectEl?.addEventListener('change', () => {
      renderStudy(selectEl.value, false);
      try {
        history.replaceState(null, '', '?study=' + encodeURIComponent(selectEl.value));
      } catch (_) {}
    });

    copyTiktokBtn?.addEventListener('click', () => {
      const st = BY_ID[activeId];
      if (!st) return;
      navigator.clipboard?.writeText(st.tiktok_real.tiktok_caption || '').then(() => {
        copyTiktokBtn.textContent = 'Copied Post-Review TikTok Caption!';
        setTimeout(() => {
          copyTiktokBtn.textContent = 'Copy Post-Review TikTok Caption + Hashtags';
        }, 1600);
      });
    });

    copyXBtn?.addEventListener('click', () => {
      const st = BY_ID[activeId];
      if (!st) return;
      navigator.clipboard?.writeText(formatXThreadText(st)).then(() => {
        copyXBtn.textContent = 'Copied 5-Post Thread!';
        setTimeout(() => {
          copyXBtn.textContent = 'Copy All 5 X Posts';
        }, 1600);
      });
    });

    copyMedMdBtn?.addEventListener('click', () => {
      const st = BY_ID[activeId];
      if (!st) return;
      navigator.clipboard?.writeText(st.medium_markdown || '').then(() => {
        copyMedMdBtn.textContent = 'Copied Markdown!';
        setTimeout(() => {
          copyMedMdBtn.textContent = 'Copy Medium .md';
        }, 1600);
      });
    });

    copyImportBtn?.addEventListener('click', () => {
      const st = BY_ID[activeId];
      if (!st) return;
      const url = 'https://blog.openie.dev/medium/' + st.id + '/';
      navigator.clipboard?.writeText(url).then(() => {
        copyImportBtn.textContent = '✓ Copied Import URL!';
        setTimeout(() => {
          copyImportBtn.textContent = 'Copy Import URL';
        }, 1600);
      });
    });

    launchImportBtn?.addEventListener('click', () => {
      const st = BY_ID[activeId];
      if (!st) return;
      const url = 'https://blog.openie.dev/medium/' + st.id + '/';
      navigator.clipboard?.writeText(url).catch(() => {});
      launchImportBtn.textContent = '✓ Copied — Paste in Medium!';
      setTimeout(() => {
        launchImportBtn.textContent = '⚡ 1-Click Medium Import ↗';
      }, 3000);
    });

    document.querySelectorAll('.flagship-import-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-flagship-import') || '';
        navigator.clipboard?.writeText(url).catch(() => {});
        const orig = btn.textContent;
        btn.textContent = '✓ Copied — Paste!';
        if (btn.tagName !== 'A') {
          window.open('https://medium.com/p/import', '_blank', 'noopener,noreferrer');
        }
        setTimeout(() => {
          btn.textContent = orig;
        }, 2800);
      });
    });

    document.querySelectorAll('.flagship-copy-meta-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const txt = btn.getAttribute('data-flagship-copy-text') || '';
        navigator.clipboard?.writeText(txt).catch(() => {});
        const orig = btn.textContent;
        btn.textContent = '✓ Copied!';
        setTimeout(() => {
          btn.textContent = orig;
        }, 1600);
      });
    });

    document.querySelectorAll('.flagship-copy-x-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-flagship-x') || '';
        const st = BY_ID[id];
        if (!st) return;
        const orig = btn.textContent;
        navigator.clipboard?.writeText(formatXThreadText(st)).then(() => {
          btn.textContent = '✓ Copied!';
          setTimeout(() => {
            btn.textContent = orig;
          }, 1800);
        });
      });
    });

    document.querySelectorAll('.flagship-load-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-flagship-load') || '';
        if (!BY_ID[id]) return;
        renderStudy(id, false);
        document.getElementById('interactive-studio')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    const qp = new URLSearchParams(window.location.search);
    const qStudy = qp.get('study');
    if (qStudy && BY_ID[qStudy]) {
      renderStudy(qStudy, false);
    }

    // Zero-Rebuild "🟢 Live on Medium ↗" Auto-Hydration from blog.openie.dev
    (async function hydrateMediumLiveStatus() {
      const topBadgeEl = document.getElementById('syn-medium-live-counter');
      const kpiValEl = document.getElementById('syn-kpi-medium-live');
      const kpiSubEl = document.getElementById('syn-kpi-medium-sub');
      const chronPillEl = document.getElementById('syn-chronicle-live-pill');
      try {
        const res = await fetch('https://blog.openie.dev/syndication/medium-live-status.json', { cache: 'no-store' });
        if (!res.ok) return;
        const payload = await res.json();
        const urls =
          payload && typeof payload.medium_live_urls === 'object' && payload.medium_live_urls !== null
            ? payload.medium_live_urls
            : {};
        mediumLiveUrls = urls;

        let era2Live = 0;
        let allUrlsCount = 0;
        for (const [slug, url] of Object.entries(urls)) {
          if (typeof url !== 'string' || !/^https?:\/\//.test(url)) continue;
          allUrlsCount += 1;
          if (BY_ID[slug]) era2Live += 1;
          const safeSlug = typeof CSS !== 'undefined' && CSS.escape ? CSS.escape(slug) : slug;
          document.querySelectorAll('[data-medium-ready-pill="' + safeSlug + '"]').forEach((el) => {
            el.classList.add('hidden');
          });
          document.querySelectorAll('[data-medium-live-pill="' + safeSlug + '"]').forEach((el) => {
            el.setAttribute('href', url);
            el.classList.remove('hidden');
          });
        }
        const totalChronicleLive = Math.max(
          allUrlsCount,
          typeof payload.live_medium_count === 'number' ? payload.live_medium_count : 0
        );
        if (topBadgeEl) {
          topBadgeEl.textContent =
            totalChronicleLive > 0
              ? '🟢 Live on Medium: ' + era2Live + ' / 28 Era II · ' + totalChronicleLive + ' / 57 Chronicle'
              : 'Live on Medium: 0 / 28 Era II · 0 / 57 Chronicle (15m RSS Sync)';
        }
        if (kpiValEl) {
          kpiValEl.textContent =
            totalChronicleLive > 0 ? '🟢 ' + era2Live + ' / 28' : '57 Ready';
        }
        if (kpiSubEl) {
          kpiSubEl.textContent =
            totalChronicleLive > 0
              ? totalChronicleLive + ' / 57 Chronicle Live'
              : '20 Era 0 + 9 Era I + 28 Era II';
        }
        if (chronPillEl) {
          chronPillEl.textContent =
            totalChronicleLive > 0
              ? '🟢 ' + totalChronicleLive + ' / 57 Live on Medium'
              : '0 / 57 Live · 15m RSS Sync Armed';
        }
        syncActiveMediumBadge(activeId);
      } catch (_) {}
    })();
  })();
  </script>
</Layout>
