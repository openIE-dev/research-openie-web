---
import Layout from '../layouts/Layout.astro';

const terms = [
  {
    term: 'Periodic Stack',
    def: 'An OpenIE teaching table of allowed acts on a named surface (for example Computation at compute.openie.dev). Mixture of Limits navigates that table. It does not replace it.',
  },
  {
    term: 'replay class',
    def: 'A label on a closed answer that states how the answer was produced. Deterministic closes stay Deterministic. ModelGenerated answers cannot be rewritten as Deterministic.',
  },
  {
    term: 'value of information (VoI)',
    def: 'The expected gain in a stated benefit from one more observation or call, minus its cost. When VoI is zero past a named floor, further spend on that coordinate is refuse success.',
  },
  {
    term: 'soft-ref',
    def: 'The software reference path that proves a study law without board synthesis or package metering. Receipts on that path label energy as estimate and leave measured_j unset until a named meter returns. This is the one meaning taken from the Mixture of Limits paper and used across the catalog.',
  },
  {
    term: 'evidence classes',
    def: 'Modeled means a stated formula. Simulated means a program or Verilog run. Board-measured means a named meter on a stated device and workload. Estimates are not measured_j.',
  },
  {
    term: 'board_synth_claimed',
    def: 'Repository honesty flag. False means this site has not claimed a synthesized, metered FPGA board result for the study. It stays false until a synthesis log and a meter reading exist.',
  },
  {
    term: 'measured_j',
    def: 'Package field for a joule reading from a named meter. Soft-ref closes leave it unset. Catalog and OpCounter figures are estimates, not measured_j.',
  },
  {
    term: 'Klere',
    def: 'Hardware and the product home for Metabolic Intelligence (klere.ai). Metabolic Intelligence is the AI product class and runs on any compute fabric. Klere is not the research claim being sold as the paper.',
  },
  {
    term: 'Metabolic Intelligence',
    def: 'Budget-native computer intelligence. The envelope is the physical condition of the superior answer. Research owns the class. Klere owns the product embodiment.',
  },
  {
    term: 'Mixture of Limits',
    def: 'Navigation law of hybrid interplay among embodiment classes: Lookup, then Formula, then Solver, then Model last, with named floors that stop escalation when more bits stop buying outcomes.',
  },
  {
    term: 'Notational Intelligence',
    def: 'Commit law: propose, then certify, then commit or refuse, then a receipt. The proposer does not authorize itself.',
  },
];
---

<Layout
  title="Glossary"
  description="Shared terms used across the OpenIE research catalog: Periodic Stack, replay class, value of information, soft-ref, and evidence classes, including whether a result was measured on synthesized hardware."
>
  <section class="px-6 md:px-10 pt-16 md:pt-24 pb-20 max-w-3xl mx-auto">
    <p class="section-label mb-4">research.openie.dev</p>
    <h1 class="text-3xl md:text-5xl font-bold text-brand-white tracking-tight">
      Glossary
    </h1>
    <p class="mt-6 font-body text-base text-brand-slate leading-relaxed">
      Terms the papers use. Each paper also keeps a short terms note for the words it needs on the page.
      Soft-ref has one meaning, taken from Mixture of Limits and applied consistently here.
    </p>

    <dl class="mt-10 space-y-6">
      {terms.map((t) => (
        <div class="glass-card p-5 md:p-6">
          <dt class="font-mono text-sm text-brand-amber mb-2">{t.term}</dt>
          <dd class="font-body text-sm text-brand-slate leading-relaxed m-0">{t.def}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="inline-flex font-mono text-xs text-brand-slate border border-brand-border px-4 py-2.5 rounded-md no-underline hover:text-brand-white">Catalog</a>
      <a href="/about/" class="inline-flex font-mono text-xs text-brand-amber border border-brand-amber/40 px-4 py-2.5 rounded-md no-underline hover:bg-brand-amber/10">About index</a>
    </div>
  </section>
</Layout>
