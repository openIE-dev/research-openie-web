---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/products/jouleos.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Product white paper. A review and design guide for an operating system that schedules, meters, and refuses agents under one rule."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/products/"
  genre="Product white paper · review and design guide"
>
  <Content />
</PaperLayout>
