---
import PaperLayout from '../../layouts/PaperLayout.astro';
import { Content, getHeadings, frontmatter } from '../../content/products/mei.md';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  deck={frontmatter.deck}
  status={frontmatter.status}
  author={frontmatter.author}
  figuresHref={frontmatter.figures}
  pdfHref={frontmatter.pdf}
  description="Product white paper. Metabolic Intelligence treats a fixed energy budget as the condition of the best answer, from tag to campus. Klere is the hardware."
  headings={headings}
  paperId={frontmatter.id}
  basePath="/products/"
  genre="Product white paper"
>
  <Content />
</PaperLayout>
