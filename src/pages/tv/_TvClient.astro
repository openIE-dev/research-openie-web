---
interface Props {
  catalog: any;
  ecosystem?: any;
}
const { catalog, ecosystem = { channels: [] } } = Astro.props;
const catalogJson = JSON.stringify(catalog);
const ecosystemJson = JSON.stringify(ecosystem);
---

<script is:inline define:vars={{ catalogJson, ecosystemJson }}>
(function () {
  const CATALOG = JSON.parse(catalogJson);
  const ECOSYSTEM = JSON.parse(ecosystemJson);
  const CHANNELS_BY_ID = Object.fromEntries((ECOSYSTEM.channels || []).map((c) => [c.id, c]));
  const STUDIES = CATALOG.studies || [];
  const TIER_ORDER = ['15s', '45s', '90s', '180s', 'tiktok'];
  const LEGACY_TIER_MAP = {
    '5s': '15s',
    '30s': '45s',
    '60s': '90s',
    '90s': '90s',
    '15s': '15s',
    '45s': '45s',
    '180s': '180s',
    '3m': '180s',
    'tiktok': 'tiktok',
    '9x16': 'tiktok',
    'vertical': 'tiktok',
    'shorts': 'tiktok',
  };
  const byId = Object.fromEntries(STUDIES.map((s) => [s.id, s]));
  const STUDY_ALIASES = {
    'compiled-agency': 'from-ephemeral-inference-to-compiled-agency',
  };
  function resolveStudyId(raw) {
    if (!raw) return '';
    const s = String(raw).trim();
    return STUDY_ALIASES[s] || s;
  }

  let activeStudyId = byId['from-ephemeral-inference-to-compiled-agency']
    ? 'from-ephemeral-inference-to-compiled-agency'
    : (byId['communication-avalanche'] ? 'communication-avalanche' : (STUDIES[0]?.id || 'agency'));
  let activeTier = '90s';
  let playlistMode = null; // null | '15s' | '90s'
  let activeCategory = 'All 29';
  let activeChannelId = null; // null | 'avalanche' | 'stack' | 'compute' | 'synthesis' | 'knowledge' | 'database'
  let searchQuery = '';
  let playbackRate = 1.0;

  const videoEl = document.getElementById('tv-player');
  const trackEl = document.getElementById('tv-track');
  const titleEl = document.getElementById('tv-active-title');
  const catEl = document.getElementById('tv-active-category');
  const hookEl = document.getElementById('tv-active-hook');
  const bulletsEl = document.getElementById('tv-active-bullets');
  const metricEl = document.getElementById('tv-active-metric');
  const energyBadgeEl = document.getElementById('tv-active-energy-tier');
  const energyDiscEl = document.getElementById('tv-active-energy-disc');
  const voiceBadgeEl = document.getElementById('tv-active-voice');
  const voiceProfEl = document.getElementById('tv-active-voice-profile');
  const epistEl = document.getElementById('tv-active-epistemic');
  const cueListEl = document.getElementById('tv-cue-list');
  const playlistStatusEl = document.getElementById('tv-playlist-status');
  const copyBtn = document.getElementById('tv-copy-transcript');

  const linkPaper = document.getElementById('tv-link-paper');
  const linkSourceSheet = document.getElementById('tv-link-sourcesheet');
  const linkBraille = document.getElementById('tv-link-braille');
  const linkFigures = document.getElementById('tv-link-figures');
  const linkTutorial = document.getElementById('tv-link-tutorial');
  const linkPdf = document.getElementById('tv-link-pdf');
  const linkSyndication = document.getElementById('tv-link-syndication');
  const linkAbout = document.getElementById('tv-link-about');
  const jPerMinEl = document.getElementById('tv-active-j-per-min');
  const playerFrameEl = document.getElementById('tv-player-frame');
  const tiktokBarEl = document.getElementById('tv-tiktok-bar');
  const tiktokDlEl = document.getElementById('tv-tiktok-dl');
  const tiktokCopyBtn = document.getElementById('tv-tiktok-copy-caption');
  const syndicateLinkEl = document.getElementById('tv-syndicate-link');

  function normalizeTier(raw) {
    if (!raw) return '90s';
    return LEGACY_TIER_MAP[raw] || (TIER_ORDER.includes(raw) ? raw : '90s');
  }

  function formatSec(sec) {
    const s = Math.max(0, Math.floor(sec));
    const m = Math.floor(s / 60);
    const r = s % 60;
    return String(m).padStart(2, '0') + ':' + String(r).padStart(2, '0');
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function visibleStudyIds() {
    const q = searchQuery.trim().toLowerCase();
    const chObj = activeChannelId ? CHANNELS_BY_ID[activeChannelId] : null;
    const chSet = chObj ? new Set(chObj.tv_studies || []) : null;
    const filtered = STUDIES.filter((s) => {
      if (chSet && !chSet.has(s.id)) return false;
      if (!chSet && !activeCategory.startsWith('All') && s.category !== activeCategory) return false;
      if (!q) return true;
      const hay = [
        s.id, s.title, s.short_title, s.category, s.headline_metric, s.energy_tier,
        s.narrator_name, s.narrator_profile,
        ...(s.plain_bullets || []),
        s.tiers['15s']?.transcript, s.tiers['45s']?.transcript,
        s.tiers['90s']?.transcript, s.tiers['180s']?.transcript,
      ].join(' ').toLowerCase();
      return hay.includes(q);
    }).map((s) => s.id);
    if (chObj && !q) {
      return (chObj.tv_studies || []).filter((id) => byId[id]);
    }
    return filtered;
  }

  function renderCues(study, tier) {
    if (!cueListEl) return;
    const tObj = study.tiers[tier];
    const cues = tObj?.cues || [];
    cueListEl.innerHTML = '';
    cues.forEach((c, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'tv-cue-row w-full text-left px-3 py-2.5 rounded-lg border border-transparent transition-all flex gap-3 items-start cursor-pointer bg-transparent hover:bg-white/5';
      btn.dataset.start = String(c.start);
      btn.dataset.end = String(c.end);
      btn.dataset.idx = String(idx);
      btn.innerHTML =
        '<span class="font-mono text-[11px] text-brand-cyan shrink-0 pt-0.5">' + formatSec(c.start) + '</span>' +
        '<span class="font-body text-[13px] text-brand-light leading-snug">' + escHtml(c.text) + '</span>';
      btn.addEventListener('click', () => {
        if (videoEl) {
          videoEl.currentTime = c.start;
          videoEl.play().catch(() => {});
        }
      });
      cueListEl.appendChild(btn);
    });
  }

  function syncActiveCue() {
    if (!videoEl || !cueListEl) return;
    const t = videoEl.currentTime;
    const rows = cueListEl.querySelectorAll('.tv-cue-row');
    rows.forEach((r) => {
      const s0 = parseFloat(r.dataset.start || '0');
      const s1 = parseFloat(r.dataset.end || '0');
      const active = t >= s0 - 0.08 && t <= s1 + 0.18;
      r.classList.toggle('tv-cue-active', active);
      if (active) {
        const box = cueListEl;
        const top = r.offsetTop - box.offsetTop;
        if (top < box.scrollTop || top + r.offsetHeight > box.scrollTop + box.clientHeight) {
          box.scrollTo({ top: Math.max(0, top - 48), behavior: 'smooth' });
        }
      }
    });
  }

  function updateUIState(autoplay) {
    const study = byId[activeStudyId] || STUDIES[0];
    if (!study) return;
    const tObj = study.tiers[activeTier] || study.tiers['90s'];

    if (titleEl) titleEl.textContent = study.title;
    if (catEl) catEl.textContent = study.category;
    if (hookEl) hookEl.textContent = tObj.hook;
    if (bulletsEl) {
      bulletsEl.innerHTML = (study.plain_bullets || [])
        .map((b) => '<li>' + escHtml(b) + '</li>')
        .join('');
    }
    if (metricEl) metricEl.textContent = study.headline_metric;
    if (energyBadgeEl) energyBadgeEl.textContent = study.energy_tier;
    if (energyDiscEl) energyDiscEl.textContent = study.energy_disclosure;
    if (voiceBadgeEl) {
      voiceBadgeEl.textContent = 'Voice: ' + (study.narrator_name || 'Studio') + ' · ElevenLabs v4 Studio';
      voiceBadgeEl.title = study.narrator_profile || '';
    }
    if (voiceProfEl) {
      voiceProfEl.textContent = 'Presenter Profile: ' + (study.narrator_profile || 'ElevenLabs v4 Studio');
    }

    if (epistEl) {
      const tagMeanings = { T: 'Math Proof', E: 'Empirical Test', M: 'Model Run', S: 'Open Question' };
      epistEl.innerHTML = (study.epistemic_tags || [])
        .map((tg) => '<span class="px-2 py-0.5 rounded font-mono text-[10.5px] border border-brand-cyan/35 text-brand-cyan bg-brand-cyan/10" title="' + escHtml(tagMeanings[tg] || tg) + '">' + escHtml(tagMeanings[tg] || tg) + '</span>')
        .join('');
    }

    if (linkPaper) linkPaper.href = study.paper_url;
    if (linkSourceSheet) linkSourceSheet.href = '/sourcesheets/' + study.id + '/';
    if (linkBraille) linkBraille.href = '/transcripts/' + study.id + '/';
    if (linkFigures) linkFigures.href = study.figures_url;
    if (linkTutorial) linkTutorial.href = '/tutorials/?lab=' + study.tutorial_lab_id;
    if (linkPdf) linkPdf.href = study.pdf_url;
    if (linkSyndication) linkSyndication.href = '/syndication/?study=' + study.id;
    if (linkAbout) linkAbout.href = study.about_url;
    if (jPerMinEl && study.j_per_min_label) {
      jPerMinEl.textContent = study.j_per_min_label;
    }

    const isVertical = activeTier === 'tiktok';
    if (playerFrameEl) {
      playerFrameEl.classList.toggle('aspect-video', !isVertical);
      playerFrameEl.classList.toggle('aspect-[9/16]', isVertical);
      playerFrameEl.classList.toggle('max-w-[380px]', isVertical);
      playerFrameEl.classList.toggle('mx-auto', isVertical);
    }
    if (tiktokBarEl) {
      tiktokBarEl.classList.toggle('hidden', !isVertical);
    }
    if (tiktokDlEl && study.tiers?.tiktok) {
      tiktokDlEl.href = study.tiers.tiktok.video_url;
    }
    if (syndicateLinkEl) {
      syndicateLinkEl.href = '/syndication/?study=' + study.id;
    }

    document.querySelectorAll('[data-tier-btn]').forEach((b) => {
      const isAct = b.getAttribute('data-tier-btn') === activeTier;
      b.classList.toggle('tv-pill-active', isAct);
      b.setAttribute('aria-pressed', String(isAct));
    });

    document.querySelectorAll('[data-playlist-btn]').forEach((b) => {
      const m = b.getAttribute('data-playlist-btn');
      const isAct = playlistMode === m;
      b.classList.toggle('tv-playlist-active', isAct);
      b.setAttribute('aria-pressed', String(isAct));
    });

    if (playlistStatusEl) {
      if (playlistMode) {
        const ids = visibleStudyIds();
        const pos = Math.max(0, ids.indexOf(activeStudyId)) + 1;
        playlistStatusEl.textContent = 'Continuous ' + playlistMode + ' Playlist · Film ' + pos + ' of ' + ids.length;
      } else {
        playlistStatusEl.textContent = 'Single-Film Mode · ' + tObj.duration_s.toFixed(1) + 's';
      }
    }

    document.querySelectorAll('[data-study-card]').forEach((card) => {
      const cid = card.getAttribute('data-study-card');
      card.classList.toggle('tv-card-playing', cid === activeStudyId);
      const badge = card.querySelector('.tv-now-playing-pill');
      if (badge) badge.classList.toggle('hidden', cid !== activeStudyId);
    });

    renderCues(study, activeTier);

    if (videoEl) {
      const curSrc = videoEl.getAttribute('data-loaded-src');
      if (curSrc !== tObj.video_url) {
        videoEl.poster = tObj.poster_url || study.poster_url;
        videoEl.setAttribute('data-loaded-src', tObj.video_url);
        if (trackEl) trackEl.src = tObj.vtt_url;
        videoEl.src = tObj.video_url;
        videoEl.load();
      }
      videoEl.playbackRate = playbackRate;
      if (autoplay) {
        videoEl.play().catch(() => {});
      }
    }

    try {
      history.replaceState(null, '', '#' + activeStudyId + ':' + activeTier);
    } catch (_) {}
  }

  function applyFilters() {
    const vis = new Set(visibleStudyIds());
    document.querySelectorAll('[data-study-card]').forEach((card) => {
      const cid = card.getAttribute('data-study-card');
      card.classList.toggle('hidden', !vis.has(cid));
    });
    document.querySelectorAll('[data-tv-channel-card]').forEach((el) => {
      el.classList.toggle('tv-channel-active', el.getAttribute('data-tv-channel-card') === activeChannelId);
    });
    const clearChBtn = document.getElementById('tv-clear-channel-btn');
    if (clearChBtn) clearChBtn.classList.toggle('hidden', !activeChannelId);
    const countEl = document.getElementById('tv-visible-count');
    if (countEl) {
      const chSuffix = activeChannelId && CHANNELS_BY_ID[activeChannelId]
        ? ' · Channel: ' + CHANNELS_BY_ID[activeChannelId].name + ' (' + CHANNELS_BY_ID[activeChannelId].domain + ')'
        : '';
      countEl.textContent = vis.size + ' / ' + STUDIES.length + ' studies shown (' + (vis.size * 5) + ' horizontal + 9:16 films)' + chSuffix;
    }
  }

  function stepTopic(delta, autoplay) {
    const ids = visibleStudyIds();
    if (!ids.length) return;
    const idx = ids.indexOf(activeStudyId);
    const nextIdx = idx < 0 ? 0 : (idx + delta + ids.length) % ids.length;
    activeStudyId = ids[nextIdx];
    if (playlistMode) activeTier = playlistMode;
    updateUIState(autoplay);
  }

  document.querySelectorAll('[data-tier-btn]').forEach((b) => {
    b.addEventListener('click', () => {
      const t = b.getAttribute('data-tier-btn');
      if (t && TIER_ORDER.includes(t)) {
        playlistMode = null;
        activeTier = t;
        updateUIState(true);
      }
    });
  });

  document.querySelectorAll('[data-playlist-btn]').forEach((b) => {
    b.addEventListener('click', () => {
      const m = b.getAttribute('data-playlist-btn');
      if (playlistMode === m) {
        playlistMode = null;
        updateUIState(false);
      } else {
        playlistMode = m;
        activeTier = m;
        updateUIState(true);
      }
    });
  });

  document.querySelectorAll('[data-speed-btn]').forEach((b) => {
    b.addEventListener('click', () => {
      playbackRate = parseFloat(b.getAttribute('data-speed-btn') || '1');
      document.querySelectorAll('[data-speed-btn]').forEach((x) => x.classList.toggle('tv-speed-active', x === b));
      if (videoEl) videoEl.playbackRate = playbackRate;
    });
  });

  document.getElementById('tv-prev-btn')?.addEventListener('click', () => stepTopic(-1, true));
  document.getElementById('tv-next-btn')?.addEventListener('click', () => stepTopic(1, true));

  document.querySelectorAll('[data-cat-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      activeChannelId = null;
      activeCategory = tab.getAttribute('data-cat-tab') || 'All 27';
      document.querySelectorAll('[data-cat-tab]').forEach((t) => {
        const on = t === tab;
        t.classList.toggle('tv-cat-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      applyFilters();
    });
  });

  document.querySelectorAll('[data-tv-channel-queue]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const chId = btn.getAttribute('data-tv-channel-queue');
      const tr = normalizeTier(btn.getAttribute('data-tier') || '90s');
      const ch = chId ? CHANNELS_BY_ID[chId] : null;
      if (!ch) return;
      activeChannelId = chId;
      playlistMode = tr;
      activeTier = tr;
      const firstId = (ch.tv_studies || []).find((id) => byId[id]);
      if (firstId) activeStudyId = firstId;
      applyFilters();
      updateUIState(true);
      document.getElementById('tv-theater-anchor')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.getElementById('tv-clear-channel-btn')?.addEventListener('click', () => {
    activeChannelId = null;
    playlistMode = null;
    applyFilters();
    updateUIState(false);
  });

  const searchInput = document.getElementById('tv-search-input');
  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value || '';
    applyFilters();
  });

  document.querySelectorAll('[data-card-play]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sid = btn.getAttribute('data-study');
      const tr = normalizeTier(btn.getAttribute('data-tier') || activeTier);
      if (sid && byId[sid]) {
        playlistMode = null;
        activeStudyId = sid;
        activeTier = tr;
        updateUIState(true);
        document.getElementById('tv-theater-anchor')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  copyBtn?.addEventListener('click', () => {
    const st = byId[activeStudyId];
    const txt = st?.tiers?.[activeTier]?.transcript || '';
    navigator.clipboard?.writeText(txt).then(() => {
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy Transcript'; }, 1600);
    });
  });

  tiktokCopyBtn?.addEventListener('click', () => {
    const st = byId[activeStudyId];
    const cap = st?.tiers?.tiktok?.tiktok_caption || '';
    navigator.clipboard?.writeText(cap).then(() => {
      tiktokCopyBtn.textContent = 'Copied Caption!';
      setTimeout(() => { tiktokCopyBtn.textContent = 'Copy TikTok Caption'; }, 1600);
    });
  });

  videoEl?.addEventListener('timeupdate', syncActiveCue);
  videoEl?.addEventListener('ended', () => {
    if (playlistMode) stepTopic(1, true);
  });
  videoEl?.addEventListener('error', () => {
    const study = byId[activeStudyId];
    const mobUrl = study?.study_assets?.mobile_mp4_url;
    if (mobUrl && videoEl.getAttribute('data-loaded-src') !== mobUrl) {
      videoEl.setAttribute('data-loaded-src', mobUrl);
      videoEl.src = mobUrl;
      videoEl.load();
    }
  });

  // Bidirectional Voice + Video Co-Pilot Bridge: ensure /tv/ playback and Live Call speech never talk over each other
  function pauseAndDuckTvMedia() {
    playlistMode = null;
    if (videoEl && !videoEl.paused) {
      videoEl.pause();
    }
    const auxEl = document.getElementById('tv-aux-audio');
    if (auxEl && !auxEl.paused) {
      auxEl.pause();
    }
  }

  videoEl?.addEventListener('play', () => {
    const hmi = window.openieLiveHMI;
    if (hmi && (hmi.state === 'speaking' || hmi.state === 'thinking')) {
      hmi.bargeIn('tv-video-play');
    }
  });

  let prevCallActive = false;
  window.addEventListener('openie:live-call-state', (ev) => {
    const snap = (ev && ev.detail) || {};
    if ((snap.callActive && !prevCallActive) || snap.state === 'speaking') {
      pauseAndDuckTvMedia();
    }
    prevCallActive = Boolean(snap.callActive);
  });

  document.getElementById('tv-discuss-film-btn')?.addEventListener('click', async () => {
    pauseAndDuckTvMedia();
    window.dispatchEvent(
      new CustomEvent('openie:open-live-dock', {
        detail: { studyId: activeStudyId, tier: activeTier },
      })
    );
    if (window.openieLiveDock && typeof window.openieLiveDock.open === 'function') {
      window.openieLiveDock.open();
    }
    let hmi = window.openieLiveHMI;
    if (!hmi) {
      try {
        const mod = await import('/live/hmi-engine.js');
        hmi = mod.getOpenIELiveHMI();
      } catch (_) {}
    }
    if (hmi) {
      await hmi.loadCorpus();
      hmi.setStudy(activeStudyId);
      hmi.startCall({ studyId: activeStudyId, mode: 'call' });
    }
  });

  // Allow hmi-engine.js and voice commands to switch the active study or slot on /tv/
  window.addEventListener('openie:tv-select-study', (ev) => {
    const d = (ev && ev.detail) || {};
    const sid = resolveStudyId(d.studyId || d.study_id || d.id);
    const rawTier = d.tier || d.slot || d.clip;
    if (!sid || !byId[sid]) return;
    playlistMode = null;
    activeStudyId = sid;
    if (rawTier && rawTier !== 'living') {
      activeTier = normalizeTier(rawTier);
    }
    const hmiBusy = Boolean(
      window.openieLiveHMI &&
      (window.openieLiveHMI.callActive || window.openieLiveHMI.state === 'speaking')
    );
    if (hmiBusy) pauseAndDuckTvMedia();
    updateUIState(Boolean(d.autoplay) && !hmiBusy);
  });

  document.addEventListener('keydown', (e) => {
    const tag = (e.target?.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === ' ') {
      e.preventDefault();
      if (videoEl) videoEl.paused ? videoEl.play().catch(() => {}) : videoEl.pause();
    } else if (['1', '2', '3', '4', '5'].includes(e.key)) {
      playlistMode = null;
      activeTier = TIER_ORDER[parseInt(e.key, 10) - 1];
      updateUIState(true);
    } else if (e.key === 'j' || e.key === 'J') {
      stepTopic(1, true);
    } else if (e.key === 'k' || e.key === 'K') {
      stepTopic(-1, true);
    } else if (e.key === 'm' || e.key === 'M') {
      if (videoEl) videoEl.muted = !videoEl.muted;
    }
  });

  const params = new URLSearchParams(window.location.search);
  const qChannel = params.get('channel');
  const qStudy = resolveStudyId(params.get('study'));
  const qTier = params.get('tier');
  const rawHash = (window.location.hash || '').replace(/^#/, '');
  if (qChannel && CHANNELS_BY_ID[qChannel]) {
    activeChannelId = qChannel;
    const chFirst = (CHANNELS_BY_ID[qChannel].tv_studies || []).find((id) => byId[id]);
    if (chFirst) activeStudyId = chFirst;
    if (qTier) activeTier = normalizeTier(qTier);
  }
  if (qStudy && byId[qStudy]) {
    activeStudyId = qStudy;
    if (qTier) activeTier = normalizeTier(qTier);
  } else if (rawHash && rawHash !== 'ecosystem-channels') {
    const [rawHId, hTier] = rawHash.split(':');
    const hId = resolveStudyId(rawHId);
    if (hId && byId[hId]) activeStudyId = hId;
    if (hTier) activeTier = normalizeTier(hTier);
  }

  window.openieTV = {
    version: CATALOG.version,
    getActive() {
      return {
        study_id: activeStudyId,
        tier: activeTier,
        study: byId[activeStudyId] || null,
      };
    },
    listFilms() {
      const out = [];
      for (const s of STUDIES) {
        for (const t of TIER_ORDER) {
          const td = s.tiers[t];
          out.push({
            study_id: s.id,
            title: s.title,
            short_title: s.short_title,
            category: s.category,
            tier: t,
            duration_s: td.duration_s,
            video_url: td.video_url,
            vtt_url: td.vtt_url,
            poster_url: s.poster_url,
            narrator_name: s.narrator_name,
            narrator_profile: s.narrator_profile,
            plain_bullets: s.plain_bullets,
            tutorial_lab_id: s.tutorial_lab_id,
            headline_metric: s.headline_metric,
            epistemic_tags: s.epistemic_tags,
            energy_tier: s.energy_tier,
          });
        }
      }
      return out;
    },
    play(studyId, tier = '90s') {
      const rId = resolveStudyId(studyId);
      if (!byId[rId]) throw new Error('Unknown studyId: ' + studyId);
      const cleanTier = normalizeTier(tier);
      playlistMode = null;
      activeStudyId = rId;
      activeTier = cleanTier;
      updateUIState(true);
      return { study_id: activeStudyId, tier: activeTier, video_url: byId[rId].tiers[cleanTier].video_url };
    },
    getTranscript(studyId, tier = '90s') {
      const s = byId[resolveStudyId(studyId)];
      if (!s) return null;
      const cleanTier = normalizeTier(tier);
      const td = s.tiers[cleanTier];
      return {
        study_id: s.id,
        title: s.title,
        tier: cleanTier,
