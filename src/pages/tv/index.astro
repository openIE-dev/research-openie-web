    #tv-planetary-lang:focus-visible {
      outline: 2px solid #f59e0b;
      outline-offset: 2px;
    }
  </style>

  <TvClient catalog={enrichedCatalog} ecosystem={ecosystemChannels} />

  <script is:inline define:vars={{ tvPlanetaryPayload }}>
  (function () {
    const P = JSON.parse(tvPlanetaryPayload);
    const LANG_BY_CODE = Object.fromEntries((P.langs || []).map((l) => [l.code, l]));
    const VAR_BY_KEY = {};
    const LANGS_FOR_STUDY = {};
    (P.variants || []).forEach((v) => {
      VAR_BY_KEY[v.tv_id + ':' + v.lang] = v;
      if (!LANGS_FOR_STUDY[v.tv_id]) LANGS_FOR_STUDY[v.tv_id] = new Set();
      LANGS_FOR_STUDY[v.tv_id].add(v.lang);
    });
    const AD_BY_TV = Object.fromEntries((P.ad || []).map((a) => [a.tv_id, a]));
    const ER_BY_TV = Object.fromEntries((P.easyRead || []).map((e) => [e.study_id, e]));

    const videoEl = document.getElementById('tv-player');
    const trackEl = document.getElementById('tv-track');
    const langSelect = document.getElementById('tv-planetary-lang');
    const optGroupT2 = document.getElementById('tv-lang-opt-t2');
    const adBtn = document.getElementById('tv-ad-toggle');
    const erBtn = document.getElementById('tv-easyread-toggle');
    const auxWrap = document.getElementById('tv-aux-audio-wrap');
    const auxStatus = document.getElementById('tv-aux-status');
    const auxGateBadge = document.getElementById('tv-aux-gate-badge');
    const auxDlM4a = document.getElementById('tv-aux-dl-m4a');
    const auxDlVtt = document.getElementById('tv-aux-dl-vtt');
    const auxResetBtn = document.getElementById('tv-aux-reset');
    const auxAudio = document.getElementById('tv-aux-audio');
    const pBulletsBox = document.getElementById('tv-planetary-bullets-box');
    const pBulletsList = document.getElementById('tv-planetary-bullets');
    const pKicker = document.getElementById('tv-planetary-kicker');
    const pDirPill = document.getElementById('tv-planetary-dir-pill');
    const adDrawer = document.getElementById('tv-ad-drawer');
    const adOverview = document.getElementById('tv-ad-overview');
    const adCues = document.getElementById('tv-ad-cues');
    const adVttLink = document.getElementById('tv-ad-vtt-link');
    const erDrawer = document.getElementById('tv-easyread-drawer');
    const erTitle = document.getElementById('tv-er-title');
    const erSymbols = document.getElementById('tv-er-symbols');
    const erSentences = document.getElementById('tv-er-sentences');
    const erGuideLink = document.getElementById('tv-er-guide-link');

    let selectedLang = 'studio'; // 'studio' | BCP-47 code
    let adActive = false;
    let erOpen = false;
    let syncingMedia = false;

    function esc(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function detectCurrentStudyAndTier() {
      const loaded = (videoEl && (videoEl.getAttribute('data-loaded-src') || videoEl.getAttribute('src'))) || '';
      const m = loaded.match(/\/media\/tv\/films\/(.+)-(15s|45s|90s|180s)\.mp4$/);
      if (m) return { studyId: m[1], tier: m[2] };
      const mt = loaded.match(/\/media\/tv\/tiktok\/(.+)-tiktok\.mp4$/);
      if (mt) return { studyId: mt[1], tier: 'tiktok' };
      return { studyId: 'communication-avalanche', tier: '90s' };
    }

    function ensureTier15s(studyId, tier) {
      if (tier !== '15s' && window.openieTV && typeof window.openieTV.play === 'function') {
        window.openieTV.play(studyId, '15s');
        return true;
      }
      return false;
    }

    function updateLangOptionAvailability(studyId) {
      const avail = LANGS_FOR_STUDY[studyId] || new Set();
      let hasAnyT2 = false;
      if (optGroupT2) {
        optGroupT2.querySelectorAll('option').forEach((opt) => {
          const ok = avail.has(opt.value);
          opt.disabled = !ok;
          if (ok) hasAnyT2 = true;
        });
        optGroupT2.label = hasAnyT2
          ? 'Tier 2 · Next 30 Languages (Active 50-Language Study · +1.41B Speakers)'
          : 'Tier 2 · Next 30 Languages (Select Avalanche or 64-Codon Study)';
      }
    }

    function renderAccessibilityState(autoplayAux) {
      const { studyId, tier } = detectCurrentStudyAndTier();
      updateLangOptionAvailability(studyId);

      // If user explicitly switched to 45s/90s/180s while language or AD was active, return audio to studio English
      if (tier !== '15s' && (selectedLang !== 'studio' || adActive)) {
        selectedLang = 'studio';
        adActive = false;
        if (langSelect) langSelect.value = 'studio';
      }

      // If current study lacks a Tier-2 variant that was selected on a flagship, fall back cleanly to English 15s
      if (selectedLang !== 'studio' && !VAR_BY_KEY[studyId + ':' + selectedLang]) {
        selectedLang = VAR_BY_KEY[studyId + ':en'] ? 'en' : 'studio';
        if (langSelect) langSelect.value = selectedLang;
      }

      const adObj = AD_BY_TV[studyId];
      const erObj = ER_BY_TV[studyId];
      const varObj = selectedLang !== 'studio' ? VAR_BY_KEY[studyId + ':' + selectedLang] : null;
      const lgMeta = selectedLang !== 'studio' ? LANG_BY_CODE[selectedLang] : null;

      // Toggle button visual + ARIA states
      if (adBtn) {
        adBtn.classList.toggle('tv-a11y-active', adActive);
        adBtn.setAttribute('aria-pressed', String(adActive));
      }
      if (erBtn) {
        erBtn.classList.toggle('tv-a11y-active', erOpen);
        erBtn.setAttribute('aria-pressed', String(erOpen));
        erBtn.setAttribute('aria-expanded', String(erOpen));
      }

      // Easy-Read drawer (works on every study and every depth slot)
      if (erDrawer) {
        erDrawer.classList.toggle('hidden', !erOpen);
        if (erObj) {
          if (erTitle) erTitle.textContent = erObj.easy_title;
          if (erGuideLink) erGuideLink.setAttribute('href', '/media/tv/accessibility/easy-read-index.html#study-' + studyId);
          if (erSymbols) {
            erSymbols.innerHTML = (erObj.symbol_tags || []).map((t) =>
              '<span class="px-2.5 py-1 rounded-full border border-brand-cyan/35 bg-white/5 font-mono text-[11px] text-brand-white">' +
              '<span aria-hidden="true">' + esc(t.unicode) + '</span> <strong>' + esc(t.core_word) + '</strong>: ' + esc(t.label) +
              '</span>'
            ).join('');
          }
          if (erSentences) {
            erSentences.innerHTML = (erObj.one_idea_sentences || []).map((s) => '<li>' + esc(s) + '</li>').join('');
          }
        }
      }

      // Extended Audio Description drawer
      const fallbackAdM4a = '/media/tv/accessibility/' + studyId + '-15s.ad.m4a';
      const fallbackAdVtt = '/media/tv/accessibility/' + studyId + '-15s.ad.vtt';
      if (adDrawer) {
        adDrawer.classList.toggle('hidden', !adActive);
        if (adVttLink) adVttLink.setAttribute('href', adObj ? adObj.vtt_url : fallbackAdVtt);
        if (adObj) {
          if (adOverview) adOverview.textContent = adObj.overview;
          if (adCues) {
            adCues.innerHTML = (adObj.cues || []).map((c, idx) =>
              '<div class="p-2.5 rounded-lg border border-brand-border bg-[#0b1020] text-xs">' +
              '<div class="font-mono text-[10px] text-emerald-300 mb-1">Scene ' + (idx + 1) + ' Geometry</div>' +
              '<div class="text-brand-light mb-1 leading-snug">' + esc(c.visual) + '</div>' +
              '<div class="font-mono text-[10.5px] text-brand-amber leading-snug">' + esc(c.takeaway) + '</div>' +
              '</div>'
            ).join('');
          }
        }
      }

      // Auxiliary audio & captions orchestration (AD takes precedence when toggled ON, otherwise Planetary 15s language)
      const useAux = adActive || Boolean(varObj);
      if (auxWrap) auxWrap.classList.toggle('hidden', !useAux);

      if (!useAux) {
        if (auxAudio && !auxAudio.paused) auxAudio.pause();
        if (videoEl) videoEl.muted = false;
        if (trackEl) {
          const origVtt = '/media/tv/captions/' + studyId + '-' + tier + '.vtt';
          if (trackEl.getAttribute('src') !== origVtt) {
            trackEl.setAttribute('srclang', 'en');
            trackEl.setAttribute('label', 'English Studio Captions');
            trackEl.setAttribute('src', origVtt);
          }
        }
        if (pBulletsBox) pBulletsBox.classList.add('hidden');
        return;
      }

      const targetAudio = adActive ? (adObj ? adObj.audio_url : fallbackAdM4a) : varObj.audio_url;
      const targetVtt = adActive ? (adObj ? adObj.vtt_url : fallbackAdVtt) : varObj.vtt_url;

      if (videoEl) videoEl.muted = true;
      if (trackEl) {
        trackEl.setAttribute('srclang', adActive ? 'en' : varObj.lang);
        trackEl.setAttribute('label', adActive ? 'Extended Audio Description' : ((lgMeta ? lgMeta.name : varObj.lang) + ' Captions'));
        if (trackEl.getAttribute('src') !== targetVtt) {
          trackEl.setAttribute('src', targetVtt);
        }
      }

      if (auxAudio && auxAudio.getAttribute('src') !== targetAudio) {
        auxAudio.pause();
        auxAudio.setAttribute('src', targetAudio);
        auxAudio.load();
      }
      if (auxDlM4a) auxDlM4a.setAttribute('href', targetAudio);
      if (auxDlVtt) auxDlVtt.setAttribute('href', targetVtt);

      if (adActive) {
        if (auxStatus) auxStatus.textContent = '🎧 Extended Audio Description Active · Stereo -16 LUFS (.ad.m4a)';
        if (auxGateBadge) auxGateBadge.textContent = 'WCAG 2.2 AA · 29/29 Catalog';
        if (pBulletsBox) pBulletsBox.classList.add('hidden');
      } else if (varObj) {
        const lLabel = lgMeta ? (lgMeta.native + ' · ' + lgMeta.name) : varObj.lang;
        if (auxStatus) auxStatus.textContent = '🌐 15s Native Audio · ' + lLabel + ' (' + varObj.voice + ')';
        if (auxGateBadge) {
          auxGateBadge.textContent = '✓ Gate: Semantic ' + Number(varObj.comet || 0).toFixed(3) + ' · chrF++ ' + Number(varObj.chrf || 0).toFixed(1);
        }
        if (pBulletsBox && pBulletsList) {
          pBulletsBox.classList.remove('hidden');
          pBulletsBox.setAttribute('dir', varObj.dir || 'ltr');
          pBulletsBox.setAttribute('lang', varObj.lang);
          if (pKicker) pKicker.textContent = 'Verified 15s Plain-Words Takeaways · ' + (lgMeta ? lgMeta.name : varObj.lang);
          if (pDirPill) pDirPill.textContent = varObj.lang + ' · ' + String(varObj.dir || 'ltr').toUpperCase();
          pBulletsList.innerHTML = (varObj.bullets || []).map((b) => '<li>' + esc(b) + '</li>').join('');
        }
      }

      if (autoplayAux && auxAudio) {
        if (videoEl) {
          videoEl.currentTime = 0;
          videoEl.play().catch(() => {});
        }
        auxAudio.currentTime = 0;
        auxAudio.play().catch(() => {});
      }
    }

    // Keep muted video and auxiliary track synchronized
    if (auxAudio && videoEl) {
      auxAudio.addEventListener('play', () => {
        if (syncingMedia) return;
        syncingMedia = true;
        videoEl.muted = true;
        if (videoEl.duration) videoEl.currentTime = auxAudio.currentTime % videoEl.duration;
        videoEl.play().catch(() => {});
        syncingMedia = false;
      });
      auxAudio.addEventListener('pause', () => {
        if (syncingMedia || auxAudio.ended) return;
        syncingMedia = true;
        videoEl.pause();
        syncingMedia = false;
      });
      auxAudio.addEventListener('ended', () => {
        if (syncingMedia) return;
        syncingMedia = true;
        videoEl.pause();
        syncingMedia = false;
      });
      videoEl.addEventListener('play', () => {
        if (syncingMedia) return;
        if (adActive || selectedLang !== 'studio') {
          syncingMedia = true;
          videoEl.muted = true;
          if (auxAudio.paused) auxAudio.play().catch(() => {});
          syncingMedia = false;
        }
      });
      videoEl.addEventListener('pause', () => {
        if (syncingMedia) return;
        if ((adActive || selectedLang !== 'studio') && !auxAudio.paused) {
          syncingMedia = true;
          auxAudio.pause();
          syncingMedia = false;
        }
      });
    }

    langSelect?.addEventListener('change', () => {
      const val = langSelect.value || 'studio';
      selectedLang = val;
      if (val !== 'studio') {
        adActive = false;
        const { studyId, tier } = detectCurrentStudyAndTier();
        ensureTier15s(studyId, tier);
        renderAccessibilityState(true);
      } else {
        renderAccessibilityState(false);
      }
    });

    adBtn?.addEventListener('click', () => {
      adActive = !adActive;
      if (adActive) {
        selectedLang = 'studio';
        if (langSelect) langSelect.value = 'studio';
        const { studyId, tier } = detectCurrentStudyAndTier();
        ensureTier15s(studyId, tier);
        renderAccessibilityState(true);
      } else {
        renderAccessibilityState(false);
      }
    });

    erBtn?.addEventListener('click', () => {
      erOpen = !erOpen;
      renderAccessibilityState(false);
    });

    auxResetBtn?.addEventListener('click', () => {
      selectedLang = 'studio';
      adActive = false;
      if (langSelect) langSelect.value = 'studio';
      renderAccessibilityState(false);
    });

    // Observe #tv-player data-loaded-src so switching studies or depth slots updates studio controls automatically
    if (videoEl && typeof MutationObserver !== 'undefined') {
      const obs = new MutationObserver(() => {
        renderAccessibilityState(false);
      });
      obs.observe(videoEl, { attributes: true, attributeFilter: ['data-loaded-src', 'src'] });
    }

    // Support URL query params (?lang=<code>&ad=1&easyread=1)
    const qp = new URLSearchParams(window.location.search);
    const qLang = qp.get('lang');
    const qAd = qp.get('ad');
    const qEr = qp.get('easyread');
    if (qEr === '1' || qEr === 'true') erOpen = true;
    if (qAd === '1' || qAd === 'true') {
      adActive = true;
      const { studyId, tier } = detectCurrentStudyAndTier();
      ensureTier15s(studyId, tier);
    } else if (qLang && LANG_BY_CODE[qLang]) {
      selectedLang = qLang;
      if (langSelect) langSelect.value = qLang;
      const { studyId, tier } = detectCurrentStudyAndTier();
      ensureTier15s(studyId, tier);
    }

    renderAccessibilityState(false);
  })();
  </script>
</Layout>
