---
import Layout from '../../layouts/Layout.astro';
import tvCatalog from '../../data/tv-catalog.json';
import tiktokSnackables from '../../data/tiktok-snackables.json';
import ecosystemChannelsRaw from '../../data/openie-ecosystem-channels.json';
import unsiloeing from '../../data/planetary-unsiloeing.json';
import TvEcosystemChannels from '../../components/tv/TvEcosystemChannels.astro';
import TvClient from './_TvClient.astro';

const SITE = 'https://research.openie.dev';
const tiktokById: Record<string, any> = Object.fromEntries(
  ((tiktokSnackables.studies ?? []) as any[]).map((tk) => [tk.id, tk])
);
const studies = (tvCatalog.studies as any[]).map((s) => {
  const tk = tiktokById[s.id];
  return tk
    ? {
        ...s,
        tiktok: tk,
        tiers: {
          ...s.tiers,
          tiktok: {
            video_url: tk.video_url,
            vtt_url: tk.vtt_url,
            poster_url: tk.poster_url,
            duration_s: tk.duration_s,
            bytes: tk.bytes,
            sha256: tk.sha256,
            blake3: tk.blake3,
            hook: `${tk.hook_headline} — Native 9:16 (1080×1920 @ 60fps, -14 LUFS) vertical snackable cut with burned-in TikTok safe-zone captions.`,
            transcript: s.tiers['15s']?.transcript ?? '',
            cues: s.tiers['15s']?.cues ?? [],
            tiktok_caption: tk.tiktok_caption,
            tiktok_api_v2_init_payload: tk.tiktok_api_v2_init_payload,
          },
        },
      }
    : s;
});
const enrichedCatalog = {
  ...tvCatalog,
  film_count: (tvCatalog.film_count ?? 112) + ((tiktokSnackables.studies ?? []).length || 28),
  studies,
};
const studiesById = Object.fromEntries(studies.map((s) => [s.id, s]));

const uMetrics: any = unsiloeing.summary_metrics ?? {};
const allPlanetaryLangs = [
  ...((unsiloeing.tier1_languages ?? []) as any[]).map((l) => ({
    code: l.code,
    tier: 1,
    name: l.name,
    native: l.native,
    dir: l.dir ?? 'ltr',
    speakers_m: l.speakers_m,
  })),
  ...(((unsiloeing as any).tier2_languages ?? unsiloeing.tier2_roadmap ?? []) as any[]).map((l) => ({
    code: l.code,
    tier: 2,
    name: l.name,
    native: l.native,
    dir: l.dir ?? (l.code === 'fa' || l.code === 'he' ? 'rtl' : 'ltr'),
    speakers_m: l.speakers_m,
  })),
];

const tvPlanetaryPayload = JSON.stringify({
  langs: allPlanetaryLangs,
  variants: ((unsiloeing.variants ?? []) as any[])
    .filter((v) => v.ship_allowed !== false && v.audio_url)
    .map((v) => ({
      tv_id: v.tv_id,
      lang: v.lang,
      tier: v.tier ?? 1,
      dir: v.dir ?? 'ltr',
      voice: v.voice,
      audio_url: v.audio_url,
      vtt_url: v.vtt_url,
      gate_status: v.gate_status,
      comet: v.comet_calibrated,
      chrf: v.backtrans_chrfpp,
      bullets: v.bullets,
    })),
  ad: ((unsiloeing.audio_descriptions ?? []) as any[]).map((a) => ({
    tv_id: a.tv_id,
    overview: a.visual_overview,
    audio_url: a.ad_audio_url,
    vtt_url: a.ad_vtt_url,
    duration_s: a.duration_s,
    cues: a.cues,
  })),
  easyRead: ((unsiloeing.easy_read_flagship ?? []) as any[]).map((e) => ({
    study_id: e.study_id,
    easy_title: e.easy_title,
    symbol_tags: e.symbol_tags,
    one_idea_sentences: e.one_idea_sentences,
  })),
});
const ecosystemChannels = {
  ...ecosystemChannelsRaw,
  channels: (ecosystemChannelsRaw.channels || []).map((ch: any) => {
    let list = [...(ch.tv_studies || [])];
    if ((ch.id === 'avalanche' || ch.id === 'compute' || ch.id === 'synthesis') && !list.includes('from-ephemeral-inference-to-compiled-agency')) {
      list = ['from-ephemeral-inference-to-compiled-agency', ...list];
    }
    if ((ch.id === 'avalanche' || ch.id === 'compute') && !list.includes('lut6-codon-nucleus')) {
      list = [...list, 'lut6-codon-nucleus'];
    }
    return { ...ch, tv_studies: list };
  }),
};
const initialStudy =
  studies.find((s) => s.id === 'from-ephemeral-inference-to-compiled-agency') ??
  studies.find((s) => s.id === 'communication-avalanche') ??
  studies[0];
const initialTier = initialStudy.tiers['90s'] ?? Object.values(initialStudy.tiers)[0];

const categories = [
  'All 29',
  'Foundations & Thermodynamics',
  'Reality Code Engine',
  'Null & Benchmarks',
  'Communication Avalanche & Bio',
  'Hardware, Silicon & OS',
  'Economics & Cadence',
];

const tierOrder = ['15s', '45s', '90s', '180s'] as const;
const tierLabels: Record<string, string> = {
  '15s': '15s · 3 Plain Points',
  '45s': '45s · Plain + Example',
  '90s': '90s · Full Briefing',
  '180s': '3m · Deep Cut · 3D',
};
const tierShortLabels: Record<string, string> = {
  '15s': '15s Plain',
  '45s': '45s Story',
  '90s': '90s Brief',
  '180s': '3m Deep',
};

const isoDuration = (sec: number) => `PT${Math.max(1, Math.round(sec))}S`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'OpenIE Research TV — 116 Plain-Language Research & Ecosystem Films Across 29 Topics',
  description: tvCatalog.studio_disclosure,
  numberOfItems: tvCatalog.film_count,
  itemListElement: studies.flatMap((s, sIdx) =>
    tierOrder.map((t, tIdx) => {
      const td = s.tiers[t];
      return {
        '@type': 'ListItem',
        position: sIdx * 4 + tIdx + 1,
        item: {
          '@type': 'VideoObject',
          name: `${s.short_title} (${tierLabels[t]})`,
          description: td.hook,
          thumbnailUrl: `${SITE}${s.poster_url}`,
          uploadDate: '2026-11-23',
          duration: isoDuration(td.duration_s),
          contentUrl: `${SITE}${td.video_url}`,
          embedUrl: `${SITE}/tv/?study=${s.id}&tier=${t}`,
          transcript: td.transcript,
          publisher: {
            '@type': 'Organization',
            name: 'Open Interface Engineering, Inc.',
            url: 'https://openie.dev',
          },
        },
      };
    })
  ),
};
---

<Layout
  title="OpenIE Research TV — 116 Plain-Language Research Films (15s to 3m)"
  description="Watch all 29 OpenIE research studies (led by Capstone Study #29 From Ephemeral Inference to Compiled Agency) and *.openie.dev channel openers across four plain-language depth slots (15s Three Plain Points, 45s Everyday Example, 90s Full Briefing, and 3-Minute 3D Deep Cut)—starting with the three layperson takeaways and free of unexplained acronyms."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="max-w-7xl mx-auto px-5 md:px-10 pt-10 pb-20">
    <!-- Studio Header & Plain-Words Philosophy Banner -->
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="section-label">OpenIE Broadcast Studio · /tv/</span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-amber/15 text-brand-amber border border-brand-amber/30">
          29 Topics × (4 Horizontal + 9:16 TikTok Vertical) = 145 Films
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/30">
          Plain Words First · Zero Acronym Soup · Global Voices
        </span>
        <a href="/syndication/" class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-emerald-500/15 text-emerald-300 border border-emerald-400/35 no-underline hover:bg-emerald-500/25 transition-colors">
          📱 9:16 TikTok + X ↔ Medium Studio →
        </a>
        <a href="#ecosystem-channels" class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-white/5 text-brand-light border border-brand-border no-underline hover:border-brand-amber hover:text-brand-amber transition-colors">
          6 *.openie.dev Channels ↓
        </a>
        <a href="/blueprint/" class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-amber/15 text-brand-amber border border-brand-amber/40 no-underline hover:bg-brand-amber/25 transition-colors">
          {uMetrics.active_languages ?? 50}-Language 15s · {uMetrics.easy_read_studies ?? 29}/29 Easy Read &amp; AD Blueprint →
        </a>
        <a href="/glossary/concepts.json" class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-white/5 text-brand-cyan border border-brand-cyan/30 no-underline hover:border-brand-cyan transition-colors">
          AAC concepts.json
        </a>
      </div>
      <h1 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-brand-white mb-4">
        Open<span class="text-brand-cyan">IE</span> Research <span class="text-brand-amber">TV</span>
      </h1>
      <p class="font-body text-base md:text-lg text-brand-slate max-w-4xl leading-relaxed mb-5">
        Every film—at every length—starts with the paper's <strong>three high-level points in plain everyday words</strong>, then expands smoothly as you choose more time: from a <strong>15-second three-point primer</strong>, to a <strong>45-second real-world example</strong>, to a <strong>90-second full briefing</strong>, to a <strong>3-minute deep cut</strong> with 3D architecture views and candid scientific limits.
      </p>

      <div class="glass-card p-4 md:p-5 border-l-4 border-l-brand-amber">
        <div class="font-mono text-[11px] uppercase tracking-wider text-brand-amber mb-1.5">
          Plain-Language Guarantee · Signed Provenance · Self-Checked · Orthogonal Energy Classes
        </div>
        <p class="font-body text-[13px] text-brand-light leading-relaxed m-0">
          No film assumes insider jargon or unexplained acronyms. Every study is narrated by its own studio presenter via <code class="font-mono text-brand-cyan">ElevenLabs eleven_v4</code> under <strong>Signed Provenance · Self-Checked</strong> (not yet externally peer-reviewed), and every energy claim keeps four evidence classes strictly orthogonal (<code class="font-mono text-emerald-300">measured_j ⊥ reported_j ⊥ est_j ⊥ unmetered</code>):
          <strong>direct circuit-board power shunts</strong> (physical current sensors in <em>From Ephemeral Inference to Compiled Agency</em>, <em>Metered Commit Gates</em>, <em>Satiation Benchmark Harness</em>, and <em>The Communication Tool Avalanche</em>),
          <strong>built-in computer chip counters</strong>,
          <strong>analytical estimates</strong>, or <strong>unmetered formal work</strong>.
        </p>
      </div>
    </div>

    <!-- Hero Broadcast Theater -->
    <div id="tv-theater-anchor" class="scroll-mt-24 glass-card p-4 md:p-6 mb-12">
      <!-- Top Control Deck: 4 Telescoping Depth Slots + Continuous Playlists + Speed -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-brand-border">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Depth slot selector">
          <button type="button" data-tier-btn="15s" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">1</span> 15s · 3 Plain Points
          </button>
          <button type="button" data-tier-btn="45s" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">2</span> 45s · Plain + Example
          </button>
          <button type="button" data-tier-btn="90s" class="tv-tier-pill tv-pill-active font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">3</span> 90s · Full Briefing
          </button>
          <button type="button" data-tier-btn="180s" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">4</span> 3m · Deep Cut · 3D
          </button>
          <button type="button" data-tier-btn="tiktok" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-emerald-400/45 text-emerald-300 bg-emerald-500/10 cursor-pointer transition-all">
            <span class="text-emerald-300 mr-1">5</span> 📱 9:16 TikTok · 60fps
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-playlist-btn="tiktok" aria-pressed="false" class="tv-playlist-btn font-mono text-xs px-3 py-2 rounded-lg border border-emerald-400/45 text-emerald-300 bg-emerald-500/10 hover:bg-emerald-500/20 cursor-pointer transition-all">
            ▶ Reel All 29 TikToks (9:16)
          </button>
          <button type="button" data-playlist-btn="15s" aria-pressed="false" class="tv-playlist-btn font-mono text-xs px-3 py-2 rounded-lg border border-brand-amber/40 text-brand-amber bg-brand-amber/10 hover:bg-brand-amber/20 cursor-pointer transition-all">
            ▶ Play All 15s (3 Points)
          </button>
          <button type="button" data-playlist-btn="90s" aria-pressed="false" class="tv-playlist-btn font-mono text-xs px-3 py-2 rounded-lg border border-brand-cyan/40 text-brand-cyan bg-brand-cyan/10 hover:bg-brand-cyan/20 cursor-pointer transition-all">
            ▶ Play All 90s Briefings
          </button>
          <div class="flex items-center gap-1 ml-1 pl-2 border-l border-brand-border" role="group" aria-label="Playback speed">
            <button type="button" data-speed-btn="1" class="tv-speed-btn tv-speed-active font-mono text-[11px] px-2 py-1 rounded border border-brand-border text-brand-slate cursor-pointer">1x</button>
            <button type="button" data-speed-btn="1.25" class="tv-speed-btn font-mono text-[11px] px-2 py-1 rounded border border-brand-border text-brand-slate cursor-pointer">1.25x</button>
            <button type="button" data-speed-btn="1.5" class="tv-speed-btn font-mono text-[11px] px-2 py-1 rounded border border-brand-border text-brand-slate cursor-pointer">1.5x</button>
          </div>
        </div>
      </div>

      <!-- Video + Interactive Synced Cue Transcript Split -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7">
          <div id="tv-player-frame" class="relative rounded-xl overflow-hidden border border-brand-border bg-[#0b1020] aspect-video shadow-2xl transition-all duration-300">
            <video
              id="tv-player"
              controls
              playsinline
              preload="metadata"
              poster={initialStudy.poster_url}
              src={initialTier.video_url}
              data-loaded-src={initialTier.video_url}
              class="w-full h-full object-contain bg-[#0b1020]"
            >
              <track
                id="tv-track"
                kind="captions"
                srclang="en"
                label="English Studio Captions"
                src={initialTier.vtt_url}
                default
              />
            </video>
          </div>

          <!-- Snackable 9:16 TikTok / Shorts / Reels & X-Medium Syndication Bar -->
          <div
            id="tv-tiktok-bar"
            class="hidden mt-3 p-3.5 rounded-xl border border-emerald-400/40 bg-emerald-500/[0.06]"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="font-mono text-[11px] text-emerald-300 font-semibold">
                📱 Native 9:16 Vertical Edition · 1080×1920 @ 60fps · -14.0 LUFS · Safe-Zone Captions Verified
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <a
                  id="tv-tiktok-dl"
                  href={initialStudy.tiktok?.video_url ?? '/media/tv/tiktok/communication-avalanche-tiktok.mp4'}
                  download
                  class="font-mono text-[11px] px-2.5 py-1 rounded bg-emerald-400 text-[#071018] font-bold no-underline hover:opacity-90"
                >
                  ⬇ Download 9:16 MP4
                </a>
                <button
                  id="tv-tiktok-copy-caption"
                  type="button"
                  class="font-mono text-[11px] px-2.5 py-1 rounded border border-emerald-400/50 text-emerald-200 hover:bg-emerald-400/15 cursor-pointer bg-transparent"
                >
                  Copy TikTok Caption
                </button>
                <a
                  id="tv-syndicate-link"
                  href={`/syndication/?study=${initialStudy.id}`}
                  class="font-mono text-[11px] px-2.5 py-1 rounded border border-brand-amber/45 text-brand-amber no-underline hover:bg-brand-amber/15"
                >
                  X ↔ Medium Thread &amp; Article →
                </a>
              </div>
            </div>
          </div>

          <!-- Native Planetary 50-Language 15s, Extended Audio Description (28/28), & Easy-Read + AAC Studio Bar -->
          <div
            id="tv-accessibility-studio"
            role="region"
            aria-label="Planetary 15s language, extended audio description, and Easy-Read accessibility controls"
            class="mt-3 p-3.5 rounded-xl border border-brand-cyan/35 bg-white/[0.025]"
          >
            <div class="flex flex-wrap items-center justify-between gap-2.5">
              <div class="flex flex-wrap items-center gap-2 flex-1 min-w-[240px]">
                <label for="tv-planetary-lang" class="font-mono text-[11px] uppercase tracking-wider text-brand-cyan shrink-0">
                  🌐 15s Language:
                </label>
                <select
                  id="tv-planetary-lang"
                  aria-label="Select 15-second plain-words language track"
                  class="font-mono text-xs px-2.5 py-1.5 rounded-lg bg-[#0b1020] border border-brand-border text-brand-white focus:border-brand-amber focus:outline-none max-w-full sm:max-w-[310px]"
                >
                  <option value="studio">Studio English (ElevenLabs v4 · All 4 Slots)</option>
                  <optgroup id="tv-lang-opt-t1" label="Tier 1 · Top 20 Languages (All 28 Studies · 6.54B Speakers)">
                    {allPlanetaryLangs.filter((l) => l.tier === 1).map((lg) => (
                      <option value={lg.code}>
                        {lg.native} — {lg.name} ({lg.code}{lg.dir === 'rtl' ? ' · RTL' : ''} · {lg.speakers_m}M)
                      </option>
                    ))}
                  </optgroup>
                  <optgroup id="tv-lang-opt-t2" label="Tier 2 · Next 30 Languages (50-Lang Flagships · +1.41B Speakers)">
                    {allPlanetaryLangs.filter((l) => l.tier === 2).map((lg) => (
                      <option value={lg.code}>
                        {lg.native} — {lg.name} ({lg.code}{lg.dir === 'rtl' ? ' · RTL' : ''} · {lg.speakers_m}M)
                      </option>
                    ))}
                  </optgroup>
                </select>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <button
                  id="tv-ad-toggle"
                  type="button"
                  aria-pressed="false"
                  aria-controls="tv-ad-drawer"
                  class="tv-a11y-btn font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-border text-brand-light hover:border-emerald-400 hover:text-emerald-200 cursor-pointer bg-transparent transition-all"
                >
                  🎧 AD Audio Description
                </button>
                <button
                  id="tv-easyread-toggle"
                  type="button"
                  aria-pressed="false"
                  aria-expanded="false"
                  aria-controls="tv-easyread-drawer"
                  class="tv-a11y-btn font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-border text-brand-light hover:border-brand-cyan hover:text-brand-cyan cursor-pointer bg-transparent transition-all"
                >
                  📖 Easy Read + AAC
                </button>
              </div>
            </div>

            <!-- Synchronized Auxiliary Audio Bar (shown when Planetary 15s Language or AD Track is active) -->
            <div id="tv-aux-audio-wrap" class="hidden mt-3 pt-3 border-t border-brand-border/70">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <div id="tv-aux-status" role="status" aria-live="polite" class="font-mono text-[11px] text-emerald-300 font-semibold"></div>
                <div class="flex items-center gap-2 font-mono text-[11px]">
                  <span id="tv-aux-gate-badge" class="text-brand-slate"></span>
                  <a id="tv-aux-dl-m4a" href="/media/tv/accessibility/communication-avalanche-15s.ad.m4a" class="text-brand-amber no-underline hover:underline">.m4a</a>
                  <span class="text-brand-gray">·</span>
                  <a id="tv-aux-dl-vtt" href="/media/tv/accessibility/communication-avalanche-15s.ad.vtt" class="text-brand-cyan no-underline hover:underline">.vtt</a>
                  <button id="tv-aux-reset" type="button" class="ml-1 px-2 py-0.5 rounded border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer bg-transparent">
                    Reset Studio Audio
                  </button>
                </div>
              </div>
              <audio
                id="tv-aux-audio"
                controls
                preload="none"
                class="w-full h-9"
                aria-label="Synchronized planetary language or extended audio description track"
              ></audio>
              <div
                id="tv-planetary-bullets-box"
                dir="ltr"
                lang="en"
                class="hidden mt-2.5 p-3 rounded-lg border border-brand-amber/30 bg-[#0b1020]"
              >
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span id="tv-planetary-kicker" class="font-mono text-[10px] uppercase tracking-wider text-brand-amber">
                    Verified 15s Plain-Words Translation
                  </span>
                  <span id="tv-planetary-dir-pill" class="font-mono text-[10px] px-2 py-0.5 rounded bg-white/5 text-brand-cyan border border-brand-border">
                    LTR
                  </span>
                </div>
                <ol id="tv-planetary-bullets" class="list-decimal pl-5 space-y-1 font-body text-[13px] text-brand-white leading-relaxed m-0"></ol>
              </div>
            </div>

            <!-- Extended Audio Description Inline Geometry Drawer (29 / 29 Studies) -->
            <div id="tv-ad-drawer" class="hidden mt-3 pt-3 border-t border-emerald-400/30">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <span class="font-mono text-[11px] uppercase tracking-wider text-emerald-300 font-semibold">
                  Extended Audio Description · 29/29 Catalog Visual Geometry · WCAG 2.2 AA
                </span>
                <a id="tv-ad-vtt-link" href="/media/tv/accessibility/from-ephemeral-inference-to-compiled-agency-15s.ad.vtt" class="font-mono text-[11px] text-emerald-300 no-underline hover:underline">
                  WebVTT (.ad.vtt) ↗
                </a>
              </div>
              <p id="tv-ad-overview" class="font-body text-xs text-brand-slate mb-2 leading-relaxed"></p>
              <div id="tv-ad-cues" class="grid grid-cols-1 md:grid-cols-3 gap-2"></div>
            </div>

            <!-- Easy Read + SKOS AAC Symbol Drawer (29 / 29 Studies) -->
            <div id="tv-easyread-drawer" class="hidden mt-3 pt-3 border-t border-brand-cyan/30">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <div>
                  <span class="font-mono text-[11px] uppercase tracking-wider text-brand-cyan font-semibold">
                    Easy Read + SKOS AAC Symbols · One Idea Per Sentence · CC0-1.0
                  </span>
                  <div id="tv-er-title" class="font-display text-base font-bold text-brand-white mt-0.5"></div>
                </div>
                <div class="flex items-center gap-2 font-mono text-[11px]">
                  <a id="tv-er-guide-link" href="/media/tv/accessibility/easy-read-index.html" class="text-brand-amber no-underline hover:underline">
                    29-Study Guide ↗
                  </a>
                  <span class="text-brand-gray">·</span>
