---
import Layout from '../../layouts/Layout.astro';
import tvCatalog from '../../data/tv-catalog.json';
import TvClient from './_TvClient.astro';

const SITE = 'https://research.openie.dev';
const studies = tvCatalog.studies as any[];
const initialStudy = studies.find((s) => s.id === 'communication-avalanche') ?? studies[0];
const initialTier = initialStudy.tiers['90s'] ?? Object.values(initialStudy.tiers)[0];

const categories = [
  'All 21',
  'Foundations & Thermodynamics',
  'Reality Code Engine',
  'Null & Benchmarks',
  'Communication Avalanche & Bio',
  'Hardware, Silicon & OS',
  'Economics & Cadence',
];

const tierOrder = ['15s', '45s', '90s', '180s'] as const;
const tierLabels: Record<string, string> = {
  '15s': '15s · 3 Plain Points',
  '45s': '45s · Plain + Example',
  '90s': '90s · Full Briefing',
  '180s': '3m · Deep Cut · 3D',
};
const tierShortLabels: Record<string, string> = {
  '15s': '15s Plain',
  '45s': '45s Story',
  '90s': '90s Brief',
  '180s': '3m Deep',
};

const isoDuration = (sec: number) => `PT${Math.max(1, Math.round(sec))}S`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'OpenIE Research TV — 84 Plain-Language Research Films Across 21 Studies',
  description: tvCatalog.studio_disclosure,
  numberOfItems: tvCatalog.film_count,
  itemListElement: studies.flatMap((s, sIdx) =>
    tierOrder.map((t, tIdx) => {
      const td = s.tiers[t];
      return {
        '@type': 'ListItem',
        position: sIdx * 4 + tIdx + 1,
        item: {
          '@type': 'VideoObject',
          name: `${s.short_title} (${tierLabels[t]})`,
          description: td.hook,
          thumbnailUrl: `${SITE}${s.poster_url}`,
          uploadDate: '2026-11-23',
          duration: isoDuration(td.duration_s),
          contentUrl: `${SITE}${td.video_url}`,
          embedUrl: `${SITE}/tv/#${s.id}:${t}`,
          transcript: td.transcript,
          publisher: {
            '@type': 'Organization',
            name: 'Open Interface Engineering, Inc.',
            url: 'https://openie.dev',
          },
        },
      };
    })
  ),
};
---

<Layout
  title="OpenIE Research TV — Plain-Language Research Films (15s to 3m)"
  description="Watch all 21 OpenIE research studies across four plain-language depth slots (15s Three Plain Points, 45s Everyday Example, 90s Full Briefing, and 3-Minute 3D Deep Cut)—starting with the three layperson takeaways and free of unexplained acronyms."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="max-w-7xl mx-auto px-5 md:px-10 pt-10 pb-20">
    <!-- Studio Header & Plain-Words Philosophy Banner -->
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="section-label">OpenIE Broadcast Studio · /tv/</span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-amber/15 text-brand-amber border border-brand-amber/30">
          21 Studies × 4 Depth Slots (15s · 45s · 90s · 3m) = 84 Films
        </span>
        <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] bg-brand-cyan/15 text-brand-cyan border border-brand-cyan/30">
          Plain Words First · Zero Acronym Soup · 21 Global Voices
        </span>
      </div>
      <h1 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-brand-white mb-4">
        Open<span class="text-brand-cyan">IE</span> Research <span class="text-brand-amber">TV</span>
      </h1>
      <p class="font-body text-base md:text-lg text-brand-slate max-w-4xl leading-relaxed mb-5">
        Every film—at every length—starts with the paper's <strong>three high-level points in plain everyday words</strong>, then expands smoothly as you choose more time: from a <strong>15-second three-point primer</strong>, to a <strong>45-second real-world example</strong>, to a <strong>90-second full briefing</strong>, to a <strong>3-minute deep cut</strong> with 3D architecture views and candid scientific limits.
      </p>

      <div class="glass-card p-4 md:p-5 border-l-4 border-l-brand-amber">
        <div class="font-mono text-[11px] uppercase tracking-wider text-brand-amber mb-1.5">
          Plain-Language Guarantee &amp; How Energy Is Labeled
        </div>
        <p class="font-body text-[13px] text-brand-light leading-relaxed m-0">
          No film assumes insider jargon or unexplained acronyms. Every study is narrated by its own studio presenter via <code class="font-mono text-brand-cyan">ElevenLabs eleven_v4</code>, and every energy claim states plainly how it was obtained:
          <strong>direct circuit-board power sensors</strong> (physical current sensors attached to the hardware in <em>Metered Commit Gates</em>, <em>Satiation Benchmark Harness</em>, and <em>The Communication Tool Avalanche</em>),
          <strong>built-in computer chip counters</strong> (processor and operating-system energy counters),
          or <strong>mathematical physics bounds</strong>.
        </p>
      </div>
    </div>

    <!-- Hero Broadcast Theater -->
    <div id="tv-theater-anchor" class="scroll-mt-24 glass-card p-4 md:p-6 mb-12">
      <!-- Top Control Deck: 4 Telescoping Depth Slots + Continuous Playlists + Speed -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-brand-border">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Depth slot selector">
          <button type="button" data-tier-btn="15s" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">1</span> 15s · 3 Plain Points
          </button>
          <button type="button" data-tier-btn="45s" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">2</span> 45s · Plain + Example
          </button>
          <button type="button" data-tier-btn="90s" class="tv-tier-pill tv-pill-active font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">3</span> 90s · Full Briefing
          </button>
          <button type="button" data-tier-btn="180s" class="tv-tier-pill font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light cursor-pointer transition-all">
            <span class="text-brand-amber mr-1">4</span> 3m · Deep Cut · 3D
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-playlist-btn="15s" aria-pressed="false" class="tv-playlist-btn font-mono text-xs px-3 py-2 rounded-lg border border-brand-amber/40 text-brand-amber bg-brand-amber/10 hover:bg-brand-amber/20 cursor-pointer transition-all">
            ▶ Play All 15s (3 Points)
          </button>
          <button type="button" data-playlist-btn="90s" aria-pressed="false" class="tv-playlist-btn font-mono text-xs px-3 py-2 rounded-lg border border-brand-cyan/40 text-brand-cyan bg-brand-cyan/10 hover:bg-brand-cyan/20 cursor-pointer transition-all">
            ▶ Play All 90s Briefings
          </button>
          <div class="flex items-center gap-1 ml-1 pl-2 border-l border-brand-border" role="group" aria-label="Playback speed">
            <button type="button" data-speed-btn="1" class="tv-speed-btn tv-speed-active font-mono text-[11px] px-2 py-1 rounded border border-brand-border text-brand-slate cursor-pointer">1x</button>
            <button type="button" data-speed-btn="1.25" class="tv-speed-btn font-mono text-[11px] px-2 py-1 rounded border border-brand-border text-brand-slate cursor-pointer">1.25x</button>
            <button type="button" data-speed-btn="1.5" class="tv-speed-btn font-mono text-[11px] px-2 py-1 rounded border border-brand-border text-brand-slate cursor-pointer">1.5x</button>
          </div>
        </div>
      </div>

      <!-- Video + Interactive Synced Cue Transcript Split -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7">
          <div class="relative rounded-xl overflow-hidden border border-brand-border bg-[#0b1020] aspect-video shadow-2xl">
            <video
              id="tv-player"
              controls
              playsinline
              preload="metadata"
              poster={initialStudy.poster_url}
              src={initialTier.video_url}
              data-loaded-src={initialTier.video_url}
              class="w-full h-full object-contain bg-[#0b1020]"
            >
              <track
                id="tv-track"
                kind="captions"
                srclang="en"
                label="English Studio Captions"
                src={initialTier.vtt_url}
                default
              />
            </video>
          </div>

          <!-- Active Film Metadata & Prev/Next Bar -->
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span id="tv-active-category" class="font-mono text-[11px] uppercase tracking-wider text-brand-amber">
                {initialStudy.category}
              </span>
              <span class="text-brand-gray">·</span>
              <span id="tv-active-energy-tier" class="px-2 py-0.5 rounded font-mono text-[11px] border border-brand-amber/40 text-brand-amber bg-brand-amber/10">
                {initialStudy.energy_tier}
              </span>
              <span id="tv-active-voice" class="px-2.5 py-0.5 rounded font-mono text-[11px] border border-brand-cyan/40 text-brand-cyan bg-brand-cyan/10" title={initialStudy.narrator_profile ?? ''}>
                Voice: {initialStudy.narrator_name ?? 'Cecily'} · ElevenLabs v4 Studio
              </span>
              <div id="tv-active-epistemic" class="flex items-center gap-1"></div>
            </div>
            <div class="flex items-center gap-2">
              <span id="tv-playlist-status" class="font-mono text-[11px] text-brand-gray mr-1">Single-Film Mode</span>
              <button id="tv-prev-btn" type="button" class="font-mono text-xs px-2.5 py-1 rounded border border-brand-border text-brand-light hover:border-brand-amber cursor-pointer bg-transparent">
                ← Prev (K)
              </button>
              <button id="tv-next-btn" type="button" class="font-mono text-xs px-2.5 py-1 rounded border border-brand-border text-brand-light hover:border-brand-amber cursor-pointer bg-transparent">
                Next (J) →
              </button>
            </div>
          </div>

          <h2 id="tv-active-title" class="font-display text-xl md:text-2xl font-bold text-brand-white mt-2">
            {initialStudy.title}
          </h2>
          <p id="tv-active-hook" class="font-body text-sm text-brand-slate mt-1.5 leading-relaxed">
            {initialTier.hook}
          </p>

          <!-- Prominent 3 Plain-Words Bullets Card -->
          <div class="mt-3.5 p-4 rounded-xl border border-brand-amber/30 bg-white/[0.025]">
            <div class="font-mono text-[10px] uppercase tracking-[1.8px] text-brand-amber mb-2">
              In Plain Words — The 3 Key Points Every Slot Builds From
            </div>
            <ol id="tv-active-bullets" class="list-decimal pl-5 space-y-1.5 font-body text-[13.5px] text-brand-light leading-relaxed m-0">
              {(initialStudy.plain_bullets ?? []).map((b: string) => (
                <li>{b}</li>
              ))}
            </ol>
          </div>

          <div class="mt-3 font-mono text-xs text-brand-cyan">
            Key Outcome: <span id="tv-active-metric" class="text-brand-amber">{initialStudy.headline_metric}</span>
          </div>
          <div id="tv-active-energy-disc" class="mt-1 font-mono text-[11px] text-brand-gray">
            {initialStudy.energy_disclosure}
          </div>
          <div id="tv-active-voice-profile" class="mt-1 font-mono text-[11px] text-brand-slate">
            Presenter Profile: {initialStudy.narrator_profile ?? 'Documentary Host · African American English'}
          </div>

          <!-- Deep-Link Action Buttons -->
          <div class="mt-4 pt-4 border-t border-brand-border flex flex-wrap items-center gap-2.5">
            <a id="tv-link-paper" href={initialStudy.paper_url} class="font-mono text-xs px-3.5 py-2 rounded-lg bg-brand-amber text-brand-dark font-semibold no-underline hover:opacity-90 transition-opacity">
              Read Paper →
            </a>
            <a id="tv-link-figures" href={initialStudy.figures_url} class="font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-cyan/40 text-brand-cyan no-underline hover:bg-brand-cyan/10 transition-colors">
              Interactive Figure
            </a>
            <a id="tv-link-tutorial" href={`/tutorials/?lab=${initialStudy.tutorial_lab_id}`} class="font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light no-underline hover:border-brand-amber transition-colors">
              Interactive Tutorial
            </a>
            <a id="tv-link-pdf" href={initialStudy.pdf_url} class="font-mono text-xs px-3.5 py-2 rounded-lg border border-brand-border text-brand-light no-underline hover:border-brand-amber transition-colors">
              Download PDF
            </a>
            <a id="tv-link-about" href={initialStudy.about_url} class="font-mono text-xs px-3 py-2 rounded-lg text-brand-slate no-underline hover:text-brand-white transition-colors">
              About Page
            </a>
          </div>
        </div>

        <!-- Synced Clickable Cue Transcript Panel -->
        <div class="lg:col-span-5 glass-card p-4 flex flex-col h-[500px] lg:h-[620px]">
          <div class="flex items-center justify-between pb-3 mb-2 border-b border-brand-border">
            <div>
              <div class="font-mono text-xs text-brand-white font-semibold">Plain-Language Synced Transcript</div>
              <div class="font-mono text-[10px] text-brand-gray">Click any timestamped line to jump directly</div>
            </div>
            <button id="tv-copy-transcript" type="button" class="font-mono text-[11px] px-2.5 py-1 rounded border border-brand-border text-brand-slate hover:text-brand-amber hover:border-brand-amber cursor-pointer bg-transparent">
              Copy Transcript
            </button>
          </div>
          <div id="tv-cue-list" class="flex-1 overflow-y-auto space-y-1 pr-1" role="region" aria-label="Synchronized film transcript"></div>
          <div class="pt-3 mt-2 border-t border-brand-border font-mono text-[10px] text-brand-gray flex flex-wrap gap-x-3 gap-y-1">
            <span><kbd class="px-1.5 py-0.5 rounded bg-white/5 text-brand-light">Space</kbd> Play/Pause</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-white/5 text-brand-light">1–4</kbd> Depth Slot (15s–3m)</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-white/5 text-brand-light">J / K</kbd> Next/Prev</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-white/5 text-brand-light">M</kbd> Mute</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Filter Tabs & Instant Search -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Study categories">
        {categories.map((cat, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            data-cat-tab={cat}
            class={`tv-cat-tab font-mono text-xs px-3 py-1.5 rounded-lg border border-brand-border text-brand-slate hover:text-brand-white cursor-pointer bg-transparent transition-all ${idx === 0 ? 'tv-cat-active' : ''}`}
          >
            {cat}
          </button>
        ))}
      </div>
      <div class="flex items-center gap-3">
        <input
          id="tv-search-input"
          type="search"
          placeholder="Search 21 studies, 3-bullet summaries & transcripts..."
          aria-label="Search studies, plain-word bullets, and film transcripts"
          class="font-body text-sm px-3.5 py-2 rounded-lg bg-white/5 border border-brand-border text-brand-white placeholder:text-brand-gray focus:border-brand-amber w-full md:w-80"
        />
      </div>
    </div>
    <div id="tv-visible-count" class="font-mono text-xs text-brand-gray mb-5">
      21 / 21 studies shown (84 films)
    </div>

    <!-- 21-Study × 4-Tier Visual Grid (Each Card Leads With Its 3 Plain-Words Bullets) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {studies.map((s) => (
        <article data-study-card={s.id} class="glass-card overflow-hidden flex flex-col justify-between transition-all">
          <div>
            <div class="relative aspect-video bg-[#0b1020] overflow-hidden border-b border-brand-border group">
              <img
                src={s.poster_url}
                alt={`${s.short_title} plain-language summary poster`}
                loading="lazy"
                width="1280"
                height="720"
                class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
              />
              <button
                type="button"
                data-card-play="true"
                data-study={s.id}
                data-tier="90s"
                aria-label={`Play ${s.short_title} 90s Full Briefing`}
                class="absolute inset-0 bg-black/35 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center cursor-pointer border-none"
              >
                <span class="px-4 py-2 rounded-full bg-brand-amber text-brand-dark font-mono text-xs font-bold shadow-lg">
                  ▶ Play 90s Briefing
                </span>
              </button>
              <span class="tv-now-playing-pill hidden absolute top-2.5 left-2.5 px-2.5 py-1 rounded font-mono text-[10px] font-bold bg-brand-amber text-brand-dark">
                NOW PLAYING
              </span>
            </div>

            <div class="p-4">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="font-mono text-[10px] uppercase tracking-wider text-brand-amber truncate">{s.category}</span>
                <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-white/5 text-brand-slate border border-brand-border shrink-0">
                  {s.energy_tier}
                </span>
              </div>
              <h3 class="font-display text-lg font-bold text-brand-white leading-snug mb-1.5">
                {s.short_title}
              </h3>
              <div class="font-mono text-[10px] text-brand-slate mb-2 flex items-center gap-1.5">
                <span class="text-brand-amber">Voice:</span>
                <span class="text-brand-light font-semibold">{s.narrator_name ?? 'Studio'}</span>
                <span>·</span>
                <span class="truncate">{s.narrator_profile ?? 'ElevenLabs v4 Studio'}</span>
              </div>
              <div class="font-mono text-[11px] text-brand-cyan mb-2.5">
                {s.headline_metric}
              </div>

              <!-- 3 Plain-Words Bullets right on every card -->
              <ol class="list-decimal pl-4 space-y-1 font-body text-xs text-brand-slate leading-snug m-0">
                {(s.plain_bullets ?? []).map((b: string) => (
                  <li>{b}</li>
                ))}
              </ol>
            </div>
          </div>

          <div class="px-4 pb-4 pt-3 border-t border-brand-border">
            <div class="font-mono text-[10px] text-brand-gray mb-2">Choose Time Slot (starts with 3 plain points):</div>
            <div class="grid grid-cols-4 gap-1.5">
              {tierOrder.map((t) => (
                <button
                  type="button"
                  data-card-play="true"
                  data-study={s.id}
                  data-tier={t}
                  class="font-mono text-[11px] py-1.5 px-1 rounded border border-brand-border hover:border-brand-amber hover:text-brand-amber text-brand-light bg-white/[0.02] cursor-pointer transition-colors text-center"
                >
                  <div class="font-bold">{tierShortLabels[t]}</div>
                  <div class="text-[9px] text-brand-gray">{Math.round(s.tiers[t].duration_s)}s</div>
                </button>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <style is:global>
    .tv-pill-active {
      background: rgba(245, 158, 11, 0.18) !important;
      border-color: #f59e0b !important;
      color: #ffffff !important;
    }
    .tv-playlist-active {
      background: #00d4aa !important;
      color: #0a0a0f !important;
      font-weight: 700;
    }
    .tv-speed-active {
      border-color: #f59e0b !important;
      color: #f59e0b !important;
    }
    .tv-cat-active {
      background: rgba(245, 158, 11, 0.14) !important;
      border-color: rgba(245, 158, 11, 0.6) !important;
      color: #f59e0b !important;
    }
    .tv-cue-active {
      background: rgba(245, 158, 11, 0.12) !important;
      border-color: rgba(245, 158, 11, 0.45) !important;
    }
    .tv-card-playing {
      border-color: rgba(245, 158, 11, 0.65) !important;
      box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.25);
    }
  </style>

  <TvClient catalog={tvCatalog} />
</Layout>
